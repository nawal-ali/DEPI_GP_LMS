@using LMSProject.ViewModel
@model ForgotPasswordVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password — TOTC LMS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Poppins', sans-serif;
                min-height: 100vh;
                background: linear-gradient(135deg, #2F327D 0%, #5B72EE 50%, #00CBB8 100%);
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 1.5rem;
            }

            .fp-card {
                background: white;
                border-radius: 24px;
                width: 100%;
                max-width: 440px;
                box-shadow: 0 24px 80px rgba(47,50,125,.25);
                overflow: hidden;
            }

            .fp-header {
                background: linear-gradient(135deg, #2F327D, #5B72EE);
                padding: 2.2rem 2rem 1.8rem;
                text-align: center;
            }

            .fp-icon {
                width: 64px;
                height: 64px;
                border-radius: 18px;
                background: rgba(255,255,255,.15);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.8rem;
                color: white;
                margin: 0 auto 1rem;
            }

            .fp-header h2 {
                color: white;
                font-weight: 700;
                font-size: 1.35rem;
                margin-bottom: .3rem;
            }

            .fp-header p {
                color: rgba(255,255,255,.75);
                font-size: .82rem;
                margin: 0;
            }

            .fp-body {
                padding: 2rem;
            }

            .fp-label {
                font-size: .82rem;
                font-weight: 600;
                color: #374151;
                margin-bottom: .4rem;
                display: block;
            }

            .fp-input {
                width: 100%;
                border: 1.5px solid rgba(47,50,125,.15);
                border-radius: 12px;
                padding: .75rem 1rem;
                font-size: .875rem;
                font-family: 'Poppins', sans-serif;
                outline: none;
                transition: border-color .15s, box-shadow .15s;
            }

                .fp-input:focus {
                    border-color: #00CBB8;
                    box-shadow: 0 0 0 3px rgba(0,203,184,.15);
                }

            .fp-btn {
                width: 100%;
                background: linear-gradient(135deg, #2F327D, #5B72EE);
                color: white;
                border: none;
                border-radius: 12px;
                padding: .85rem;
                font-size: .9rem;
                font-weight: 700;
                font-family: 'Poppins', sans-serif;
                cursor: pointer;
                transition: opacity .15s;
                margin-top: 1.25rem;
            }

                .fp-btn:hover {
                    opacity: .9;
                }

            .fp-back {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: .4rem;
                margin-top: 1rem;
                color: #9ca3af;
                font-size: .82rem;
                text-decoration: none;
                transition: color .15s;
            }

                .fp-back:hover {
                    color: #2F327D;
                }

            .fp-info {
                background: rgba(91,114,238,.06);
                border-left: 3px solid #5B72EE;
                border-radius: 0 10px 10px 0;
                padding: .75rem 1rem;
                font-size: .8rem;
                color: #555;
                margin-bottom: 1.25rem;
                line-height: 1.6;
            }

            .validation-error {
                color: #E13468;
                font-size: .78rem;
                margin-top: .3rem;
            }
    </style>
</head>
<body>
    <div class="fp-card">
        <div class="fp-header">
            <div class="fp-icon"><i class="fas fa-lock-open"></i></div>
            <h2>Forgot Password?</h2>
            <p>Enter your email and we'll send a temporary password</p>
        </div>
        <div class="fp-body">
            <div class="fp-info">
                <i class="fas fa-info-circle me-1" style="color:#5B72EE;"></i>
                A <strong>temporary password</strong> will be sent to your email.
                Log in with it and change your password immediately.
            </div>

            <form method="post" asp-controller="Account" asp-action="ForgotPassword">
                @Html.AntiForgeryToken()
                <label class="fp-label" for="Email">
                    <i class="fas fa-envelope me-1" style="color:#5B72EE;"></i>Email Address
                </label>
                <input asp-for="Email" type="email" class="fp-input"
                       id="Email" placeholder="Enter your registered email" required />
                <span asp-validation-for="Email" class="validation-error d-block"></span>

                <button type="submit" class="fp-btn">
                    <i class="fas fa-paper-plane me-2"></i>Send Temporary Password
                </button>
            </form>

            <a href="/Account/Login" class="fp-back">
                <i class="fas fa-arrow-left"></i> Back to Login
            </a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
