@using LMSProject.ViewModel
@{
    Layout = null;
}
@model LoginVM
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — TOTC LMS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
            :root {
                --primary: #2F327D;
                --secondary: #00CBB8;
                --accent: #5B72EE;
            }

            *, *::before, *::after {
                box-sizing: border-box;
            }

            html, body {
                height: 100%;
                margin: 0;
                font-family: 'Poppins', sans-serif;
                background: #f4f6fb;
            }

            /* ── Entrance animation ─────────────────────────── */
            @@keyframes cardIn {
                from {
                    opacity: 0;
                    transform: translateY(32px) scale(.97);
                }

                to {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            @@keyframes panelIn {
                from {
                    opacity: 0;
                    transform: translateX(-24px);
                }

                to {
                    opacity: 1;
                    transform: translateX(0);
                }
            }

            @@keyframes formIn {
                from {
                    opacity: 0;
                    transform: translateX(24px);
                }

                to {
                    opacity: 1;
                    transform: translateX(0);
                }
            }

            .login-shell {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 1.5rem;
            }

            .login-card {
                background: white;
                border-radius: 20px;
                box-shadow: 0 8px 40px rgba(47,50,125,.12);
                overflow: hidden;
                width: 100%;
                max-width: 900px;
                display: flex;
                min-height: 520px;
                animation: cardIn .55s cubic-bezier(.22,.68,0,1.2) both;
            }

            /* ── Left panel ─────────────────────────────────── */
            .login-panel-left {
                background: linear-gradient(145deg, var(--primary) 0%, var(--accent) 60%, var(--secondary) 100%);
                flex: 1;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 3rem 2rem;
                position: relative;
                overflow: hidden;
                animation: panelIn .6s .1s ease both;
            }

                .login-panel-left::before {
                    content: '';
                    position: absolute;
                    width: 300px;
                    height: 300px;
                    border-radius: 50%;
                    background: rgba(255,255,255,.05);
                    top: -80px;
                    right: -80px;
                }

                .login-panel-left::after {
                    content: '';
                    position: absolute;
                    width: 200px;
                    height: 200px;
                    border-radius: 50%;
                    background: rgba(255,255,255,.05);
                    bottom: -60px;
                    left: -60px;
                }

                .login-panel-left h2 {
                    color: white;
                    font-size: 1.6rem;
                    font-weight: 700;
                    text-align: center;
                    margin: 1rem 0 .5rem;
                    position: relative;
                    z-index: 1;
                }

                .login-panel-left p {
                    color: rgba(255,255,255,.75);
                    font-size: .88rem;
                    text-align: center;
                    max-width: 220px;
                    position: relative;
                    z-index: 1;
                }

            /* Logo link */
            .login-brand-link {
                text-decoration: none;
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: .75rem;
                position: relative;
                z-index: 1;
                transition: transform .2s;
            }

                .login-brand-link:hover {
                    transform: scale(1.05);
                }

            .login-brand-icon {
                width: 72px;
                height: 72px;
                background: rgba(255,255,255,.15);
                border-radius: 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 2rem;
                color: white;
                backdrop-filter: blur(4px);
            }

            /* ── Right panel ─────────────────────────────────── */
            .login-panel-right {
                flex: 1;
                display: flex;
                flex-direction: column;
                justify-content: center;
                padding: 3rem 2.5rem;
                animation: formIn .6s .2s ease both;
            }

                .login-panel-right h4 {
                    font-size: 1.25rem;
                    font-weight: 700;
                    color: var(--primary);
                    margin-bottom: .25rem;
                }

                .login-panel-right p.sub {
                    font-size: .83rem;
                    color: #9ca3af;
                    margin-bottom: 1.75rem;
                }

            /* ── Form controls ───────────────────────────────── */
            .lf-group {
                margin-bottom: 1.1rem;
            }

                .lf-group label {
                    font-size: .8rem;
                    font-weight: 600;
                    color: #374151;
                    display: block;
                    margin-bottom: 5px;
                }

            .lf-icon-wrap {
                position: relative;
            }

                .lf-icon-wrap .lf-left-icon {
                    position: absolute;
                    left: 12px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #aaa;
                    font-size: .88rem;
                    pointer-events: none;
                }

            /* Eye toggle button */
            .lf-eye-btn {
                position: absolute;
                right: 10px;
                top: 50%;
                transform: translateY(-50%);
                background: none;
                border: none;
                cursor: pointer;
                color: #9ca3af;
                font-size: .88rem;
                padding: 3px 5px;
                transition: color .15s;
                z-index: 2;
            }

                .lf-eye-btn:hover {
                    color: var(--primary);
                }

            .lf-control {
                width: 100%;
                border: 1.5px solid rgba(47,50,125,.15);
                border-radius: 10px;
                padding: .65rem 2.5rem .65rem 2.6rem; /* right pad for eye btn */
                font-size: .875rem;
                font-family: 'Poppins', sans-serif;
                transition: border-color .15s, box-shadow .15s;
                outline: none;
            }

                .lf-control:focus {
                    border-color: var(--secondary);
                    box-shadow: 0 0 0 3px rgba(0,203,184,.15);
                }

            .btn-login {
                width: 100%;
                background: linear-gradient(135deg, var(--primary), var(--accent));
                color: white;
                border: none;
                border-radius: 10px;
                padding: .7rem;
                font-size: .9rem;
                font-weight: 600;
                font-family: 'Poppins', sans-serif;
                cursor: pointer;
                transition: opacity .15s, transform .15s;
                margin-top: .5rem;
            }

                .btn-login:hover {
                    opacity: .92;
                    transform: translateY(-1px);
                }

            .text-danger {
                font-size: .75rem;
            }

            .validation-summary-errors ul {
                list-style: none;
                padding: .6rem .8rem;
                margin: 0 0 1rem;
                font-size: .8rem;
                color: #dc2626;
                background: #fef2f2;
                border-radius: 8px;
                border-left: 3px solid #dc2626;
            }

            @@media (max-width: 640px) {
                .login-panel-left {
                    display: none;
                }

                .login-panel-right {
                    padding: 2rem 1.5rem;
                }
            }
    </style>
</head>
<body>
    <div class="login-shell">
        <div class="login-card">

            <!-- Left decorative panel — logo linked to home -->
            <div class="login-panel-left d-none d-md-flex">
                <a href="/" class="login-brand-link">
                    <div class="login-brand-icon">
                        <i class="fas fa-graduation-cap"></i>
                    </div>
                    <h2>TOTC LMS</h2>
                </a>
                <p>Your complete learning management platform</p>
            </div>

            <!-- Right form panel -->
            <div class="login-panel-right">
                <h4>Welcome back</h4>
                <p class="sub">Sign in to your account to continue</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="validation-summary-errors"></div>
                }

                <form method="post" asp-controller="Account" asp-action="Login">
                    @Html.AntiForgeryToken()

                    <!-- Email / Username -->
                    <div class="lf-group">
                        <label>Email or Username</label>
                        <div class="lf-icon-wrap">
                            <i class="fas fa-user lf-left-icon"></i>
                            <input asp-for="EmailOrUsername"
                                   class="lf-control"
                                   placeholder="Enter your email or username"
                                   autocomplete="username" />
                        </div>
                        <span asp-validation-for="EmailOrUsername" class="text-danger"></span>
                    </div>

                    <!-- Password + eye toggle -->
                    <div class="lf-group">
                        <label>Password</label>
                        <div class="lf-icon-wrap">
                            <i class="fas fa-lock lf-left-icon"></i>
                            <input asp-for="Password"
                                   type="password"
                                   id="loginPassword"
                                   class="lf-control"
                                   placeholder="Enter your password"
                                   autocomplete="current-password" />
                            <button type="button" class="lf-eye-btn"
                                    onclick="toggleLoginPw(this)"
                                    tabindex="-1"
                                    title="Show / hide password">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3"
                         style="font-size:.8rem;">
                        <label style="display:flex;align-items:center;gap:6px;font-weight:400;cursor:pointer;">
                            <input type="checkbox" asp-for="RememberMe"
                                   style="accent-color:var(--primary);" />
                            Remember me
                        </label>
                        <a asp-controller="Account" asp-action="ForgotPassword"
                           style="color:var(--secondary);text-decoration:none;font-weight:600;">
                            Forgot password?
                        </a>
                    </div>

                    <button type="submit" class="btn-login">
                        <i class="fas fa-sign-in-alt me-2"></i>Sign In
                    </button>
                </form>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script>
        function toggleLoginPw(btn) {
        var input = document.getElementById('loginPassword');
        var icon  = btn.querySelector('i');
        if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('fa-eye', 'fa-eye-slash');
        btn.style.color = 'var(--primary)';
        } else {
        input.type = 'password';
        icon.classList.replace('fa-eye-slash', 'fa-eye');
        btn.style.color = '#9ca3af';
        }
        input.focus();
        }
    </script>
</body>
</html>
