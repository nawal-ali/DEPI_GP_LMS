@*
    Reusable password change partial.
    Include with: @await Html.PartialAsync("_PasswordChange", new ViewDataDictionary(ViewData) { { "FormAction", "/Account/ChangePassword" } })
    Or just: @await Html.PartialAsync("_PasswordChange")

    Caller must provide:
      ViewData["PwArea"]       — area name  (e.g. "Admin")      [optional, defaults to current]
      ViewData["PwController"] — controller (e.g. "Profile")    [optional]
      ViewData["PwAction"]     — action     (e.g. "ChangePassword") [optional]
      ViewData["PwFormId"]     — unique form id if multiple forms on page [default: "pwChangeForm"]
      ViewData["InputClass"]   — CSS class for inputs [default: "form-control"]
*@
@{
    var inputCls = ViewData["InputClass"] as string ?? "form-control";
    var formId = ViewData["PwFormId"] as string ?? "pwChangeForm";
    var modalId = formId + "Modal";
}

<style>
    .pw-field-wrap {
        position: relative;
    }

        .pw-field-wrap input {
            padding-right: 2.6rem !important;
        }

    .pw-eye-btn {
        position: absolute;
        right: 9px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: #9ca3af;
        font-size: .88rem;
        padding: 3px 5px;
        transition: color .15s;
        z-index: 5;
        line-height: 1;
    }

        .pw-eye-btn:hover {
            color: var(--primary, #2F327D);
        }

    .pw-hint {
        font-size: .72rem;
        margin-top: 3px;
        font-weight: 600;
        min-height: 15px;
        display: block;
        transition: color .2s;
    }

    .pw-ok {
        color: #16a34a;
    }

    .pw-err {
        color: #E13468;
    }

    .pw-strength-bar {
        height: 4px;
        border-radius: 10px;
        background: rgba(0,0,0,.07);
        margin-top: 5px;
        overflow: hidden;
    }

    .pw-strength-fill {
        height: 100%;
        border-radius: 10px;
        transition: width .3s, background .3s;
        width: 0;
    }
</style>

<!-- Validation Error Modal -->
<div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:400px;">
        <div class="modal-content" style="border-radius:18px;border:none;box-shadow:0 20px 60px rgba(0,0,0,.18);">
            <div style="background:linear-gradient(135deg,#E13468,#F48C06);border-radius:18px 18px 0 0;
                padding:1.1rem 1.4rem;display:flex;align-items:center;justify-content:space-between;">
                <div class="d-flex align-items-center gap-2">
                    <div style="width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.2);
                        display:flex;align-items:center;justify-content:center;">
                        <i class="fas fa-exclamation-triangle" style="color:white;font-size:.9rem;"></i>
                    </div>
                    <h6 style="margin:0;color:white;font-weight:700;font-size:.95rem;">Password Error</h6>
                </div>
                <button class="btn-close" data-bs-dismiss="modal"
                        style="filter:brightness(0) invert(1);"></button>
            </div>
            <div style="padding:1.4rem 1.5rem 1rem;">
                <p id="@(modalId)_msg" style="margin:0;font-size:.88rem;color:#374151;line-height:1.65;"></p>
            </div>
            <div style="padding:.5rem 1.5rem 1.3rem;">
                <button type="button"
                        class="btn btn-sm w-100 rounded-3"
                        style="background:linear-gradient(135deg,#E13468,#F48C06);
                    color:white;font-family:Poppins,sans-serif;font-weight:600;border:none;"
                        data-bs-dismiss="modal">
                    Got it
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Password Change Form -->
<form id="@formId"
      asp-area="@(ViewData["PwArea"] as string ?? ViewContext.RouteData.Values["area"]?.ToString() ?? "")"
      asp-controller="@(ViewData["PwController"] as string ?? "Profile")"
      asp-action="@(ViewData["PwAction"] as string ?? "ChangePassword")"
      method="post"
      onsubmit="return pwValidate_@(formId)(event)">
    @Html.AntiForgeryToken()

    <div class="row g-3">
        <!-- Current Password -->
        <div class="col-md-4">
            <label class="form-label" style="font-weight:600;font-size:.83rem;">
                Current Password <span class="text-danger">*</span>
            </label>
            <div class="pw-field-wrap">
                <input type="password" name="CurrentPassword" id="@(formId)_cur"
                       class="@inputCls" placeholder="Current password"
                       autocomplete="current-password" />
                <button type="button" class="pw-eye-btn"
                        onclick="pwToggle('@(formId)_cur', this)" tabindex="-1">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            <span class="pw-hint" id="@(formId)_curHint"></span>
        </div>

        <!-- New Password -->
        <div class="col-md-4">
            <label class="form-label" style="font-weight:600;font-size:.83rem;">
                New Password <span class="text-danger">*</span>
            </label>
            <div class="pw-field-wrap">
                <input type="password" name="NewPassword" id="@(formId)_new"
                       class="@inputCls" placeholder="Min. 8 characters"
                       autocomplete="new-password"
                       oninput="pwNewInput_@(formId)()" />
                <button type="button" class="pw-eye-btn"
                        onclick="pwToggle('@(formId)_new', this)" tabindex="-1">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            <div class="pw-strength-bar">
                <div class="pw-strength-fill" id="@(formId)_bar"></div>
            </div>
            <span class="pw-hint" id="@(formId)_newHint"></span>
        </div>

        <!-- Confirm Password -->
        <div class="col-md-4">
            <label class="form-label" style="font-weight:600;font-size:.83rem;">
                Confirm Password <span class="text-danger">*</span>
            </label>
            <div class="pw-field-wrap">
                <input type="password" name="ConfirmPassword" id="@(formId)_conf"
                       class="@inputCls" placeholder="Repeat new password"
                       autocomplete="new-password"
                       oninput="pwConfInput_@(formId)()" />
                <button type="button" class="pw-eye-btn"
                        onclick="pwToggle('@(formId)_conf', this)" tabindex="-1">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            <span class="pw-hint" id="@(formId)_confHint"></span>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary rounded-3 px-4"
                style="font-family:Poppins,sans-serif;">
            <i class="fas fa-key me-2"></i>Update Password
        </button>
    </div>
</form>

<script>
    (function () {
        var FID      = '@formId';
        var MID      = '@modalId';
        var MSG_EL   = document.getElementById('@(modalId)_msg');

        function showModal(msg) {
            if (MSG_EL) MSG_EL.textContent = msg;
            var m = document.getElementById(MID);
            if (m && window.bootstrap) new bootstrap.Modal(m).show();
            else alert(msg);
        }

        function strength(pw) {
            var s = 0;
            if (pw.length >= 8)           s++;
            if (pw.length >= 12)          s++;
            if (/[A-Z]/.test(pw))         s++;
            if (/[0-9]/.test(pw))         s++;
            if (/[^A-Za-z0-9]/.test(pw))  s++;
            return s;
        }

        window['pwToggle'] = function(inputId, btn) {
            var inp  = document.getElementById(inputId);
            var icon = btn.querySelector('i');
            if (!inp) return;
            if (inp.type === 'password') {
                inp.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
                btn.style.color = 'var(--primary,#2F327D)';
            } else {
                inp.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
                btn.style.color = '#9ca3af';
            }
            inp.focus();
        };

        window['pwNewInput_' + FID] = function () {
            var pw   = document.getElementById(FID + '_new').value;
            var cur  = document.getElementById(FID + '_cur').value;
            var hint = document.getElementById(FID + '_newHint');
            var bar  = document.getElementById(FID + '_bar');

            if (!pw) { hint.textContent = ''; bar.style.width = '0'; return; }

            if (cur && pw === cur) {
                hint.textContent = '✕ Must differ from current password';
                hint.className   = 'pw-hint pw-err';
                bar.style.width  = '100%';
                bar.style.background = '#E13468';
                return;
            }
            if (pw.length < 8) {
                hint.textContent = '✕ At least 8 characters required';
                hint.className   = 'pw-hint pw-err';
                bar.style.width  = Math.round(pw.length / 8 * 35) + '%';
                bar.style.background = '#E13468';
                return;
            }

            var s     = strength(pw);
            var lbls  = ['','Weak','Fair','Good','Strong','Very Strong'];
            var cols  = ['','#E13468','#F48C06','#FDCB6E','#29B9E7','#16a34a'];
            var widths= ['','20%','40%','60%','80%','100%'];
            bar.style.width      = widths[s] || '20%';
            bar.style.background = cols[s]   || '#E13468';
            hint.textContent = '● ' + (lbls[s] || 'Weak');
            hint.className   = 'pw-hint ' + (s >= 3 ? 'pw-ok' : 'pw-err');

            window['pwConfInput_' + FID]();
        };

        window['pwConfInput_' + FID] = function () {
            var np   = document.getElementById(FID + '_new').value;
            var cp   = document.getElementById(FID + '_conf').value;
            var hint = document.getElementById(FID + '_confHint');
            if (!cp) { hint.textContent = ''; return; }
            if (cp === np) {
                hint.textContent = '✓ Passwords match';
                hint.className   = 'pw-hint pw-ok';
            } else {
                hint.textContent = '✕ Passwords do not match';
                hint.className   = 'pw-hint pw-err';
            }
        };

        window['pwValidate_' + FID] = function (e) {
            var cur  = document.getElementById(FID + '_cur').value;
            var np   = document.getElementById(FID + '_new').value;
            var cp   = document.getElementById(FID + '_conf').value;

            if (!cur && !np && !cp) {
                showModal('Please fill in all three password fields to change your password.');
                e.preventDefault(); return false;
            }
            if (!cur) {
                showModal('Please enter your current password.');
                document.getElementById(FID + '_cur').focus();
                e.preventDefault(); return false;
            }
            if (!np) {
                showModal('Please enter a new password.');
                document.getElementById(FID + '_new').focus();
                e.preventDefault(); return false;
            }
            if (np.length < 8) {
                showModal('New password must be at least 8 characters long.');
                document.getElementById(FID + '_new').focus();
                e.preventDefault(); return false;
            }
            if (np === cur) {
                showModal('Your new password must be different from your current password.');
                document.getElementById(FID + '_new').focus();
                e.preventDefault(); return false;
            }
            if (!cp) {
                showModal('Please confirm your new password.');
                document.getElementById(FID + '_conf').focus();
                e.preventDefault(); return false;
            }
            if (np !== cp) {
                showModal('Passwords do not match. Please re-enter your new password and the confirmation.');
                document.getElementById(FID + '_conf').focus();
                e.preventDefault(); return false;
            }
            return true;
        };
    })();
</script>
