@using LMSProject.ViewModels.Tickets
@using MLSCore.Models
@model TicketDetailVM
@{
    var t = Model.Ticket;
    var backUrl = ViewData["BackUrl"] as string ?? "#";
    bool isAdmin = Model.CurrentUserRole is "Admin" or "SuperAdmin";
    var statuses = new[] { "Open", "In Progress", "Resolved", "Closed" };
}

<style>
    /* ── Bubbles ── */
    .tk-bubble {
        border-radius: 16px;
        padding: 1rem 1.2rem;
        margin-bottom: .9rem;
        max-width: 78%;
        position: relative;
    }

    .tk-mine {
        background: linear-gradient(135deg, var(--primary, #2F327D), #5B72EE);
        color: white;
        margin-left: auto;
        border-bottom-right-radius: 4px;
    }

    .tk-theirs {
        background: white;
        border: 1.5px solid rgba(0,0,0,.07);
        border-bottom-left-radius: 4px;
    }

    .tk-internal {
        background: rgba(253,203,110,.12);
        border: 1.5px dashed rgba(253,203,110,.5);
        border-bottom-left-radius: 4px;
    }

    .tk-meta {
        font-size: .72rem;
        opacity: .65;
        margin-bottom: .3rem;
        font-weight: 600;
    }

    .tk-mine .tk-meta {
        color: rgba(255,255,255,.9);
    }

    .tk-msg {
        font-size: .875rem;
        line-height: 1.75;
    }

    /* ── Status pills ── */
    .tk-status-btn {
        background: none;
        border: 1.5px solid rgba(47,50,125,.15);
        border-radius: 20px;
        padding: 4px 14px;
        font-size: .76rem;
        font-weight: 600;
        cursor: pointer;
        color: var(--primary, #2F327D);
        font-family: Poppins, sans-serif;
        transition: all .15s;
    }

        .tk-status-btn:hover {
            background: rgba(47,50,125,.06);
        }

        .tk-status-btn.tk-active {
            background: var(--primary, #2F327D);
            color: white;
            border-color: var(--primary, #2F327D);
        }

    /* ── Reply form ── */
    .reply-textarea {
        width: 100%;
        border: 1.5px solid rgba(47,50,125,.14);
        border-radius: 12px;
        padding: .85rem 1rem;
        font-size: .875rem;
        font-family: Poppins, sans-serif;
        line-height: 1.6;
        resize: vertical;
        min-height: 110px;
        outline: none;
        transition: border-color .15s, box-shadow .15s;
        color: var(--text-dark, #2d2d2d);
        background: white;
    }

        .reply-textarea:focus {
            border-color: var(--secondary, #00CBB8);
            box-shadow: 0 0 0 3px rgba(0,203,184,.12);
        }

    .file-label {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 14px;
        border-radius: 10px;
        background: rgba(47,50,125,.06);
        color: var(--primary, #2F327D);
        font-size: .8rem;
        font-weight: 600;
        cursor: pointer;
        border: 1.5px solid rgba(47,50,125,.12);
        transition: background .15s;
        white-space: nowrap;
    }

        .file-label:hover {
            background: rgba(47,50,125,.1);
        }

    .file-name-display {
        font-size: .76rem;
        color: var(--secondary, #00CBB8);
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 180px;
    }

    .send-btn {
        background: linear-gradient(135deg, var(--secondary, #00CBB8), var(--accent-blue, #29B9E7));
        color: white;
        border: none;
        border-radius: 12px;
        padding: 10px 24px;
        font-size: .875rem;
        font-weight: 600;
        font-family: Poppins, sans-serif;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: opacity .15s, transform .15s;
        white-space: nowrap;
    }

        .send-btn:hover {
            opacity: .9;
            transform: translateY(-1px);
        }
</style>

<!-- ── Ticket header ───────────────────────────────────────────────── -->
<div class="sa-card mb-4">
    <div style="background:linear-gradient(135deg,var(--primary,#2F327D),#5B72EE);
        border-radius:16px 16px 0 0;padding:1.4rem 1.6rem;">
        <div class="d-flex align-items-start justify-content-between gap-2 flex-wrap">
            <div>
                <h5 style="color:white;font-weight:700;margin:0;">@t.Title</h5>
                <div class="d-flex gap-2 flex-wrap mt-2">
                    <span style="background:rgba(255,255,255,.2);color:white;padding:2px 10px;
                        border-radius:20px;font-size:.72rem;font-weight:600;">
                        @t.DisplayType
                    </span>
                    <span style="background:@t.StatusBg;color:@t.StatusColor;padding:2px 10px;
                        border-radius:20px;font-size:.72rem;font-weight:600;">
                        @t.Status
                    </span>
                    @if (t.IsForwarded)
                    {
                        <span style="background:rgba(91,114,238,.25);color:#c4b5fd;padding:2px 10px;
                            border-radius:20px;font-size:.72rem;font-weight:600;">
                            <i class="fas fa-forward me-1"></i>Forwarded
                        </span>
                    }
                </div>
            </div>
            <a href="@backUrl" class="btn btn-sm rounded-3"
               style="background:rgba(255,255,255,.15);color:white;font-size:.8rem;
                font-family:Poppins,sans-serif;">
                <i class="fas fa-arrow-left me-1"></i>Back
            </a>
        </div>
        <div class="d-flex gap-3 flex-wrap mt-3" style="font-size:.77rem;color:rgba(255,255,255,.7);">
            <span><i class="fas fa-user me-1"></i>@t.SenderName (@t.SenderRole)</span>
            <span><i class="fas fa-calendar me-1"></i>@t.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
            @if (t.UpdatedAt.HasValue)
            {
                <span><i class="fas fa-sync me-1"></i>Updated @t.UpdatedAt.Value.ToLocalTime().ToString("MMM dd, HH:mm")</span>
            }
        </div>
    </div>

    <!-- Original description -->
    <div class="sa-card-body" style="border-bottom:1px solid rgba(0,0,0,.06);">
        <p style="font-size:.88rem;color:#374151;line-height:1.85;margin:0;">@t.Description</p>
        @if (!string.IsNullOrEmpty(t.AttachmentPath))
        {
            <a href="~/@t.AttachmentPath" target="_blank" download="@t.AttachmentName"
               style="display:inline-flex;align-items:center;gap:6px;margin-top:.75rem;
                background:rgba(0,203,184,.08);color:var(--secondary,#00CBB8);
                border-radius:20px;padding:4px 14px;font-size:.78rem;font-weight:600;text-decoration:none;">
                <i class="fas fa-paperclip"></i>@(t.AttachmentName ?? "Attachment")
            </a>
        }
    </div>

    <!-- Admin: status change controls -->
    @if (isAdmin)
    {
        <div class="sa-card-body" style="background:#fafbff;border-top:1px solid rgba(0,0,0,.04);">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <small style="font-weight:700;color:var(--primary,#2F327D);font-size:.78rem;margin-right:4px;">
                    Change Status:
                </small>
                @foreach (var s in statuses)
                {
                    <form asp-action="ChangeStatus" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TicketId" value="@t.Id" />
                        <input type="hidden" name="NewStatus" value="@s" />
                        <button type="submit" class="tk-status-btn @(t.Status == s ? "tk-active" : "")">
                            @s
                        </button>
                    </form>
                }
                @if (Model.CanForward)
                {
                    <button type="button"
                            class="btn btn-sm rounded-3 ms-auto"
                            style="background:rgba(91,114,238,.1);color:#5B72EE;font-weight:600;
                        font-size:.78rem;font-family:Poppins,sans-serif;"
                            data-bs-toggle="modal" data-bs-target="#forwardModal">
                        <i class="fas fa-forward me-1"></i>Forward to SuperAdmin
                    </button>
                }
            </div>
        </div>
    }
</div>

<!-- ── Conversation thread ────────────────────────────────────────── -->
<div class="sa-card mb-4">
    <div class="sa-card-header">
        <h5 style="font-size:.92rem;font-weight:700;">
            <i class="fas fa-comments me-2" style="color:var(--secondary,#00CBB8);"></i>
            Conversation (@Model.Replies.Count @(Model.Replies.Count == 1 ? "reply" : "replies"))
        </h5>
    </div>
    <div class="sa-card-body">
        @if (!Model.Replies.Any())
        {
            <div class="text-center py-3" style="color:#9ca3af;font-size:.87rem;">
                <i class="fas fa-comment-dots fa-2x d-block mb-2 opacity-25"></i>No replies yet. Be the first to respond.
            </div>
        }
        @foreach (var r in Model.Replies)
        {
            bool mine = r.SenderUserId == Model.CurrentUserId;
            string cls = mine ? "tk-mine" : (r.IsInternal ? "tk-internal" : "tk-theirs");
            <div style="display:flex;flex-direction:column;align-items:@(mine ? "flex-end" : "flex-start");">
                <div class="tk-bubble @cls">
                    <div class="tk-meta">
                        <strong>@r.SenderName</strong> · @r.SenderRole
                        @if (r.IsInternal)
                        {
                            <span style="color:#b45309;"> · Internal note</span>
                        }
                        · @r.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm")
                    </div>
                    <div class="tk-msg">@r.Message</div>
                    @if (!string.IsNullOrEmpty(r.AttachmentPath))
                    {
                        <a href="~/@r.AttachmentPath" target="_blank" download="@r.AttachmentName"
                           style="display:inline-flex;align-items:center;gap:5px;margin-top:.5rem;
                            font-size:.75rem;font-weight:600;text-decoration:none;
                            color:@(mine ? "rgba(255,255,255,.85)" : "var(--secondary,#00CBB8)");">
                            <i class="fas fa-paperclip"></i>@r.AttachmentName
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- ── Reply form ─────────────────────────────────────────────────── -->
@if (Model.CanReply)
{
    <div class="sa-card">
        <div class="sa-card-header">
            <h5 style="font-size:.92rem;font-weight:700;">
                <i class="fas fa-reply me-2" style="color:var(--accent-blue,#29B9E7);"></i>Add Reply
            </h5>
        </div>
        <div class="sa-card-body">
            <form asp-action="Reply" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TicketId" value="@t.Id" />

                <textarea name="Message"
                          class="reply-textarea mb-3"
                          placeholder="Type your reply…"
                          required></textarea>

                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <!-- File upload -->
                    <div class="d-flex align-items-center gap-2" style="flex:1;min-width:0;">
                        <label class="file-label" for="replyFile">
                            <i class="fas fa-paperclip"></i>Attach file
                        </label>
                        <input type="file" name="Attachment" id="replyFile"
                               accept=".pdf,.doc,.docx,.png,.jpg,.jpeg"
                               style="display:none;"
                               onchange="showFileName(this)" />
                        <span class="file-name-display" id="fileNameDisplay"
                              style="color:#9ca3af;">
                            Optional — PDF, Word, image
                        </span>
                    </div>

                    <!-- Internal note toggle (admin only) -->
                    @if (isAdmin)
                    {
                        <label style="display:flex;align-items:center;gap:6px;font-size:.8rem;
                            font-weight:600;cursor:pointer;white-space:nowrap;
                            color:var(--primary,#2F327D);">
                            <input type="checkbox" name="IsInternal" value="true"
                                   style="accent-color:var(--orange,#F48C06);width:15px;height:15px;" />
                            Internal note only
                        </label>
                    }

                    <!-- Send button -->
                    <button type="submit" class="send-btn">
                        <i class="fas fa-paper-plane"></i>Send Reply
                    </button>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <div class="p-3 rounded-3 text-center"
         style="background:rgba(0,0,0,.03);color:#9ca3af;font-size:.85rem;">
        <i class="fas fa-lock me-2"></i>This ticket is <strong>@t.Status</strong> — no further replies.
    </div>
}

<!-- ── Forward modal (admin only) ────────────────────────────────── -->
@if (Model.CanForward)
{
    <div class="modal fade" id="forwardModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" style="max-width:440px;">
            <div class="modal-content"
                 style="border-radius:18px;border:none;box-shadow:0 20px 60px rgba(0,0,0,.15);">
                <div style="background:linear-gradient(135deg,#5B72EE,#29B9E7);
                    border-radius:18px 18px 0 0;padding:1.2rem 1.5rem;
                    display:flex;align-items:center;justify-content:space-between;">
                    <h5 style="color:white;font-weight:700;margin:0;font-size:1rem;">
                        <i class="fas fa-forward me-2"></i>Forward to SuperAdmin
                    </h5>
                    <button class="btn-close" data-bs-dismiss="modal"
                            style="filter:brightness(0) invert(1);"></button>
                </div>
                <form asp-action="Forward" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="TicketId" value="@t.Id" />
                    <div style="padding:1.5rem;">
                        <p style="font-size:.85rem;color:#555;margin-bottom:1rem;">
                            This ticket will be escalated to the SuperAdmin.
                        </p>
                        <textarea name="ForwardNote"
                                  class="reply-textarea"
                                  rows="3"
                                  placeholder="Reason for escalation (optional)…"></textarea>
                    </div>
                    <div style="padding:.5rem 1.5rem 1.3rem;display:flex;gap:.75rem;
                        justify-content:flex-end;border-top:1px solid rgba(0,0,0,.05);">
                        <button type="button"
                                class="btn btn-sm btn-secondary rounded-3 px-4"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit"
                                class="btn btn-sm btn-primary rounded-3 px-4">
                            <i class="fas fa-forward me-1"></i>Forward
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function showFileName(input) {
            var display = document.getElementById('fileNameDisplay');
            if (input.files && input.files.length > 0) {
                display.textContent = input.files[0].name;
                display.style.color = 'var(--secondary, #00CBB8)';
            } else {
                display.textContent = 'Optional — PDF, Word, image';
                display.style.color = '#9ca3af';
            }
        }
    </script>
}
