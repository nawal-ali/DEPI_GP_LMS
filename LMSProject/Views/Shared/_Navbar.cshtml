@using Microsoft.AspNetCore.Identity
@inject SignInManager<MLSCore.IdentityModel.ApplicationUser> SignInManager
@inject UserManager<MLSCore.IdentityModel.ApplicationUser> UserMgr
@{
    var isHome = ViewContext.RouteData.Values["controller"]?.ToString() == "Home"
                 && ViewContext.RouteData.Values["action"]?.ToString() == "Index";

    // Determine the correct dashboard URL based on role
    string dashUrl = "/";
    string dashLabel = "Dashboard";
    if (SignInManager.IsSignedIn(User))
    {
        var user = await UserMgr.GetUserAsync(User);
        if (user != null)
        {
            if (await UserMgr.IsInRoleAsync(user, "SuperAdmin")) { dashUrl = "/SuperAdmin/Home/Index"; dashLabel = "SuperAdmin Panel"; }
            else if (await UserMgr.IsInRoleAsync(user, "Admin")) { dashUrl = "/Admin/Home/Index"; dashLabel = "Admin Panel"; }
            else if (await UserMgr.IsInRoleAsync(user, "Instructor")) { dashUrl = "/Instructor/Home/Index"; dashLabel = "Instructor Panel"; }
            else if (await UserMgr.IsInRoleAsync(user, "Parent")) { dashUrl = "/Parent/Home/Index"; dashLabel = "Parent Portal"; }
            else if (await UserMgr.IsInRoleAsync(user, "Student")) { dashUrl = "/Student/Home/Index"; dashLabel = "Student Portal"; }
            else { dashUrl = "/"; dashLabel = "Dashboard"; }
        }
    }
}

<nav class="navbar navbar-expand-md p-4 fixed-top transition @(isHome ? "navbar-transparent" : "navbar-solid shadow-sm")"
     id="mainNav">
    <div class="container-fluid">

        <!-- LOGO -->
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            <img id="navbarLogo"
                 src="~/Images/images/@(isHome ? "logo_white.png" : "logo_black.png")"
                 alt="Logo" style="height: 70px;">
        </a>

        <!-- TOGGLER -->
        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- MENU -->
        <div class="offcanvas offcanvas-end" id="offcanvasNavbar">
            <div class="offcanvas-body">
                <ul class="navbar-nav ms-auto align-items-center gap-3">


                    <!-- Language Toggle -->
                    <li class="nav-item">
                        <button onclick="toggleLang()" id="langBtn"
                                style="background:rgba(255,255,255,.15);border:1.5px solid rgba(255,255,255,.3);
                            color:white;border-radius:20px;padding:4px 14px;font-size:.82rem;
                            font-family:Poppins,sans-serif;cursor:pointer;transition:all .2s;
                            display:flex;align-items:center;gap:6px;">
                            <span id="langFlag">🇬🇧</span>
                            <span id="langLabel">العربية</span>
                        </button>
                    </li>

                    <li class="nav-item fs-5">
                        <a class="nav-link nav-text d-flex align-items-center gap-2"
                           asp-controller="Home" asp-action="Index">
                            <i class="fas fa-home"></i>Home
                        </a>
                    </li>

                    <li class="nav-item fs-5">
                        <a class="nav-link nav-text d-flex align-items-center gap-2" href="#">
                            <i class="fas fa-newspaper"></i>Blog
                        </a>
                    </li>

                    <li class="nav-item fs-5">
                        <a class="nav-link nav-text d-flex align-items-center gap-2" asp-controller="Home" asp-action="About">
                            <i class="fas fa-info-circle"></i>About
                        </a>
                    </li>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <!-- Logged in: show Dashboard button -->
                        <li class="nav-item fs-5 rounded-5 px-3"
                            style="background-color:#2F327D;">
                            <a class="nav-link d-flex align-items-center gap-2"
                               style="color:white !important;"
                               href="@dashUrl">
                                <i class="fas fa-tachometer-alt"></i>@dashLabel
                            </a>
                        </li>
                        <li class="nav-item fs-5">
                            <a class="nav-link nav-text d-flex align-items-center gap-2"
                               asp-controller="Account" asp-action="Logout"
                               style="color:var(--accent-pink);">
                                <i class="fas fa-sign-out-alt"></i>Logout
                            </a>
                        </li>
                    }
                    else
                    {
                        <!-- Not logged in: show Login button -->
                        <li class="nav-item fs-5 rounded-5 px-3"
                            style="background-color:#2F327D;">
                            <a class="nav-link d-flex align-items-center gap-2"
                               style="color:white !important;"
                               asp-controller="Account" asp-action="Login">
                                <i class="fas fa-sign-in-alt"></i>Login
                            </a>
                        </li>
                    }

                </ul>
            </div>
        </div>
    </div>
</nav>
