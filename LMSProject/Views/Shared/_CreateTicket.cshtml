@using LMSProject.ViewModels.Tickets
@model CreateTicketVM
@{
    var postArea = ViewData["PostArea"] as string ?? "Parent";
    var backUrl = ViewData["BackUrl"] as string ?? "#";
}

<style>
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(18px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    .create-ticket-card {
        animation: fadeIn .4s ease;
    }

    .sa-form-control {
        border-radius: 10px;
        border: 1.5px solid rgba(47,50,125,.14);
        padding: .6rem .9rem;
        font-size: .875rem;
        width: 100%;
        transition: border-color .15s,box-shadow .15s;
        outline: none;
        font-family: Poppins,sans-serif;
    }

        .sa-form-control:focus {
            border-color: var(--secondary,#00CBB8);
            box-shadow: 0 0 0 3px rgba(0,203,184,.15);
        }

    /* Type selection buttons */
    .tk-type-btn {
        border: 2px solid rgba(47,50,125,.14);
        border-radius: 12px;
        padding: .7rem 1rem;
        cursor: pointer;
        transition: all .18s;
        background: white;
        font-family: Poppins,sans-serif;
        font-size: .84rem;
        font-weight: 600;
        color: var(--primary,#2F327D);
        text-align: center;
        width: 100%;
        display: block;
        user-select: none;
    }

        .tk-type-btn:hover {
            border-color: var(--secondary,#00CBB8);
            background: rgba(0,203,184,.06);
        }

        .tk-type-btn.tk-sel {
            border-color: var(--secondary,#00CBB8);
            background: rgba(0,203,184,.12);
            color: var(--secondary,#00CBB8);
        }
</style>

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="sa-card create-ticket-card">

            <!-- Header -->
            <div style="background:linear-gradient(135deg,var(--primary,#2F327D),#5B72EE);
                border-radius:16px 16px 0 0;padding:1.5rem 2rem;
                display:flex;align-items:center;gap:1rem;">
                <div style="width:48px;height:48px;border-radius:14px;background:rgba(255,255,255,.15);
                    display:flex;align-items:center;justify-content:center;">
                    <i class="fas fa-headset" style="color:white;font-size:1.2rem;"></i>
                </div>
                <div>
                    <h5 style="color:white;font-weight:700;margin:0;">Submit a Support Ticket</h5>
                    <small style="color:rgba(255,255,255,.7);font-size:.78rem;">
                        Your ticket will be received by an Admin who will respond as soon as possible.
                    </small>
                </div>
            </div>

            <div class="sa-card-body">
                <form asp-area="@postArea" asp-controller="Tickets" asp-action="Create"
                      method="post" enctype="multipart/form-data" id="ticketForm">
                    @Html.AntiForgeryToken()

                    <!-- Hidden type value submitted with form -->
                    <input type="hidden" name="Type" id="ticketTypeInput" value="Inquiry" />

                    <!-- Ticket Type buttons -->
                    <div class="mb-4">
                        <label class="form-label"
                               style="font-weight:700;font-size:.85rem;color:var(--primary,#2F327D);">
                            Ticket Type <span class="text-danger">*</span>
                        </label>
                        <div class="row g-2" id="typeButtonsRow">
                            <div class="col-6 col-md-3">
                                <div class="tk-type-btn tk-sel" data-type="Inquiry">
                                    <i class="fas fa-question-circle d-block mb-1" style="font-size:1.2rem;"></i>
                                    Inquiry
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="tk-type-btn" data-type="Complaint">
                                    <i class="fas fa-exclamation-circle d-block mb-1" style="font-size:1.2rem;"></i>
                                    Complaint
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="tk-type-btn" data-type="Suggestion">
                                    <i class="fas fa-lightbulb d-block mb-1" style="font-size:1.2rem;"></i>
                                    Suggestion
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="tk-type-btn" data-type="Other">
                                    <i class="fas fa-ellipsis-h d-block mb-1" style="font-size:1.2rem;"></i>
                                    Other
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Custom type — shown only when "Other" selected -->
                    <div class="mb-3" id="customTypeArea" style="display:none;">
                        <label class="form-label" style="font-weight:600;font-size:.84rem;">
                            Specify Type <span class="text-danger">*</span>
                        </label>
                        <input name="CustomType" id="customTypeInput"
                               class="sa-form-control"
                               placeholder="e.g. Technical Issue, Schedule Request…" />
                    </div>

                    <!-- Title -->
                    <div class="mb-3">
                        <label class="form-label" style="font-weight:600;font-size:.84rem;">
                            Subject / Title <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Title" class="sa-form-control"
                               placeholder="Brief description of your issue…" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label class="form-label" style="font-weight:600;font-size:.84rem;">
                            Description <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="Description" rows="5" class="sa-form-control"
                                  placeholder="Provide as much detail as possible…"
                                  style="resize:vertical;"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <!-- Attachment -->
                    <div class="mb-4">
                        <label class="form-label" style="font-weight:600;font-size:.84rem;">
                            Attachment
                            <small class="text-muted fw-normal">(optional — PDF, Word, or image)</small>
                        </label>
                        <input asp-for="Attachment" type="file" class="sa-form-control"
                               accept=".pdf,.doc,.docx,.png,.jpg,.jpeg" />
                    </div>

                    <!-- Actions -->
                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-primary rounded-3 px-4 flex-grow-1"
                                style="font-family:Poppins,sans-serif;">
                            <i class="fas fa-paper-plane me-2"></i>Submit Ticket
                        </button>
                        <a href="@backUrl" class="btn rounded-3 px-4"
                           style="background:rgba(47,50,125,.07);color:var(--primary,#2F327D);
                            font-weight:600;font-family:Poppins,sans-serif;">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@*
    ── IMPORTANT ──────────────────────────────────────────────────────────────
    @section Scripts is IGNORED in partials. JS must be inline here.
    ──────────────────────────────────────────────────────────────────────────
*@
<script>
    (function () {
        var hiddenInput    = document.getElementById('ticketTypeInput');
        var customArea     = document.getElementById('customTypeArea');
        var customInput    = document.getElementById('customTypeInput');
        var buttons        = document.querySelectorAll('#typeButtonsRow .tk-type-btn');

        buttons.forEach(function (btn) {
            btn.addEventListener('click', function () {
                // Deselect all
                buttons.forEach(function (b) { b.classList.remove('tk-sel'); });

                // Select clicked
                btn.classList.add('tk-sel');

                // Update hidden field
                var type = btn.getAttribute('data-type');
                hiddenInput.value = type;

                // Show/hide custom input
                if (type === 'Other') {
                    customArea.style.display = 'block';
                    customInput.setAttribute('required', 'required');
                    customInput.focus();
                } else {
                    customArea.style.display = 'none';
                    customInput.removeAttribute('required');
                    customInput.value = '';
                }
            });
        });
    })();
</script>
