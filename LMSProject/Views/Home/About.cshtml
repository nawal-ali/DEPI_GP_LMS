                    <h3 style="font-weight:800;margin-bottom:1.5rem;" data-i18n="Built for Everyone">Built for Everyone</h3>
                    <div class="row g-3">
                        <div class="col-12">
                            <div style="display:flex;align-items:center;gap:1rem;background:rgba(255,255,255,.1);border-radius:12px;padding:.8rem 1.1rem;">
                                <div style="width:38px;height:38px;border-radius:10px;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;font-size:.9rem;flex-shrink:0;"><i class="fas fa-user-graduate"></i></div>
                                <div><div style="font-weight:700;font-size:.88rem;" data-i18n="Students">Students</div><div style="opacity:.75;font-size:.78rem;" data-i18n="Access courses, take exams, use AI tools">Access courses, take exams, use AI tools</div></div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div style="display:flex;align-items:center;gap:1rem;background:rgba(255,255,255,.1);border-radius:12px;padding:.8rem 1.1rem;">
                                <div style="width:38px;height:38px;border-radius:10px;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;font-size:.9rem;flex-shrink:0;"><i class="fas fa-chalkboard-teacher"></i></div>
                                <div><div style="font-weight:700;font-size:.88rem;" data-i18n="Instructors">Instructors</div><div style="opacity:.75;font-size:.78rem;" data-i18n="Manage courses, grade, create with AI">Manage courses, grade, create with AI</div></div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div style="display:flex;align-items:center;gap:1rem;background:rgba(255,255,255,.1);border-radius:12px;padding:.8rem 1.1rem;">
                                <div style="width:38px;height:38px;border-radius:10px;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;font-size:.9rem;flex-shrink:0;"><i class="fas fa-user-shield"></i></div>
                                <div><div style="font-weight:700;font-size:.88rem;" data-i18n="Admins">Admins</div><div style="opacity:.75;font-size:.78rem;" data-i18n="Monitor all activity, manage users">Monitor all activity, manage users</div></div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div style="display:flex;align-items:center;gap:1rem;background:rgba(255,255,255,.1);border-radius:12px;padding:.8rem 1.1rem;">
                                <div style="width:38px;height:38px;border-radius:10px;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;font-size:.9rem;flex-shrink:0;"><i class="fas fa-users-cog"></i></div>
                                <div><div style="font-weight:700;font-size:.88rem;" data-i18n="Super Admins">Super Admins</div><div style="opacity:.75;font-size:.78rem;" data-i18n="Full system control, configuration">Full system control, configuration</div></div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div style="display:flex;align-items:center;gap:1rem;background:rgba(255,255,255,.1);border-radius:12px;padding:.8rem 1.1rem;">
                                <div style="width:38px;height:38px;border-radius:10px;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;font-size:.9rem;flex-shrink:0;"><i class="fas fa-user-friends"></i></div>
                                <div><div style="font-weight:700;font-size:.88rem;" data-i18n="Parents">Parents</div><div style="opacity:.75;font-size:.78rem;" data-i18n="Monitor children, receive weekly reports">Monitor children, receive weekly reports</div></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ── CTA ────────────────────────────────────────────────────────── -->
<section class="py-5 text-center bg-white reveal-up">
    <div class="container">
        <div style="background:linear-gradient(135deg,#2F327D,#5B72EE,#00CBB8);
            border-radius:24px;padding:4rem 2rem;color:white;">
            <h2 style="font-weight:800;margin-bottom:.75rem;">Ready to Get Started?</h2>
            <p style="opacity:.85;max-width:500px;margin:0 auto 2rem;font-size:.95rem;">
                Join thousands of students and educators already using TOTC. Contact us today.
            </p>
            <a href="/#contact" class="btn btn-light rounded-pill px-5 py-2 fw-bold"
               style="color:#2F327D;font-family:Poppins,sans-serif;">
                <i class="fas fa-paper-plane me-2"></i>Register with TOTC
            </a>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function() {
            var all = document.querySelectorAll('.reveal-up,.reveal-left,.reveal-right,.reveal-fade');
            if (!all.length) return;
            var io = new IntersectionObserver(function(entries) {
                entries.forEach(function(e) {
                    if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
                });
            }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
            all.forEach(function(el) { io.observe(el); });
        })();
    </script>
}
