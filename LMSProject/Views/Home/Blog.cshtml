@model List<MLSCore.Models.TbArticle>
@{
    ViewData["Title"] = "Blog";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string Grad(int id) => (id % 5) switch
    {
        0 => "linear-gradient(135deg,#2F327D,#5B72EE)",
        1 => "linear-gradient(135deg,#00CBB8,#29B9E7)",
        2 => "linear-gradient(135deg,#E13468,#F48C06)",
        3 => "linear-gradient(135deg,#5B72EE,#29B9E7)",
        _ => "linear-gradient(135deg,#F48C06,#FDCB6E)"
    };
    string Ico(int id) => (id % 4) switch
    {
        0 => "fa-newspaper",
        1 => "fa-pen-nib",
        2 => "fa-book-open",
        _ => "fa-rss"
    };
}

<!-- ═══ HERO ═══════════════════════════════════════════════════════ -->
<div style="position:relative;overflow:hidden;
    background:linear-gradient(135deg,var(--primary) 0%,#3d3f8f 40%,#00a89d 100%);
    padding:5.5rem 0 4rem;">

    <!-- Decorative blobs -->
    <div style="position:absolute;width:600px;height:600px;border-radius:50%;
    background:rgba(255,255,255,.04);top:-200px;right:-150px;pointer-events:none;"></div>
    <div style="position:absolute;width:350px;height:350px;border-radius:50%;
    background:rgba(0,203,184,.08);bottom:-100px;left:-80px;pointer-events:none;"></div>
    <!-- Grid pattern overlay -->
    <div style="position:absolute;inset:0;
    background-image:radial-gradient(circle,rgba(255,255,255,.06) 1px,transparent 1px);
    background-size:30px 30px;pointer-events:none;"></div>

    <div class="container text-center" style="position:relative;z-index:1;">
        <!-- Pill badge -->
        <div style="display:inline-flex;align-items:center;gap:.5rem;
            background:rgba(255,255,255,.12);backdrop-filter:blur(8px);
            border:1px solid rgba(255,255,255,.2);
            color:white;border-radius:30px;
            padding:.4rem 1.3rem;font-size:.78rem;font-weight:700;
            letter-spacing:.5px;margin-bottom:1.4rem;">
            <i class="fas fa-newspaper"></i>
            BLOG &amp; ARTICLES
        </div>

        <h1 style="margin-top:2rem;color:white;font-weight:900;font-size:clamp(2.2rem,5vw,3.5rem);
            margin-bottom:.8rem;line-height:1.1;
            text-shadow:0 2px 20px rgba(0,0,0,.15);">
            Latest News &amp; <span style="color:#00e5d1;">Insights</span>
        </h1>
        <p style="color:rgba(255,255,255,.72);font-size:1.05rem;
            max-width:520px;margin:0 auto 2rem;line-height:1.7;">
            Stories, updates and expert insights from the TOTC learning platform.
        </p>

        <!-- Stats row -->
        <div style="display:inline-flex;gap:2.5rem;background:rgba(255,255,255,.1);
            backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.15);
            border-radius:20px;padding:.9rem 2.5rem;">
            <div style="text-align:center;">
                <div style="color:white;font-weight:800;font-size:1.4rem;">@Model.Count</div>
                <div style="color:rgba(255,255,255,.55);font-size:.72rem;text-transform:uppercase;letter-spacing:.4px;">Articles</div>
            </div>
            <div style="width:1px;background:rgba(255,255,255,.2);"></div>
            <div style="text-align:center;">
                <div style="color:white;font-weight:800;font-size:1.4rem;">@Model.Count(a => a.CoverImage != null)</div>
                <div style="color:rgba(255,255,255,.55);font-size:.72rem;text-transform:uppercase;letter-spacing:.4px;">With Cover</div>
            </div>
            <div style="width:1px;background:rgba(255,255,255,.2);"></div>
            <div style="text-align:center;">
                <div style="color:white;font-weight:800;font-size:1.4rem;">@(Model.Any() ? Model.Max(a => a.CreatedAt).ToString("yyyy") : "—")</div>
                <div style="color:rgba(255,255,255,.55);font-size:.72rem;text-transform:uppercase;letter-spacing:.4px;">Latest Year</div>
            </div>
        </div>
    </div>
</div>

<!-- ═══ ARTICLES ════════════════════════════════════════════════════ -->
<div style="background:#f0f2ff;padding:3.5rem 0 4rem;">
    <div class="container">

        @if (Model == null || !Model.Any())
        {
            <div style="text-align:center;padding:5rem 0;">
                <i class="fas fa-newspaper" style="font-size:3.5rem;color:rgba(47,50,125,.12);display:block;margin-bottom:1rem;"></i>
                <p style="color:#9ca3af;font-size:1rem;">No articles published yet. Check back soon!</p>
            </div>
        }
        else
        {
            var first = Model[0];
            var second = Model.Count > 1 ? Model[1] : null;

            <!-- FEATURED ROW -->
            <div class="row g-4 mb-4">

                <!-- Featured card (large) -->
                <div class="@(second != null ? "col-lg-8" : "col-12")">
                    <a asp-controller="Home" asp-action="Article" asp-route-id="@first.Id"
                       style="text-decoration:none;display:block;height:100%;">
                        <div style="background:white;border-radius:20px;overflow:hidden;height:100%;
                            box-shadow:0 6px 32px rgba(47,50,125,.1);
                            transition:box-shadow .25s,transform .2s;"
                             onmouseover="this.style.boxShadow='0 14px 44px rgba(47,50,125,.18)';this.style.transform='translateY(-3px)'"
                             onmouseout="this.style.boxShadow='0 6px 32px rgba(47,50,125,.1)';this.style.transform=''">
                            <div style="display:flex;flex-direction:row;height:100%;">
                                <!-- Cover -->
                                @if (!string.IsNullOrEmpty(first.CoverImage))
                                {
                                    <img src="/@first.CoverImage" alt="@first.Title"
                                         style="width:300px;height:100%;min-height:240px;object-fit:cover;flex-shrink:0;" />
                                }
                                else
                                {
                                    <div style="width:260px;flex-shrink:0;display:flex;align-items:center;
                                        justify-content:center;background:@Grad(first.Id);min-height:240px;">
                                        <i class="fas @Ico(first.Id)" style="font-size:3.5rem;color:rgba(255,255,255,.6);"></i>
                                    </div>
                                }
                                <!-- Body -->
                                <div style="padding:1.8rem 2rem;display:flex;flex-direction:column;justify-content:center;flex:1;">
                                    <div style="margin-bottom:.8rem;">
                                        <span style="display:inline-block;background:linear-gradient(135deg,var(--primary),#5B72EE);
                                            color:white;border-radius:20px;padding:4px 14px;
                                            font-size:.68rem;font-weight:800;letter-spacing:.5px;">
                                            ⭐ FEATURED
                                        </span>
                                    </div>
                                    <div style="font-weight:800;color:var(--primary);font-size:1.1rem;
                                        line-height:1.45;margin-bottom:.6rem;">
                                        @first.Title
                                    </div>
                                    <div style="font-size:.75rem;color:#9ca3af;margin-bottom:.85rem;">
                                        <i class="fas fa-calendar me-1"></i>@first.CreatedAt.ToString("MMMM dd, yyyy")
                                    </div>
                                    <div style="font-size:.87rem;color:#6b7280;line-height:1.75;
                                        overflow:hidden;display:-webkit-box;
                                        -webkit-line-clamp:3;-webkit-box-orient:vertical;">
                                        @first.Excerpt
                                    </div>
                                    <div style="display:inline-flex;align-items:center;gap:.5rem;
                                        margin-top:1.2rem;padding-top:1rem;border-top:1px solid rgba(0,0,0,.06);
                                        font-size:.82rem;font-weight:700;color:var(--secondary);">
                                        Read article <i class="fas fa-arrow-right"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Second article -->
                @if (second != null)
                {
                    <div class="col-lg-4">
                        <a asp-controller="Home" asp-action="Article" asp-route-id="@second.Id"
                           style="text-decoration:none;display:block;height:100%;">
                            <div style="background:white;border-radius:20px;overflow:hidden;height:100%;
                                box-shadow:0 6px 32px rgba(47,50,125,.1);
                                display:flex;flex-direction:column;
                                transition:box-shadow .25s,transform .2s;"
                                 onmouseover="this.style.boxShadow='0 14px 44px rgba(47,50,125,.18)';this.style.transform='translateY(-3px)'"
                                 onmouseout="this.style.boxShadow='0 6px 32px rgba(47,50,125,.1)';this.style.transform=''">
                                @if (!string.IsNullOrEmpty(second.CoverImage))
                                {
                                    <img src="/@second.CoverImage" alt="@second.Title" style="width:100%;height:200px;object-fit:cover;" />
                                }
                                else
                                {

                                    <div style="height:200px;display:flex;align-items:center;justify-content:center;background:@Grad(second.Id);"><i class="fas @Ico(second.Id)" style="font-size:2.8rem;color:rgba(255,255,255,.65);"></i></div>
                                }
                                <div style="padding:1.4rem;flex:1;display:flex;flex-direction:column;">
                                    <span style="display:inline-block;background:rgba(0,203,184,.1);color:var(--secondary);
                                    border-radius:20px;padding:3px 12px;font-size:.68rem;font-weight:700;
                                    margin-bottom:.65rem;">ARTICLE</span>
                                    <div style="font-weight:800;color:var(--primary);font-size:.95rem;line-height:1.45;margin-bottom:.5rem;">@second.Title</div>
                                    <div style="font-size:.73rem;color:#9ca3af;margin-bottom:.65rem;"><i class="fas fa-calendar me-1"></i>@second.CreatedAt.ToString("MMM dd, yyyy")</div>
                                    <div style="font-size:.83rem;color:#6b7280;line-height:1.7;flex:1;overflow:hidden;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;">@second.Excerpt</div>
                                    <div style="display:inline-flex;align-items:center;gap:.4rem;margin-top:1rem;padding-top:.85rem;border-top:1px solid rgba(0,0,0,.06);font-size:.8rem;font-weight:700;color:var(--secondary);">
                                        Read article <i class="fas fa-arrow-right"></i>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>

            <!-- REMAINING GRID -->
            @if (Model.Count > 2)
            {
                <div style="font-size:.7rem;font-weight:800;color:#9ca3af;text-transform:uppercase;
                    letter-spacing:.6px;margin-bottom:1.2rem;">
                    <i class="fas fa-th-large me-2" style="color:var(--secondary);"></i>All Articles
                </div>
                <div class="row g-4">
                    @foreach (var a in Model.Skip(2))
                    {
                        <div class="col-md-6 col-lg-4">
                            <a asp-controller="Home" asp-action="Article" asp-route-id="@a.Id"
                               style="text-decoration:none;display:block;height:100%;">
                                <div style="background:white;border-radius:18px;overflow:hidden;height:100%;
                                    box-shadow:0 4px 20px rgba(47,50,125,.08);display:flex;flex-direction:column;
                                    transition:box-shadow .25s,transform .2s;"
                                     onmouseover="this.style.boxShadow='0 12px 36px rgba(47,50,125,.16)';this.style.transform='translateY(-3px)'"
                                     onmouseout="this.style.boxShadow='0 4px 20px rgba(47,50,125,.08)';this.style.transform=''">
                                    @if (!string.IsNullOrEmpty(a.CoverImage))
                                    {
                                        <img src="/@a.CoverImage" alt="@a.Title" style="width:100%;height:190px;object-fit:cover;" />
                                    }
                                    else
                                    {

                                        <div style="height:190px;display:flex;align-items:center;justify-content:center;background:@Grad(a.Id);"><i class="fas @Ico(a.Id)" style="font-size:2.5rem;color:rgba(255,255,255,.65);"></i></div>
                                    }
                                    <div style="padding:1.3rem;flex:1;display:flex;flex-direction:column;">
                                        <span style="display:inline-block;background:rgba(0,203,184,.1);color:var(--secondary);border-radius:20px;padding:2px 11px;font-size:.67rem;font-weight:700;margin-bottom:.55rem;">ARTICLE</span>
                                        <div style="font-weight:800;color:var(--primary);font-size:.92rem;line-height:1.45;margin-bottom:.45rem;">@a.Title</div>
                                        <div style="font-size:.72rem;color:#9ca3af;margin-bottom:.6rem;"><i class="fas fa-calendar me-1"></i>@a.CreatedAt.ToString("MMM dd, yyyy")</div>
                                        <div style="font-size:.82rem;color:#6b7280;line-height:1.7;flex:1;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">@a.Excerpt</div>
                                        <div style="display:inline-flex;align-items:center;gap:.35rem;margin-top:.9rem;padding-top:.8rem;border-top:1px solid rgba(0,0,0,.06);font-size:.78rem;font-weight:700;color:var(--secondary);">
                                            Read article <i class="fas fa-arrow-right"></i>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>
