@section Scripts {
    <script>
        (function () {
            // ── Single unified IntersectionObserver for ALL animation classes ──
            var selectors = [
                '.scroll-reveal', '.fade-up', '.fade-left',
                '.reveal-up', '.reveal-left', '.reveal-right', '.reveal-fade'
            ];
            var els = document.querySelectorAll(selectors.join(','));

            if (els.length) {
                var io = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (!entry.isIntersecting) return;
                        entry.target.classList.add('visible', 'revealed');
                        io.unobserve(entry.target);
                    });
                }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

                els.forEach(function (el) { io.observe(el); });
            }

            // ── Stagger: animate children of .reveal-stagger containers ──────
            document.querySelectorAll('.reveal-stagger').forEach(function (parent) {
                Array.from(parent.children).forEach(function (child, i) {
                    child.classList.add('reveal-up');
                    child.style.transitionDelay = (i * 0.1) + 's';
                    if (els.length) {
                        var io2 = new IntersectionObserver(function (entries) {
                            entries.forEach(function (e) {
                                if (!e.isIntersecting) return;
                                e.target.classList.add('visible', 'revealed');
                                io2.unobserve(e.target);
                            });
                        }, { threshold: 0.1 });
                        io2.observe(child);
                    }
                });
            });

            // ── Scroll to #contact if redirected back with ?section=contact ──
            var params = new URLSearchParams(window.location.search);
            if (params.get('section') === 'contact') {
                var el = document.getElementById('contact');
                if (el) setTimeout(function () { el.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 400);
            }

            // ── Counter animation for stats ────────────────────────────────
            document.querySelectorAll('.stat-box h3').forEach(function (el) {
                var done = false;
                var io3 = new IntersectionObserver(function (entries) {
                    if (!entries[0].isIntersecting || done) return;
                    done = true;
                    var txt = el.textContent;
                    var num = parseInt(txt.replace(/[^0-9]/g, ''));
                    var suffix = txt.replace(/[0-9]/g, '');
                    if (!num) return;
                    var cur = 0, step = Math.ceil(num / 40);
                    var t = setInterval(function () {
                        cur = Math.min(cur + step, num);
                        el.textContent = cur + suffix;
                        if (cur >= num) clearInterval(t);
                    }, 30);
                    io3.unobserve(el);
                }, { threshold: 0.5 });
                io3.observe(el);
            });
        })();
    </script>
}