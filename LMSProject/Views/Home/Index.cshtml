                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="contact-label">Full Name <span class="text-danger">*</span></label>
                                <div class="contact-input-wrap">
                                    <i class="fas fa-user"></i>
                                    <input type="text" name="FullName" class="contact-input" placeholder="Your full name" required maxlength="100" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="contact-label">Email Address <span class="text-danger">*</span></label>
                                <div class="contact-input-wrap">
                                    <i class="fas fa-envelope"></i>
                                    <input type="email" name="Email" class="contact-input" placeholder="your@email.com" required maxlength="150" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="contact-label">Phone Number</label>
                                <div class="contact-input-wrap">
                                    <i class="fas fa-phone"></i>
                                    <input type="tel" name="Phone" class="contact-input" placeholder="+20 10 0000 0000" maxlength="20" />
                                </div>
                            </div>
                            <div class="col-md-6 d-flex align-items-end">
