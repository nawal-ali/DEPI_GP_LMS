                            <div class="cp-title">Expert Instructors</div>
                            <div class="cp-text">Learn from qualified educators with real-world experience.</div>
                        </div>
                    </div>
                    <div class="contact-point">
                        <div class="cp-icon" style="background:rgba(91,114,238,.1);color:var(--accent-purple);"><i class="fas fa-shield-alt"></i></div>
                        <div>
                            <div class="cp-title">Safe &amp; Monitored</div>
                            <div class="cp-text">Parents stay informed with weekly progress reports.</div>
                        </div>
                    </div>
                    <div class="contact-point">
                        <div class="cp-icon" style="background:rgba(244,140,6,.1);color:var(--orange);"><i class="fas fa-robot"></i></div>
                        <div>
                            <div class="cp-title">AI-Powered Learning</div>
                            <div class="cp-text">Smart study tools, practice questions, and personalized plans.</div>
                        </div>
                    </div>
                    <div class="contact-point" style="border:none;padding-bottom:0;">
                        <div class="cp-icon" style="background:rgba(225,52,104,.1);color:var(--accent-pink);"><i class="fas fa-mobile-alt"></i></div>
