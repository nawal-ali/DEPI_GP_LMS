@model MLSCore.Models.TbArticle
@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";

    string Grad(int id) => (id % 5) switch
    {
        0 => "linear-gradient(135deg,#2F327D,#5B72EE)",
        1 => "linear-gradient(135deg,#00CBB8,#29B9E7)",
        2 => "linear-gradient(135deg,#E13468,#F48C06)",
        3 => "linear-gradient(135deg,#5B72EE,#29B9E7)",
        _ => "linear-gradient(135deg,#F48C06,#FDCB6E)"
    };
    string Ico(int id) => (id % 4) switch
    {
        0 => "fa-newspaper",
        1 => "fa-pen-nib",
        2 => "fa-book-open",
        _ => "fa-rss"
    };
    var related = ViewBag.Related as List<MLSCore.Models.TbArticle> ?? new();
}

<!-- COVER HERO -->
<div style="position:relative;width:100%;height:380px;overflow:hidden;background:#0d1030;">
    @if (!string.IsNullOrEmpty(Model.CoverImage))
    {
        <img src="/@Model.CoverImage" alt="@Model.Title"
             style="width:100%;height:100%;object-fit:cover;opacity:.65;display:block;" />
    }
    else
    {
        <div style="width:100%;height:100%;background:@Grad(Model.Id);opacity:.9;"></div>
        <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;">
            <i class="fas @Ico(Model.Id)" style="font-size:5rem;color:rgba(255,255,255,.2);"></i>
        </div>
    }
    <!-- Gradient overlay -->
    <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(13,16,48,.95) 0%,rgba(13,16,48,.4) 60%,transparent 100%);"></div>
    <!-- Title inside hero -->
    <div style="position:absolute;bottom:0;left:0;right:0;padding:2rem 3rem;">
        <div class="container" style="max-width:1100px;">
            <span style="background:rgba(0,203,184,.85);color:white;border-radius:20px;
                padding:3px 14px;font-size:.7rem;font-weight:700;letter-spacing:.4px;display:inline-block;margin-bottom:.75rem;">
                ARTICLE
            </span>
            <h1 style="color:white;font-weight:900;font-size:clamp(1.4rem,3vw,2.2rem);
                line-height:1.3;margin:0;text-shadow:0 2px 12px rgba(0,0,0,.4);">
                @Model.Title
            </h1>
        </div>
    </div>
</div>

<!-- BODY -->
<div style="background:#f0f2ff;padding:2.5rem 0 4rem;">
    <div class="container" style="max-width:1100px;">

        <!-- Breadcrumb -->
        <nav style="font-size:.78rem;margin-bottom:1.5rem;">
            <a asp-controller="Home" asp-action="Index"
               style="color:var(--secondary);text-decoration:none;">Home</a>
            <span style="color:#9ca3af;margin:0 .5rem;">/</span>
            <a asp-controller="Home" asp-action="Blog"
               style="color:var(--secondary);text-decoration:none;">Blog</a>
            <span style="color:#9ca3af;margin:0 .5rem;">/</span>
            <span style="color:#6b7280;">
                @(Model.Title.Length > 45 ? Model.Title[..45] + "…" : Model.Title)
            </span>
        </nav>

        <div class="row g-4">

            <!-- ── MAIN ARTICLE ───────────────────── -->
            <div class="col-lg-8">
                <div style="background:white;border-radius:20px;
                    box-shadow:0 4px 24px rgba(47,50,125,.07);
                    overflow:hidden;">

                    <!-- Meta bar -->
                    <div style="padding:1.3rem 1.8rem;border-bottom:1px solid rgba(0,0,0,.05);
                        display:flex;align-items:center;gap:1.2rem;flex-wrap:wrap;">
                        <span style="font-size:.78rem;color:#9ca3af;">
                            <i class="fas fa-calendar me-1" style="color:var(--secondary);"></i>
                            @Model.CreatedAt.ToString("MMMM dd, yyyy")
                        </span>
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <span style="font-size:.78rem;color:#9ca3af;">
                                <i class="fas fa-edit me-1" style="color:var(--purple);"></i>
                                Updated @Model.UpdatedAt.Value.ToString("MMM dd, yyyy")
                            </span>
                        }
                        <span style="background:rgba(0,203,184,.1);color:var(--secondary);
                            border-radius:20px;padding:2px 12px;font-size:.68rem;font-weight:700;">
                            ARTICLE
                        </span>
                    </div>

                    <!-- Content -->
                    <div style="padding:2rem 1.8rem;">

                        <!-- Excerpt blockquote -->
                        @if (!string.IsNullOrEmpty(Model.Excerpt))
                        {
                            <blockquote style="border-left:4px solid var(--secondary);padding:.9rem 1.2rem;
                                margin:0 0 1.8rem;background:rgba(0,203,184,.05);
                                border-radius:0 12px 12px 0;">
                                <p style="font-size:1rem;color:#374151;line-height:1.75;
                                font-style:italic;margin:0;">@Model.Excerpt</p>
                            </blockquote>
                        }

                        <!-- Full content -->
                        <div style="font-size:.97rem;line-height:1.95;color:#374151;white-space:pre-wrap;">@Model.Content</div>

                        <!-- Back button -->
                        <div style="margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid rgba(0,0,0,.06);">
                            <a asp-controller="Home" asp-action="Blog"
                               style="display:inline-flex;align-items:center;gap:.55rem;
                                background:rgba(47,50,125,.07);color:var(--primary);
                                border-radius:10px;padding:.55rem 1.2rem;
                                font-size:.83rem;font-weight:700;text-decoration:none;
                                transition:background .2s;"
                               onmouseover="this.style.background='rgba(47,50,125,.14)'"
                               onmouseout="this.style.background='rgba(47,50,125,.07)'">
                                <i class="fas fa-arrow-left"></i> Back to Blog
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── SIDEBAR ─────────────────────────── -->
            <div class="col-lg-4">
                <div style="position:sticky;top:1.5rem;display:flex;flex-direction:column;gap:1rem;">

                    <!-- Article info card -->
                    <div style="background:white;border-radius:18px;padding:1.3rem 1.4rem;
                        box-shadow:0 4px 20px rgba(47,50,125,.07);">
                        <div style="font-size:.68rem;font-weight:800;color:#9ca3af;
                            text-transform:uppercase;letter-spacing:.5px;margin-bottom:.9rem;">
                            <i class="fas fa-info-circle me-1" style="color:var(--secondary);"></i>
                            About this Article
                        </div>
                        <div style="font-size:.8rem;color:#374151;line-height:2.1;">
                            <i class="fas fa-calendar me-2" style="color:var(--secondary);width:16px;"></i>
                            @Model.CreatedAt.ToString("MMMM dd, yyyy")<br />
                            @if (Model.UpdatedAt.HasValue)
                            {
                                <span>
                                    <i class="fas fa-edit me-2" style="color:var(--purple);width:16px;"></i>
                                    Updated @Model.UpdatedAt.Value.ToString("MMM dd, yyyy")<br />
                                </span>
                            }
                            <i class="fas fa-circle me-2" style="color:#16a34a;font-size:.45rem;vertical-align:middle;width:16px;"></i>
                            Status: <span style="color:#16a34a;font-weight:700;">Published</span>
                        </div>
                    </div>

                    <!-- Related articles -->
                    @if (related.Any())
                    {
                        <div style="background:white;border-radius:18px;padding:1.3rem 1.4rem;
                            box-shadow:0 4px 20px rgba(47,50,125,.07);">
                            <div style="font-size:.68rem;font-weight:800;color:#9ca3af;
                                text-transform:uppercase;letter-spacing:.5px;margin-bottom:1rem;">
                                <i class="fas fa-newspaper me-1" style="color:var(--secondary);"></i>
                                More Articles
                            </div>
                            <div style="display:flex;flex-direction:column;gap:.85rem;">
                                @foreach (var r in related)
                                {
                                    <a asp-controller="Home" asp-action="Article" asp-route-id="@r.Id"
                                       style="display:flex;gap:.85rem;align-items:flex-start;text-decoration:none;
                                        padding:.75rem;border-radius:12px;background:#f8f9ff;
                                        transition:background .2s,transform .2s;"
                                       onmouseover="this.style.background='rgba(0,203,184,.08)';this.style.transform='translateX(3px)'"
                                       onmouseout="this.style.background='#f8f9ff';this.style.transform=''">
                                        <!-- Thumb -->
                                        @if (!string.IsNullOrEmpty(r.CoverImage))
                                        {
                                            <img src="/@r.CoverImage" alt="@r.Title"
                                                 style="width:64px;height:64px;border-radius:10px;
                                            object-fit:cover;flex-shrink:0;" />
                                        }
                                        else
                                        {
                                            <div style="width:64px;height:64px;border-radius:10px;flex-shrink:0;
                                                background:@Grad(r.Id);display:flex;
                                                align-items:center;justify-content:center;">
                                                <i class="fas @Ico(r.Id)" style="color:rgba(255,255,255,.8);font-size:1.2rem;"></i>
                                            </div>
                                        }
                                        <!-- Info -->
                                        <div style="flex:1;min-width:0;">
                                            <div style="font-size:.8rem;font-weight:700;color:var(--primary);
                                                line-height:1.4;overflow:hidden;display:-webkit-box;
                                                -webkit-line-clamp:2;-webkit-box-orient:vertical;">
                                                @r.Title
                                            </div>
                                            <div style="font-size:.7rem;color:#9ca3af;margin-top:.3rem;">
                                                <i class="fas fa-calendar me-1"></i>
                                                @r.CreatedAt.ToString("MMM dd, yyyy")
                                            </div>
                                        </div>
                                    </a>
                                }
                            </div>

                            <a asp-controller="Home" asp-action="Blog"
                               style="display:flex;align-items:center;justify-content:center;gap:.5rem;
                                margin-top:1rem;padding:.65rem;border-radius:11px;
                                background:rgba(47,50,125,.07);color:var(--primary);
                                font-size:.8rem;font-weight:700;text-decoration:none;
                                transition:background .2s;"
                               onmouseover="this.style.background='rgba(47,50,125,.14)'"
                               onmouseout="this.style.background='rgba(47,50,125,.07)'">
                                <i class="fas fa-th-large"></i> View all articles
                            </a>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>
