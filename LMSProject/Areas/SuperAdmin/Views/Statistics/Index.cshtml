@model LMSProject.Areas.SuperAdmin.ViewModels.StatisticsVM
@{
    var months = "[\"Jan\",\"Feb\",\"Mar\",\"Apr\",\"May\",\"Jun\",\"Jul\",\"Aug\",\"Sep\",\"Oct\",\"Nov\",\"Dec\"]";
    var regData = "[" + string.Join(",", Model.MonthlyRegistrations) + "]";
    var tktData = "[" + string.Join(",", Model.MonthlyTickets) + "]";
    var breakdownLabels = "[" + string.Join(",", Model.UserBreakdown.Select(b => $"\"{b.Label}\"")) + "]";
    var breakdownValues = "[" + string.Join(",", Model.UserBreakdown.Select(b => b.Value)) + "]";
    var breakdownColors = "[" + string.Join(",", Model.UserBreakdown.Select(b => $"\"{b.Color}\"")) + "]";
}

<!-- KPI row -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><div class="sa-stat-card grad-1"><p>Total Users</p><h3>@(Model.TotalStudents + Model.TotalTeachers + Model.TotalParents + Model.TotalAdmins)</h3><i class="fas fa-users stat-icon"></i></div></div>
    <div class="col-6 col-xl-3"><div class="sa-stat-card grad-2"><p>Active Courses</p><h3>@Model.ActiveCourses / @Model.TotalCourses</h3><i class="fas fa-book-open stat-icon"></i></div></div>
    <div class="col-6 col-xl-3"><div class="sa-stat-card grad-3"><p>Ticket Resolution</p><h3>@(Model.TotalTickets > 0 ? Math.Round((double)Model.ResolvedTickets / Model.TotalTickets * 100) : 0)%</h3><i class="fas fa-headset stat-icon"></i></div></div>
    <div class="col-6 col-xl-3"><div class="sa-stat-card grad-4"><p>Uptime</p><h3>@Model.SystemUptime%</h3><i class="fas fa-server stat-icon"></i></div></div>
</div>

<div class="row g-4 mb-4">

    <!-- Monthly Registrations Line Chart -->
    <div class="col-lg-8">
        <div class="sa-card h-100">
            <div class="sa-card-header">
                <h5><i class="fas fa-chart-line me-2" style="color:var(--secondary);"></i>Monthly User Registrations</h5>
                <span class="sa-badge" style="background:rgba(0,203,184,0.1);color:var(--secondary);">This Year</span>
            </div>
            <div class="sa-card-body">
                <div class="sa-chart-wrap">
                    <canvas id="registrationChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- User Breakdown Doughnut -->
    <div class="col-lg-4">
        <div class="sa-card h-100">
            <div class="sa-card-header">
                <h5><i class="fas fa-chart-pie me-2" style="color:var(--accent-purple);"></i>User Breakdown</h5>
            </div>
            <div class="sa-card-body">
                <div class="sa-chart-wrap" style="height:200px;">
                    <canvas id="breakdownChart"></canvas>
                </div>
                <div class="mt-3 d-flex flex-column gap-2">
                    @foreach (var b in Model.UserBreakdown)
                    {
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:10px;height:10px;border-radius:50%;background:@b.Color;flex-shrink:0;"></div>
                                <small style="font-weight:600;">@b.Label</small>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <small style="color:#9ca3af;">@b.Value</small>
                                <div style="width:80px;height:5px;background:rgba(0,0,0,0.06);border-radius:10px;overflow:hidden;">
                                    <div style="height:100%;width:@(Model.TotalStudents + Model.TotalTeachers + Model.TotalParents + Model.TotalAdmins > 0 ? (int)((double)b.Value / (Model.TotalStudents + Model.TotalTeachers + Model.TotalParents + Model.TotalAdmins) * 100) : 0)%;background:@b.Color;border-radius:10px;"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">

    <!-- Tickets trend -->
    <div class="col-lg-6">
        <div class="sa-card h-100">
            <div class="sa-card-header">
                <h5><i class="fas fa-chart-bar me-2" style="color:var(--accent-blue);"></i>Monthly Ticket Volume</h5>
            </div>
            <div class="sa-card-body">
                <div class="sa-chart-wrap">
                    <canvas id="ticketChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Courses -->
    <div class="col-lg-6">
        <div class="sa-card h-100">
            <div class="sa-card-header">
                <h5><i class="fas fa-trophy me-2" style="color:var(--orange);"></i>Top Enrolled Courses</h5>
            </div>
            <div class="sa-card-body">
                @{
                    int maxEnroll = Model.TopCourses.Any() ? Model.TopCourses.Max(c => c.Value) : 1;
                    var barColors = new[] { "var(--accent-purple)", "var(--accent-blue)", "var(--secondary)", "var(--accent-green)", "var(--orange)" };
                }
                <div class="d-flex flex-column gap-3 mt-1">
                    @for (int i = 0; i < Model.TopCourses.Count; i++)
                    {
                        var course = Model.TopCourses[i];
                        var pct = (int)((double)course.Value / maxEnroll * 100);
                        <div>
                            <div class="d-flex justify-content-between mb-1">
                                <small style="font-weight:600;font-size:0.8rem;">@course.Label</small>
                                <small style="font-weight:700;color:@barColors[i % barColors.Length];">@course.Value students</small>
                            </div>
                            <div style="height:8px;background:rgba(0,0,0,0.05);border-radius:10px;overflow:hidden;">
                                <div style="height:100%;width:@pct%;background:@barColors[i % barColors.Length];border-radius:10px;transition:width 1s ease;"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const chartDefaults = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } }
        };
        const primaryColor = '#2F327D';
        const secondaryColor = '#00CBB8';

        // Registration line chart
        new Chart(document.getElementById('registrationChart'), {
            type: 'line',
            data: {
                labels: @Html.Raw(months),
                datasets: [{
                    label: 'New Users',
                    data: @Html.Raw(regData),
                    borderColor: secondaryColor,
                    backgroundColor: 'rgba(0,203,184,0.08)',
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: secondaryColor,
                    pointRadius: 5,
                    pointHoverRadius: 7
                }]
            },
            options: { ...chartDefaults, plugins: { legend: { display: true, labels: { font: { family: 'Poppins' } } } },
                scales: { y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.04)' } }, x: { grid: { display: false } } } }
        });

        // Breakdown doughnut
        new Chart(document.getElementById('breakdownChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(breakdownLabels),
                datasets: [{ data: @Html.Raw(breakdownValues), backgroundColor: @Html.Raw(breakdownColors), borderWidth: 0 }]
            },
            options: { responsive: true, maintainAspectRatio: false, cutout: '70%',
                plugins: { legend: { display: false } } }
        });

        // Ticket bar chart
        new Chart(document.getElementById('ticketChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(months),
                datasets: [{
                    label: 'Tickets',
                    data: @Html.Raw(tktData),
                    backgroundColor: 'rgba(91,114,238,0.7)',
                    borderRadius: 8,
                    borderSkipped: false
                }]
            },
            options: { ...chartDefaults, plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.04)' } }, x: { grid: { display: false } } } }
        });
    </script>
}
