@model LMSProject.Areas.SuperAdmin.ViewModels.CreateUserVM

<div class="modal fade" id="createUserModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="sa-modal-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0"><i class="fas fa-user-plus me-2"></i>Create New @Model.Role Account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-area="SuperAdmin" asp-controller="Users" asp-action="CreateUser" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Role" value="@Model.Role" />
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Full Name <span class="text-danger">*</span></label>
                            <input name="FullName" class="form-control sa-form-control" placeholder="e.g. Ahmed Hassan" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email Address <span class="text-danger">*</span></label>
                            <input name="Email" type="email" class="form-control sa-form-control" placeholder="e.g. ahmed@school.edu" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Password <span class="text-danger">*</span></label>
                            <input name="Password" type="password" class="form-control sa-form-control" placeholder="Min. 6 characters" required minlength="6" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone Number</label>
                            <input name="Phone" class="form-control sa-form-control" placeholder="e.g. 01012345678" />
                        </div>

                        @if (Model.Role == "Student")
                        {
                            <div class="col-md-6">
                                <label class="form-label">Grade</label>
                                <select name="Grade" class="form-select sa-form-control">
                                    <option value="">Select Grade</option>
                                    <option>Grade 10</option>
                                    <option>Grade 11</option>
                                    <option>Grade 12</option>
                                </select>
                            </div>
                        }
                        @if (Model.Role == "Teacher")
                        {
                            <div class="col-md-6">
                                <label class="form-label">Subject</label>
                                <select name="Subject" class="form-select sa-form-control">
                                    <option value="">Select Subject</option>
                                    <option>Mathematics</option>
                                    <option>Physics</option>
                                    <option>Chemistry</option>
                                    <option>Biology</option>
                                    <option>English</option>
                                    <option>History</option>
                                    <option>Geography</option>
                                    <option>Arabic</option>
                                </select>
                            </div>
                        }
                        @if (Model.Role == "Admin")
                        {
                            <div class="col-md-6">
                                <label class="form-label">Department</label>
                                <select name="Department" class="form-select sa-form-control">
                                    <option value="">Select Department</option>
                                    <option>IT</option>
                                    <option>HR</option>
                                    <option>Academic</option>
                                    <option>Finance</option>
                                    <option>Operations</option>
                                </select>
                            </div>
                        }
                    </div>

                    <!-- Info box -->
                    <div class="mt-3 p-3 rounded-3" style="background:rgba(0,203,184,0.06);border-left:3px solid var(--secondary);">
                        <small style="color:#6c757d;font-size:0.8rem;">
                            <i class="fas fa-info-circle me-1" style="color:var(--secondary);"></i>
                            The user will receive login credentials and can change their password on first login. The account will be assigned the <strong>@Model.Role</strong> role automatically.
                        </small>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4 pt-0">
                    <button type="button" class="btn btn-secondary rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4">
                        <i class="fas fa-user-plus me-2"></i>Create Account
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
