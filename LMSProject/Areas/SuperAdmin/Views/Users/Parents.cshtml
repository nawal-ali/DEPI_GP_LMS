<style>
    @@keyframes _fsu {
        from {
            opacity: 0;
            transform: translateY(20px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    .stat-anim {
        animation: _fsu .4s ease both
    }

        .stat-anim:nth-child(1) {
            animation-delay: .00s
        }

        .stat-anim:nth-child(2) {
            animation-delay: .08s
        }

        .stat-anim:nth-child(3) {
            animation-delay: .16s
        }

        .stat-anim:nth-child(4) {
            animation-delay: .24s
        }

    .row-anim {
        animation: _fsu .35s ease both
    }

        .row-anim:nth-child(1) {
            animation-delay: .05s
        }

        .row-anim:nth-child(2) {
            animation-delay: .10s
        }

        .row-anim:nth-child(3) {
            animation-delay: .15s
        }

        .row-anim:nth-child(4) {
            animation-delay: .20s
        }

        .row-anim:nth-child(5) {
            animation-delay: .25s
        }

        .row-anim:nth-child(6) {
            animation-delay: .30s
        }

        .row-anim:nth-child(7) {
            animation-delay: .35s
        }
</style>
@model LMSProject.Areas.SuperAdmin.ViewModels.ParentListVM
@{
    var statuses = new[] { "Active", "Inactive" };
    var occupations = new[] { "Engineer", "Doctor", "Accountant", "Teacher", "Business", "Nurse", "Other" };
    var childCounts = new[] { "1", "2", "3", "4+" };
    int ps = Model.PageSize;
    var page = Model.CurrentPage;
    var paged = Model.Filtered.Skip((page - 1) * ps).Take(ps).ToList();
}

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3 stat-anim">
        <div class="sa-stat-card grad-1"><p>Total Parents</p><h3>@Model.TotalParents</h3><i class="fas fa-users stat-icon"></i></div>
    </div>
    <div class="col-6 col-md-3 stat-anim">
        <div class="sa-stat-card grad-2"><p>Total Children</p><h3>@Model.TotalChildren</h3><i class="fas fa-child stat-icon"></i></div>
    </div>
    <div class="col-6 col-md-3 stat-anim">
        <div class="sa-stat-card grad-3"><p>Active Contacts</p><h3>@Model.ActiveContacts</h3><i class="fas fa-phone stat-icon"></i></div>
    </div>
    <div class="col-6 col-md-3 stat-anim">
        <div class="sa-stat-card grad-4"><p>Avg Children</p><h3>@(Model.TotalParents > 0 ? Math.Round((double)Model.TotalChildren / Model.TotalParents, 1) : 0)</h3><i class="fas fa-star stat-icon"></i></div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 style="font-weight:700;color:var(--primary);margin:0;">
        <i class="fas fa-users me-2" style="color:var(--secondary);"></i>Parents
        <span class="sa-badge" style="background:rgba(51,239,160,0.15);color:#16a34a;margin-left:8px;">@Model.Filtered.Count</span>
    </h5>
    <button class="btn btn-sm btn-primary rounded-3 px-3" data-bs-toggle="modal" data-bs-target="#createUserModal">
        <i class="fas fa-plus me-1"></i> Add Parent
    </button>
</div>

<form method="get" asp-action="Parents">
    <div class="sa-filters mb-4">
        <div class="search-wrap flex-grow-1">
            <i class="fas fa-search"></i>
            <input name="search" class="form-control" placeholder="Search parents…" value="@Model.SearchTerm" />
        </div>
        <select name="status" class="form-select" style="width:auto;" onchange="this.form.submit()">
            <option value="">All Statuses</option>
            @foreach (var s in statuses)
            {
                <option value="@s" selected="@(Model.SelectedStatus == s ? "selected" : null)">@s</option>
            }
        </select>
        <select name="occ" class="form-select" style="width:auto;" onchange="this.form.submit()">
            <option value="">All Occupations</option>
            @foreach (var o in occupations)
            {
                <option value="@o" selected="@(Model.SelectedOccupation == o ? "selected" : null)">@o</option>
            }
        </select>
        <select name="children" class="form-select" style="width:auto;" onchange="this.form.submit()">
            <option value="">Children Count</option>
            @foreach (var c in childCounts)
            {
                <option value="@c" selected="@(Model.SelectedChildren == c ? "selected" : null)">@c</option>
            }
        </select>
        <button type="submit" class="btn btn-sm" style="background:var(--secondary);color:white;border-radius:10px;padding:0 1rem;"><i class="fas fa-filter"></i></button>
        <a asp-action="Parents" class="btn btn-sm btn-secondary-sa"><i class="fas fa-times"></i></a>
    </div>
</form>

<div class="sa-card">
    <div class="table-responsive">
        <table class="sa-table">
            <thead>
                <tr><th>Parent</th><th>Email</th><th>Phone</th><th>Occupation</th><th>Children</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var p in paged)
                {
                    <tr class="row-anim">
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--accent-green),var(--secondary));display:flex;align-items:center;justify-content:center;color:white;font-size:0.75rem;font-weight:700;flex-shrink:0;">@p.Initials</div>
                                <span style="font-weight:600;font-size:0.875rem;">@p.Name</span>
                            </div>
                        </td>
                        <td style="font-size:0.82rem;color:#6c757d;">@p.Email</td>
                        <td style="font-size:0.82rem;">@p.Phone</td>
                        <td><span class="sa-badge" style="background:rgba(244,140,6,0.1);color:var(--orange);">@p.Occupation</span></td>
                        <td><span style="font-weight:700;color:var(--primary);">@p.ChildrenCount</span></td>
                        <td>
                            @if (p.Status == "Active")
                            {
                                <span class="sa-badge sa-badge-active">Active</span>
                            }
                            else
                            {

                                <span class="sa-badge sa-badge-inactive">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-area="SuperAdmin" asp-controller="Users" asp-action="ViewProfile"
                                   asp-route-id="@p.Id" asp-route-role="Parent"
                                   class="sa-btn-icon sa-btn-view" title="View Profile"><i class="fas fa-eye"></i></a>
                                <a asp-area="SuperAdmin" asp-controller="Users" asp-action="EditParent" asp-route-id="@p.ParentDbId" class="sa-btn-icon sa-btn-edit" title="Edit Parent"><i class="fas fa-edit"></i></a>
                                <a asp-area="Admin" asp-controller="Users" asp-action="EditParent" asp-route-id="@p.ParentDbId" class="sa-btn-icon" title="Link Children" style="background:rgba(0,203,184,.12);color:var(--secondary);"><i class="fas fa-link"></i></a>
                                <form asp-area="SuperAdmin" asp-controller="Users" asp-action="DeleteUser" method="post" style="display:inline;" id="deleteForm_@p.ParentDbId">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <input type="hidden" name="role" value="Parent" />
                                    <button type="button" class="sa-btn-icon sa-btn-delete" title="Delete"
                                            data-bs-toggle="modal" data-bs-target="#deleteModal"
                                            data-delete-name="@p.Name" data-form-id="deleteForm_@p.ParentDbId">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!paged.Any())
                {
                    <tr><td colspan="7" class="text-center py-5" style="color:#aaa;"><i class="fas fa-search fa-2x mb-2 d-block opacity-25"></i>No parents found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@await Html.PartialAsync("_DeleteModal")
@await Html.PartialAsync("_CreateUserModal", new LMSProject.Areas.SuperAdmin.ViewModels.CreateUserVM { Role = "Parent" })
@section Scripts {

    <script>
        (function(){var dm=document.getElementById('deleteModal');if(!dm)return;
        dm.addEventListener('show.bs.modal',function(e){
          var btn=e.relatedTarget;if(!btn)return;
          var el=document.getElementById('deleteItemName');if(el)el.textContent=btn.dataset.deleteName||'this user';
          var cb=document.getElementById('deleteConfirmBtn');
          if(cb&&btn.dataset.formId){cb.onclick=function(ev){ev.preventDefault();document.getElementById(btn.dataset.formId).submit();};cb.href='#';}
        });})();
    </script>
}
