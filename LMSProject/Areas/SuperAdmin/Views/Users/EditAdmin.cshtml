@using MLSCore.IdentityModel
@model ApplicationUser
@{
    ViewData["Title"] = "Edit Admin";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="sa-card anim">
            <div class="sa-modal-header" style="border-radius:16px 16px 0 0;">
                <h5 style="color:white;font-weight:700;margin:0;">
                    <i class="fas fa-user-edit me-2"></i>Edit Admin — @Model.FullName
                </h5>
            </div>
            <div class="sa-card-body">
                <form asp-area="SuperAdmin" asp-controller="Users"
                      asp-action="EditAdmin" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" value="@Model.Id" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" style="font-weight:600;font-size:.84rem;">
                                Full Name <span class="text-danger">*</span>
                            </label>
                            <input name="fullName" value="@Model.FullName"
                                   class="sa-form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" style="font-weight:600;font-size:.84rem;">
                                Phone
                            </label>
                            <input name="phone" value="@Model.PhoneNumber"
                                   class="sa-form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" style="font-weight:600;font-size:.84rem;">Email</label>
                            <input value="@Model.Email" class="sa-form-control" disabled
                                   style="background:rgba(0,0,0,.03);" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" style="font-weight:600;font-size:.84rem;">Role</label>
                            <input value="Admin" class="sa-form-control" disabled
                                   style="background:rgba(0,0,0,.03);" />
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <a asp-area="SuperAdmin" asp-controller="Users" asp-action="Admins"
                           class="btn rounded-3 flex-grow-1"
                           style="background:rgba(47,50,125,.07);color:var(--primary);font-family:Poppins,sans-serif;">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-primary rounded-3 flex-grow-1"
                                style="font-family:Poppins,sans-serif;">
                            <i class="fas fa-save me-2"></i>Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
