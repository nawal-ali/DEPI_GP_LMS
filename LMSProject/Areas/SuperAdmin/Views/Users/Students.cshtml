@model LMSProject.Areas.SuperAdmin.ViewModels.StudentListVM
@{
    var grades = new[] { "Grade 10", "Grade 11", "Grade 12" };
    var statuses = new[] { "Active", "Inactive", "Pending" };
    var sections = new[] { "A", "B", "C", "D" };
    int ps = Model.PageSize;
    var page = Model.CurrentPage;
    var paged = Model.Filtered.Skip((page - 1) * ps).Take(ps).ToList();
}

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="sa-stat-card grad-1"><p>Total Students</p><h3>@Model.TotalStudents</h3><i class="fas fa-user-graduate stat-icon"></i></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="sa-stat-card grad-2"><p>Active</p><h3>@Model.ActiveStudents</h3><i class="fas fa-check-circle stat-icon"></i></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="sa-stat-card grad-3"><p>Graduating</p><h3>@Model.GraduatingStudents</h3><i class="fas fa-graduation-cap stat-icon"></i></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="sa-stat-card grad-4"><p>Linked to Parents</p><h3>@Model.StudentsWithParents</h3><i class="fas fa-users stat-icon"></i></div>
    </div>
</div>

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 style="font-weight:700;color:var(--primary);margin:0;">
        <i class="fas fa-user-graduate me-2" style="color:var(--secondary);"></i>Students
        <span class="sa-badge" style="background:rgba(91,114,238,0.1);color:var(--accent-purple);margin-left:8px;">@Model.Filtered.Count</span>
    </h5>
    <button class="btn btn-sm btn-primary rounded-3 px-3" data-bs-toggle="modal" data-bs-target="#createUserModal">
        <i class="fas fa-plus me-1"></i> Add Student
    </button>
</div>

<!-- Filters -->
<form method="get" asp-action="Students">
    <div class="sa-filters mb-4">
        <div class="search-wrap flex-grow-1">
            <i class="fas fa-search"></i>
            <input name="search" class="form-control" placeholder="Search students…" value="@Model.SearchTerm" />
        </div>
        <select name="grade" class="form-select" style="width:auto;" onchange="this.form.submit()">
            <option value="">All Grades</option>
            @foreach (var g in grades)
            {
                <option value="@g" selected="@(Model.SelectedGrade == g ? "selected" : null)">@g</option>
            }
        </select>
        <select name="status" class="form-select" style="width:auto;" onchange="this.form.submit()">
            <option value="">All Statuses</option>
            @foreach (var s in statuses)
            {
                <option value="@s" selected="@(Model.SelectedStatus == s ? "selected" : null)">@s</option>
            }
        </select>
        <select name="section" class="form-select" style="width:auto;" onchange="this.form.submit()">
            <option value="">All Sections</option>
            @foreach (var s in sections)
            {
                <option value="@s" selected="@(Model.SelectedSection == s ? "selected" : null)">Section @s</option>
            }
        </select>
        <button type="submit" class="btn btn-sm" style="background:var(--secondary);color:white;border-radius:10px;padding:0 1rem;">
            <i class="fas fa-filter"></i>
        </button>
        <a asp-action="Students" class="btn btn-sm btn-secondary-sa"><i class="fas fa-times"></i></a>
    </div>
</form>

<!-- Table -->
<div class="sa-card">
    <div class="table-responsive">
        <table class="sa-table">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Grade</th>
                    <th>Section</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Parent</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in paged)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--accent-purple),var(--accent-blue));display:flex;align-items:center;justify-content:center;color:white;font-size:0.75rem;font-weight:700;flex-shrink:0;">
                                    @s.Initials
                                </div>
                                <span style="font-weight:600;font-size:0.875rem;">@s.Name</span>
                            </div>
                        </td>
                        <td>@s.Grade</td>
                        <td><span class="sa-badge" style="background:rgba(41,185,231,0.1);color:var(--accent-blue);">@s.Section</span></td>
                        <td style="font-size:0.82rem;color:#6c757d;">@s.Email</td>
                        <td style="font-size:0.82rem;">@s.Phone</td>
                        <td>
                            @if (s.Status == "Active")
                            {
                                <span class="sa-badge sa-badge-active">Active</span>
                            }
                            else if (s.Status == "Inactive")
                            {

                                <span class="sa-badge sa-badge-inactive">Inactive</span>
                            }
                            else
                            {

                                <span class="sa-badge sa-badge-pending">@s.Status</span>
                            }
                        </td>
                        <td>
                            @if (s.ParentId != null)
                            {
                                <a asp-area="SuperAdmin" asp-controller="Users" asp-action="ViewProfile"
                                       asp-route-id="@s.ParentId" asp-route-role="Parent"
                                       class="sa-btn-icon" style="background:rgba(51,239,160,0.12);color:#16a34a;" title="View Parent">
                                    <i class="fas fa-user-friends"></i>
                                </a>
                            }
                            else
                            {

                                <span style="font-size:0.75rem;color:#aaa;">None</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-area="SuperAdmin" asp-controller="Users" asp-action="ViewProfile"
                                       asp-route-id="@s.Id" asp-route-role="Student"
                                       class="sa-btn-icon sa-btn-view" title="View Profile">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <button class="sa-btn-icon sa-btn-edit" title="Edit" onclick="alert('Wire to Edit action')">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <form asp-area="SuperAdmin" asp-controller="Users" asp-action="DeleteUser" method="post" style="display:inline;"
                                      onsubmit="return confirm('Delete @s.Name?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <input type="hidden" name="role" value="Student" />
                                    <button type="submit" class="sa-btn-icon sa-btn-delete" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!paged.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5" style="color:#aaa;font-size:0.9rem;">
                            <i class="fas fa-search fa-2x mb-2 d-block opacity-25"></i>No students found matching your filters.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <div class="sa-pagination">
        <a asp-action="Students" asp-route-page="@(page - 1)" asp-route-search="@Model.SearchTerm" asp-route-grade="@Model.SelectedGrade" asp-route-status="@Model.SelectedStatus" asp-route-section="@Model.SelectedSection"
           class="sa-page-btn @(page == 1 ? "disabled" : "")"><i class="fas fa-chevron-left"></i></a>
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a asp-action="Students" asp-route-page="@i" asp-route-search="@Model.SearchTerm" asp-route-grade="@Model.SelectedGrade" asp-route-status="@Model.SelectedStatus" asp-route-section="@Model.SelectedSection"
               class="sa-page-btn @(i == page ? "active" : "")">@i</a>
        }
        <a asp-action="Students" asp-route-page="@(page + 1)" asp-route-search="@Model.SearchTerm" asp-route-grade="@Model.SelectedGrade" asp-route-status="@Model.SelectedStatus" asp-route-section="@Model.SelectedSection"
           class="sa-page-btn @(page == Model.TotalPages ? "disabled" : "")"><i class="fas fa-chevron-right"></i></a>
    </div>
}

<!-- Create User Modal -->
@await Html.PartialAsync("_CreateUserModal", new LMSProject.Areas.SuperAdmin.ViewModels.CreateUserVM { Role = "Student" })
