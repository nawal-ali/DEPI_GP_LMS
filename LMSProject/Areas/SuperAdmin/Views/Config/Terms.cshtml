@using MLSCore.Models

@model IEnumerable<TbTerm>
@{
    ViewData["Title"] = "Terms";
    var items = Model.ToList();
    var gradients = (string[])ViewBag.Gradients;
    int gi = 0;
}
<style>
    @@keyframes fadeSlideUp {
        from {
            opacity: 0;
            transform: translateY(24px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    .cfg-card {
        animation: fadeSlideUp .4s ease
    }

    .cfg-row {
        animation: fadeSlideUp .35s ease both
    }

        .cfg-row:nth-child(1) {
            animation-delay: .00s
        }

        .cfg-row:nth-child(2) {
            animation-delay: .05s
        }

        .cfg-row:nth-child(3) {
            animation-delay: .10s
        }

        .cfg-row:nth-child(4) {
            animation-delay: .15s
        }

        .cfg-row:nth-child(5) {
            animation-delay: .20s
        }

        .cfg-row:nth-child(6) {
            animation-delay: .25s
        }

        .cfg-row:nth-child(7) {
            animation-delay: .30s
        }

        .cfg-row:nth-child(8) {
            animation-delay: .35s
        }

    .cfg-letter {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.1rem;
        color: white;
        text-transform: uppercase
    }

    .sa-form-control {
        border-radius: 10px;
        border: 1.5px solid rgba(47,50,125,.14);
        padding: .55rem .9rem;
        font-size: .875rem;
        width: 100%;
        transition: border-color .15s,box-shadow .15s;
        outline: none
    }

        .sa-form-control:focus {
            border-color: var(--secondary);
            box-shadow: 0 0 0 3px rgba(0,203,184,.15)
        }
</style>
<div class="d-flex justify-content-between align-items-center mb-4 cfg-card">
    <h5 style="font-weight:700;color:var(--primary);margin:0;">
        <i class="fas fa-calendar-alt me-2" style="color:var(--secondary);"></i>Terms
        <span class="sa-badge sa-badge-info ms-2">@items.Count</span>
    </h5>
    <button class="btn btn-primary btn-sm rounded-3 px-3" data-bs-toggle="modal" data-bs-target="#addModal">
        <i class="fas fa-plus me-1"></i> Add Term
    </button>
</div>
@if (!items.Any())
{
    <div class="sa-card p-5 text-center cfg-card" style="color:#aaa;">
        <i class="fas fa-calendar-alt fa-3x mb-3 d-block opacity-25"></i>
        <p class="mb-0">No terms yet.</p>
    </div>
}
else
{
    <div class="sa-card cfg-card">
        <div class="table-responsive">
            <table class="sa-table">
                <thead>
                    <tr>
                        <th style="width:56px;"></th>
                        <th>Term Name</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        var letter = string.IsNullOrEmpty(item.Name) ? "?" : item.Name[0].ToString();
                        var gradient = gradients[gi++ % gradients.Length];
                        <tr class="cfg-row">
                            <td><div class="cfg-letter" style="background:@gradient;">@letter</div></td>
                            <td style="font-weight:600;font-size:.9rem;">@item.Name</td>

                            <td>
                                @if (item.CurrentState == 1)
                                {
                                    <span class="sa-badge sa-badge-active">Active</span>
                                }
                                else
                                {

                                    <span class="sa-badge sa-badge-inactive">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <button type="button" class="sa-btn-icon sa-btn-edit" title="Edit"
                                            data-bs-toggle="modal" data-bs-target="#editModal"
                                            data-id="@item.Id" data-name="@item.Name">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button type="button" class="sa-btn-icon sa-btn-delete" title="Delete"
                                            data-bs-toggle="modal" data-bs-target="#deleteModal"
                                            data-delete-url="/SuperAdmin/Config/DeleteTerm?id=@item.Id"
                                            data-delete-name="@item.Name">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
<!-- Add Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:440px;">
        <div class="modal-content" style="border-radius:18px;border:none;box-shadow:0 20px 60px rgba(0,0,0,.15);">
            <div style="background:linear-gradient(135deg,var(--primary),var(--accent-purple));border-radius:18px 18px 0 0;padding:1.2rem 1.5rem;display:flex;align-items:center;justify-content:space-between;">
                <h5 style="color:white;font-weight:700;margin:0;font-size:1rem;"><i class="fas fa-calendar-alt me-2"></i>Add Term</h5>
                <button class="btn-close" data-bs-dismiss="modal" style="filter:brightness(0) invert(1);"></button>
            </div>
            <form asp-area="SuperAdmin" asp-controller="Config" asp-action="CreateTerm" method="post">
                @Html.AntiForgeryToken()
                <div style="padding:1.5rem;">

                    <div class="mb-3">
                        <label class="form-label" style="font-weight:600;font-size:.84rem;">Term Name <span class="text-danger">*</span></label>
                        <input name="name" class="sa-form-control" placeholder="Enter name…" required />
                    </div>
                </div>
                <div style="padding:.5rem 1.5rem 1.3rem;display:flex;gap:.75rem;justify-content:flex-end;border-top:1px solid rgba(0,0,0,.05);">
                    <button type="button" class="btn btn-sm btn-secondary rounded-3 px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary rounded-3 px-4"><i class="fas fa-plus me-1"></i>Create</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:440px;">
        <div class="modal-content" style="border-radius:18px;border:none;box-shadow:0 20px 60px rgba(0,0,0,.15);">
            <div style="background:linear-gradient(135deg,var(--accent-purple),var(--secondary));border-radius:18px 18px 0 0;padding:1.2rem 1.5rem;display:flex;align-items:center;justify-content:space-between;">
                <h5 style="color:white;font-weight:700;margin:0;font-size:1rem;"><i class="fas fa-edit me-2"></i>Edit Term</h5>
                <button class="btn-close" data-bs-dismiss="modal" style="filter:brightness(0) invert(1);"></button>
            </div>
            <form asp-area="SuperAdmin" asp-controller="Config" asp-action="EditTerm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editId" />
                <div style="padding:1.5rem;">

                    <div class="mb-3">
                        <label class="form-label" style="font-weight:600;font-size:.84rem;">Term Name <span class="text-danger">*</span></label>
                        <input name="name" id="editName" class="sa-form-control" required />
                    </div>
                </div>
                <div style="padding:.5rem 1.5rem 1.3rem;display:flex;gap:.75rem;justify-content:flex-end;border-top:1px solid rgba(0,0,0,.05);">
                    <button type="button" class="btn btn-sm btn-secondary rounded-3 px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary rounded-3 px-4"><i class="fas fa-save me-1"></i>Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
@await Html.PartialAsync("_DeleteModal")
@section Scripts {
    <script>
        var em = document.getElementById('editModal');
        if(em) em.addEventListener('show.bs.modal', function(e) {
            var b = e.relatedTarget;
            document.getElementById('editId').value   = b.dataset.id;
            document.getElementById('editName').value = b.dataset.name;

        });
    </script>
}
