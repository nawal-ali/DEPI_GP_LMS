@inject MLSEF.AppDbContext Db
@using Microsoft.EntityFrameworkCore
@{
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var routeGradeId = ViewContext.RouteData.Values["gradeId"]?.ToString();

    string Active(string ctrl, string? act = null) =>
        (current == ctrl && (act == null || action == act)) ? "active" : "";

    // ── Load Stage → Grade tree (no filtered include — compatible with all EF versions) ──
    var stages = await Db.Stages
        .Where(s => s.CurrentState == 1)
        .Include(s => s.Grades)
        .OrderBy(s => s.Name)
        .ToListAsync();

    bool isSchedules = current == "Schedules";
}

<style>
    .sch-stage-wrap {
        border-radius: 10px;
        margin-bottom: .3rem;
    }

    .sch-stage-btn {
        display: flex;
        align-items: center;
        gap: .6rem;
        width: 100%;
        padding: .45rem .85rem;
        border: none;
        background: transparent;
        color: #374151;
        font-family: Poppins,sans-serif;
        font-size: .82rem;
        font-weight: 600;
        cursor: pointer;
        border-radius: 10px;
        text-align: left;
        transition: background .15s,color .15s;
    }

        .sch-stage-btn:hover {
            background: rgba(91,114,238,.08);
            color: var(--primary);
        }

        .sch-stage-btn[aria-expanded="true"] {
            background: rgba(91,114,238,.08);
            color: var(--primary);
        }

            .sch-stage-btn[aria-expanded="true"] .sch-chevron {
                transform: rotate(90deg);
                color: var(--primary);
            }

    .sch-chevron {
        margin-left: auto;
        font-size: .6rem;
        color: #9ca3af;
        transition: transform .25s;
    }

    .sch-grades {
        display: none;
        padding-left: .5rem;
    }

        .sch-grades.open {
            display: block;
        }

    .sch-grade-lnk {
        display: flex;
        align-items: center;
        gap: .5rem;
        padding: .33rem .75rem .33rem 1.1rem;
        border-radius: 8px;
        font-size: .79rem;
        color: #6b7280;
        font-weight: 500;
        text-decoration: none;
        transition: background .15s,color .15s;
        position: relative;
    }

        .sch-grade-lnk::before {
            content: '';
            position: absolute;
            left: .35rem;
            top: 50%;
            transform: translateY(-50%);
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: #d1d5db;
            transition: background .15s;
        }

        .sch-grade-lnk:hover {
            background: rgba(0,203,184,.1);
            color: var(--secondary);
        }

            .sch-grade-lnk:hover::before {
                background: var(--secondary);
            }

        .sch-grade-lnk.active {
            background: rgba(0,203,184,.12);
            color: var(--secondary);
            font-weight: 700;
        }

            .sch-grade-lnk.active::before {
                background: var(--secondary);
            }

    .sch-all-lnk {
        display: flex;
        align-items: center;
        gap: .6rem;
        padding: .45rem .85rem;
        border-radius: 10px;
        font-size: .82rem;
        color: #374151;
        font-weight: 600;
        text-decoration: none;
        margin-bottom: .25rem;
        transition: background .15s,color .15s;
    }

        .sch-all-lnk:hover, .sch-all-lnk.active {
            background: rgba(91,114,238,.08);
            color: var(--primary);
        }
</style>

@* ── Script defined BEFORE buttons use it ──────────────────────── *@
<script>
    (function () {
        // Use relative DOM traversal — no IDs — so double-render is safe
        function toggleStage(btn) {
            var panel = btn.nextElementSibling;
            if (!panel || !panel.classList.contains('sch-grades')) return;
            var isOpen = panel.classList.contains('open');
            panel.classList.toggle('open', !isOpen);
            btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
        }
        // Expose globally
        window.toggleStage = toggleStage;
    })();
</script>

<!-- Profile -->
<p class="sa-group-label mt-3">Profile</p>
<div>
    <a asp-area="SuperAdmin" asp-controller="Profile" asp-action="Index"
       class="sa-nav-item @Active("Profile", "Index")">
        <i class="fas fa-user-shield"></i><span>My Profile</span>
    </a>
    <a asp-area="SuperAdmin" asp-controller="Profile" asp-action="Edit"
       class="sa-nav-item @Active("Profile", "Edit")">
        <i class="fas fa-cog"></i><span>Profile Settings</span>
