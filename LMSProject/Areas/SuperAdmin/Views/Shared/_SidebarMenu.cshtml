<!-- ── Schedules — dynamic Stage → Grade tree ───────────────────── -->
<p class="sa-group-label mt-3">Schedules</p>
<div>
    <a asp-area="SuperAdmin" asp-controller="Schedules" asp-action="Index"
       class="sch-all-lnk @(isSchedules && action == "Index" ? "active" : "")">
        <i class="fas fa-calendar-week" style="width:16px;text-align:center;color:var(--secondary);"></i>
        <span>All Schedules</span>
    </a>

    @if (!stages.Any())
    {
        <div style="padding:.4rem .85rem;font-size:.75rem;color:#9ca3af;">
            <i class="fas fa-info-circle me-1"></i>No stages configured
        </div>
    }
    else
    {
        @foreach (var stage in stages)
        {
            var grades = stage.Grades?.Where(g => g.CurrentState == 1).OrderBy(g => g.Name).ToList()
                            ?? new List<MLSCore.Models.TbGrade>();
            var hasActive = grades.Any(g => g.Id.ToString() == routeGradeId);

            <div class="sch-stage-wrap">
                @* button triggers toggleStage(this) — no IDs needed *@
                <button type="button"
                        class="sch-stage-btn"
                        aria-expanded="@(hasActive ? "true" : "false")"
                        onclick="toggleStage(this)">
                    <i class="fas fa-layer-group"
                       style="width:16px;text-align:center;color:var(--accent-purple);font-size:.78rem;"></i>
                    <span>@stage.Name</span>
                    <i class="fas fa-chevron-right sch-chevron"></i>
                </button>

                <div class="sch-grades @(hasActive ? "open" : "")">
                    @if (!grades.Any())
                    {
                        <span class="sch-grade-lnk" style="cursor:default;opacity:.45;">No grades</span>
                    }
                    else
                    {
                        @foreach (var grade in grades)
                        {
                            var active = grade.Id.ToString() == routeGradeId && isSchedules;
                            <a asp-area="SuperAdmin"
                               asp-controller="Schedules"
                               asp-action="GradeSchedule"
                               asp-route-gradeId="@grade.Id"
                               class="sch-grade-lnk @(active ? "active" : "")">
                                @grade.Name
                            </a>
                        }
                    }
                </div>
            </div>
        }
    }
</div>

