@model LMSProject.Areas.SuperAdmin.ViewModels.SuperAdminProfileVM

<div class="row g-4">
    <!-- Left sidebar -->
    <div class="col-lg-4">
        <div class="sa-card" style="overflow:visible;">
            <div class="sa-profile-cover" style="border-radius:16px 16px 0 0;">
                <div class="sa-profile-avatar-wrap">
                    <div class="sa-profile-avatar-initials" style="background:linear-gradient(135deg,var(--primary),var(--secondary));">
                        @Model.Initials
                    </div>
                </div>
            </div>
            <div style="padding:60px 1.5rem 1.5rem;">
                <h4 style="font-weight:700;margin:0;">@Model.FullName</h4>
                <span class="sa-badge mt-1 d-inline-block" style="background:linear-gradient(135deg,var(--primary),var(--secondary));color:white;padding:4px 14px;">
                    <i class="fas fa-crown me-1"></i>Super Admin
                </span>
                <div class="mt-3 d-flex flex-column gap-2">
                    <div style="display:flex;align-items:center;gap:8px;font-size:0.83rem;color:#6c757d;">
                        <i class="fas fa-envelope" style="width:16px;color:var(--secondary);"></i>@Model.Email
                    </div>
                    <div style="display:flex;align-items:center;gap:8px;font-size:0.83rem;color:#6c757d;">
                        <i class="fas fa-phone" style="width:16px;color:var(--secondary);"></i>@Model.Phone
                    </div>
                    <div style="display:flex;align-items:center;gap:8px;font-size:0.83rem;color:#6c757d;">
                        <i class="fas fa-map-marker-alt" style="width:16px;color:var(--secondary);"></i>@Model.Address
                    </div>
                </div>
                <div class="mt-3 pt-3" style="border-top:1px solid rgba(0,0,0,0.06);">
                    <div class="d-flex justify-content-between align-items-center">
                        <small style="color:#9ca3af;">Status</small>
                        <span class="sa-badge sa-badge-active">@Model.Status</span>
                    </div>
                </div>
                <a asp-area="SuperAdmin" asp-controller="Profile" asp-action="Edit"
                       class="btn btn-primary w-100 mt-3 rounded-3" style="font-size:0.85rem;">
                    <i class="fas fa-edit me-2"></i>Edit Profile
                </a>
            </div>
        </div>
    </div>

    <!-- Right content -->
    <div class="col-lg-8">
        <!-- Bio -->
        @if (!string.IsNullOrEmpty(Model.Bio))
        {
            <div class="sa-card mb-4">
                <div class="sa-card-header">
                    <h5><i class="fas fa-id-card me-2" style="color:var(--secondary);"></i>About Me</h5>
                </div>
                <div class="sa-card-body">
                    <p style="line-height:1.8;color:#555;margin:0;">@Model.Bio</p>
                </div>
            </div>
        }

        <!-- Info cards grid -->
        <div class="row g-3 mb-4">
            @{
                var infoCards = new[]
                {
                    ("fas fa-shield-alt", "linear-gradient(135deg,var(--primary),var(--secondary))",       "Access Level",  Model.AccessLevel),
                    ("fas fa-calendar",   "linear-gradient(135deg,var(--accent-blue),var(--accent-purple))","Joined Date",  Model.JoinedDate.ToString("MMMM yyyy")),
                    ("fas fa-clock",      "linear-gradient(135deg,var(--accent-green),var(--accent-blue))", "Last Login",   "Today, " + DateTime.Now.ToString("hh:mm tt")),
                    ("fas fa-server",     "linear-gradient(135deg,var(--accent-purple),var(--accent-pink))","System Role",  "Platform Owner"),
                };
            }
            @foreach (var (icon, grad, label, val) in infoCards)
            {
                <div class="col-md-6">
                    <div class="p-3 rounded-3 d-flex align-items-center gap-3" style="background:white;box-shadow:0 2px 10px rgba(47,50,125,0.06);">
                        <div style="width:44px;height:44px;border-radius:12px;background:@grad;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <i class="fas @icon text-white"></i>
                        </div>
                        <div>
                            <small style="color:#9ca3af;font-size:0.73rem;display:block;">@label</small>
                            <span style="font-weight:600;font-size:0.875rem;">@val</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- System Permissions -->
        <div class="sa-card">
            <div class="sa-card-header" style="background:linear-gradient(135deg,var(--primary),var(--secondary));border-radius:16px 16px 0 0;">
                <h5 style="color:white;"><i class="fas fa-key me-2"></i>System Permissions</h5>
            </div>
            <div class="sa-card-body">
                @{
                    var perms = new[] { "Manage all users", "Create/delete accounts", "Send system-wide announcements",
                                        "View & respond to all support tickets", "Access system statistics", "Configure platform settings" };
                }
                <div class="row g-2">
                    @foreach (var perm in perms)
                    {
                        <div class="col-md-6">
                            <div class="d-flex align-items-center gap-2" style="font-size:0.85rem;">
                                <i class="fas fa-check-circle" style="color:var(--secondary);flex-shrink:0;"></i>
                                @perm
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
