@model MLSCore.Models.TbCourse
@{
    ViewData["Title"] = "Manage Sessions — " + Model.Name;
    Layout = "~/Areas/SuperAdmin/Views/Shared/_SuperAdminLayout.cshtml";
    string[] Days = { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };
    string[] Colors = { "#5B72EE", "#00CBB8", "#E13468", "#F48C06", "#29B9E7", "#9b59b6", "#16a34a", "#2F327D" };
}

<div class="row g-4 anim">

    <!-- Course Info -->
    <div class="col-12">
        <div class="sa-card" style="overflow:hidden;">
            <div style="background:linear-gradient(135deg,var(--primary),#5B72EE);padding:1.1rem 1.5rem;display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
                <a asp-action="Index" style="color:rgba(255,255,255,.7);text-decoration:none;font-size:.85rem;">
                    <i class="fas fa-arrow-left me-1"></i>All Schedules
                </a>
                <div style="width:1px;height:20px;background:rgba(255,255,255,.2);"></div>
                <h5 style="color:white;font-weight:800;margin:0;font-size:1rem;">@Model.Name</h5>
                <div style="margin-left:auto;display:flex;gap:.6rem;flex-wrap:wrap;">
                    <span style="background:rgba(255,255,255,.15);color:white;border-radius:20px;padding:3px 12px;font-size:.72rem;">
                        <i class="fas fa-layer-group me-1"></i>@Model.Grade?.Stage?.Name — @Model.Grade?.Name
                    </span>
                    <span style="background:rgba(255,255,255,.15);color:white;border-radius:20px;padding:3px 12px;font-size:.72rem;">
                        <i class="fas fa-calendar me-1"></i>@Model.Term?.Name
                    </span>
                    <span style="background:rgba(0,203,184,.25);color:white;border-radius:20px;padding:3px 12px;font-size:.72rem;">
                        <i class="fas fa-chalkboard-teacher me-1"></i>@Model.Instructor?.FullName
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Session Form -->
    <div class="col-lg-4">
        <div class="sa-card">
            <div class="sa-card-header">
                <i class="fas fa-plus me-2" style="color:var(--secondary);"></i>Add Session
            </div>
            <div class="sa-card-body">
                <form asp-action="AddSession" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="courseId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="sa-label">Day of Week</label>
                        <select name="dayOfWeek" class="sa-form-control" required>
                            @for (int i = 0; i < 7; i++)
                            {
                                <option value="@i">@Days[i]</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="sa-label">Start Time</label>
                            <input type="time" name="startTime" step="60"
                                   style="display:block;width:100%;padding:.45rem .75rem;border:1.5px solid rgba(47,50,125,.15);border-radius:10px;font-family:Poppins,sans-serif;font-size:.87rem;color:#374151;background:#fff;outline:none;" required />
                        </div>
                        <div class="col-6">
                            <label class="sa-label">End Time</label>
                            <input type="time" name="endTime" step="60"
                                   style="display:block;width:100%;padding:.45rem .75rem;border:1.5px solid rgba(47,50,125,.15);border-radius:10px;font-family:Poppins,sans-serif;font-size:.87rem;color:#374151;background:#fff;outline:none;" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="sa-label">Zoom Meeting Link <span style="color:#9ca3af;">(optional)</span></label>
                        <input type="url" name="meetingLink" class="sa-form-control" placeholder="https://zoom.us/j/..." />
                    </div>
                    <div class="mb-3">
                        <label class="sa-label">Session Color</label>
                        <div class="d-flex gap-2 flex-wrap">
                            @foreach (var col in Colors)
                            {
                                <label style="cursor:pointer;">
                                    <input type="radio" name="color" value="@col" style="display:none;" class="color-radio" />
                                    <div class="color-swatch" style="width:26px;height:26px;border-radius:50%;background:@col;border:3px solid transparent;transition:border .15s;"
                                         onclick="selectColor(this,'@col')"></div>
                                </label>
                            }
                        </div>
                        <input type="hidden" id="selectedColorInput" name="color" value="@Colors[0]" />
                    </div>
                    <div class="mb-3">
                        <label class="sa-label">Notes <span style="color:#9ca3af;">(optional)</span></label>
                        <textarea name="notes" class="sa-form-control" rows="2" placeholder="e.g. Bring textbook"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-3" style="font-family:Poppins,sans-serif;">
                        <i class="fas fa-plus me-2"></i>Add Session
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Sessions List -->
    <div class="col-lg-8">
        <div class="sa-card">
            <div class="sa-card-header">
                <i class="fas fa-calendar-week me-2" style="color:var(--secondary);"></i>
                Scheduled Sessions
                <span style="background:rgba(91,114,238,.1);color:var(--accent-purple);border-radius:20px;padding:2px 10px;font-size:.72rem;font-weight:700;margin-left:.5rem;">
                    @(Model.ScheduleSessions?.Count ?? 0)
                </span>
            </div>
            <div class="sa-card-body">
                @if (Model.ScheduleSessions == null || !Model.ScheduleSessions.Any())
                {
                    <div style="text-align:center;padding:2.5rem;color:#9ca3af;">
                        <i class="fas fa-calendar-plus d-block mb-2" style="font-size:2rem;opacity:.25;"></i>
                        No sessions yet — add one on the left.
                    </div>
                }
                else
                {
                    @foreach (var s in Model.ScheduleSessions.OrderBy(s => s.DayOfWeek).ThenBy(s => s.StartTime))
                    {
                        <div style="display:flex;align-items:center;gap:.85rem;padding:.75rem .9rem;border-radius:12px;background:#f8f9ff;border:1.5px solid rgba(47,50,125,.06);margin-bottom:.6rem;">
                            <div style="width:10px;height:48px;border-radius:6px;background:@s.Color;flex-shrink:0;"></div>
                            <div style="flex:1;min-width:0;">
                                <div style="font-weight:700;font-size:.85rem;color:var(--primary);">@Days[s.DayOfWeek]</div>
                                <div style="font-size:.78rem;color:#374151;">
                                    <i class="fas fa-clock me-1" style="color:var(--secondary);"></i>
                                    @s.StartTime.ToString(@"hh\:mm") – @s.EndTime.ToString(@"hh\:mm")
                                    <span style="color:#9ca3af;margin-left:.5rem;">
                                        (@((int)(s.EndTime - s.StartTime).TotalMinutes) min)
                                    </span>
                                </div>
                                @if (!string.IsNullOrEmpty(s.MeetingLink))
                                {
                                    <div style="font-size:.72rem;margin-top:.2rem;">
                                        <a href="@s.MeetingLink" target="_blank" style="color:var(--secondary);font-weight:600;">
                                            <i class="fas fa-video me-1"></i>Meeting link
                                        </a>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(s.Notes))
                                {
                                    <div style="font-size:.72rem;color:#9ca3af;margin-top:.15rem;">@s.Notes</div>
                                }
                            </div>
                            <!-- Edit -->
                            <button type="button" class="btn btn-sm rounded-3"
                                    style="background:rgba(91,114,238,.1);color:var(--accent-purple);font-size:.72rem;font-family:Poppins,sans-serif;"
                                    onclick="openEdit(@s.Id,@s.DayOfWeek,'@s.StartTime.ToString(@"hh\:mm")','@s.EndTime.ToString(@"hh\:mm")','@Html.Raw((s.MeetingLink ?? string.Empty).Replace("'", "\\'"))','@s.Color','@Html.Raw((s.Notes ?? string.Empty).Replace("'", "\\'"))')">
                                <i class="fas fa-edit me-1"></i>Edit
                            </button>
                            <!-- Delete -->
                            <form asp-action="DeleteSession" method="post" style="margin:0;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.Id" />
                                <button type="submit" class="btn btn-sm rounded-3"
                                        style="background:rgba(225,52,104,.08);color:#E13468;font-size:.72rem;font-family:Poppins,sans-serif;"
                                        onclick="return confirm('Remove this session?')">
                                    <i class="fas fa-trash me-1"></i>Remove
                                </button>
                            </form>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
        <div class="modal-content" style="border-radius:18px;border:none;overflow:hidden;">
            <div style="background:linear-gradient(135deg,var(--secondary),var(--accent-blue));padding:1.1rem 1.4rem;display:flex;align-items:center;gap:.75rem;">
                <h6 style="color:white;font-weight:700;margin:0;">Edit Session</h6>
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="modal"></button>
            </div>
            <div style="padding:1.4rem;">
                <form asp-action="EditSession" method="post" id="editForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="editId" />
                    <div class="mb-3">
                        <label class="sa-label">Day</label>
                        <select name="dayOfWeek" id="editDay" class="sa-form-control">
                            @for (int i = 0; i < 7; i++)
                            {
                                <option value="@i">@Days[i]</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6"><label class="sa-label">Start</label><input type="time" name="startTime" id="editStart" step="60" style="display:block;width:100%;padding:.45rem .75rem;border:1.5px solid rgba(47,50,125,.15);border-radius:10px;font-family:Poppins,sans-serif;font-size:.87rem;color:#374151;background:#fff;outline:none;" /></div>
                        <div class="col-6"><label class="sa-label">End</label><input type="time" name="endTime" id="editEnd" step="60" style="display:block;width:100%;padding:.45rem .75rem;border:1.5px solid rgba(47,50,125,.15);border-radius:10px;font-family:Poppins,sans-serif;font-size:.87rem;color:#374151;background:#fff;outline:none;" /></div>
                    </div>
                    <div class="mb-3"><label class="sa-label">Meeting Link</label><input type="url" name="meetingLink" id="editLink" class="sa-form-control" /></div>
                    <div class="mb-3"><label class="sa-label">Notes</label><textarea name="notes" id="editNotes" class="sa-form-control" rows="2"></textarea></div>
                    <input type="hidden" name="color" id="editColor" />
                    <div class="d-flex gap-2">
                        <button type="button" class="btn rounded-3 flex-grow-1" data-bs-dismiss="modal" style="background:rgba(47,50,125,.07);color:var(--primary);font-family:Poppins,sans-serif;">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-3 flex-grow-1" style="font-family:Poppins,sans-serif;"><i class="fas fa-save me-2"></i>Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function selectColor(el, color) {
            document.querySelectorAll('.color-swatch').forEach(function(s){ s.style.borderColor='transparent'; });
            el.style.borderColor = '#374151';
            document.getElementById('selectedColorInput').value = color;
        }
        // Pre-select first color
        document.addEventListener('DOMContentLoaded', function(){
            var first = document.querySelector('.color-swatch');
            if(first) first.style.borderColor='#374151';
        });

        function openEdit(id, day, start, end, link, color, notes) {
            document.getElementById('editId').value    = id;
            document.getElementById('editDay').value   = day;
            document.getElementById('editStart').value = start;
            document.getElementById('editEnd').value   = end;
            document.getElementById('editLink').value  = link;
            document.getElementById('editColor').value = color;
            document.getElementById('editNotes').value = notes;
            new bootstrap.Modal(document.getElementById('editModal')).show();
        }
    </script>
}
