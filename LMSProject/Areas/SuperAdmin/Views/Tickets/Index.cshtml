@model LMSProject.Areas.SuperAdmin.ViewModels.TicketListVM
@{
    var statuses = new[] { "Open", "In Progress", "Resolved", "Closed" };
    var priorities = new[] { "Urgent", "High", "Normal", "Low" };
    var categories = new[] { "Technical", "Academic", "Financial", "Administrative" };
    int ps = Model.PageSize;
    var page = Model.CurrentPage;
    var paged = Model.Filtered.Skip((page - 1) * ps).Take(ps).ToList();

    string PriorityColor(string p) => p switch
    {
        "Urgent" => "var(--accent-pink)",
        "High" => "var(--orange)",
        "Normal" => "var(--accent-blue)",
        _ => "var(--accent-green)"
    };
    string StatusColor(string s) => s switch
    {
        "Open" => "var(--accent-pink)",
        "In Progress" => "var(--orange)",
        "Resolved" => "var(--accent-green)",
        _ => "#6c757d"
    };
}

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="sa-stat-card grad-1"><p>Total Tickets</p><h3>@Model.TotalTickets</h3><i class="fas fa-headset stat-icon"></i></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="sa-stat-card grad-6"><p>Open</p><h3>@Model.OpenTickets</h3><i class="fas fa-envelope-open stat-icon"></i></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="sa-stat-card grad-2"><p>Resolved</p><h3>@Model.ResolvedTickets</h3><i class="fas fa-check-circle stat-icon"></i></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="sa-stat-card grad-3"><p>Urgent</p><h3>@Model.UrgentTickets</h3><i class="fas fa-exclamation-triangle stat-icon"></i></div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 style="font-weight:700;color:var(--primary);margin:0;">
        <i class="fas fa-headset me-2" style="color:var(--secondary);"></i>Support Tickets
    </h5>
</div>

<!-- Filters -->
<form method="get" asp-action="Index">
    <div class="sa-filters mb-4">
        <div class="search-wrap flex-grow-1">
            <i class="fas fa-search"></i>
            <input name="search" class="form-control" placeholder="Search tickets…" value="@Model.SearchTerm" />
        </div>
        <select name="status" class="form-select" style="width:auto;" onchange="this.form.submit()">
            <option value="">All Statuses</option>
            @foreach (var s in statuses)
            {
                <option value="@s" selected="@(Model.SelectedStatus == s ? "selected" : null)">@s</option>
            }
        </select>
        <select name="priority" class="form-select" style="width:auto;" onchange="this.form.submit()">
            <option value="">All Priorities</option>
            @foreach (var p in priorities)
            {
                <option value="@p" selected="@(Model.SelectedPriority == p ? "selected" : null)">@p</option>
            }
        </select>
        <select name="category" class="form-select" style="width:auto;" onchange="this.form.submit()">
            <option value="">All Categories</option>
            @foreach (var c in categories)
            {
                <option value="@c" selected="@(Model.SelectedCategory == c ? "selected" : null)">@c</option>
            }
        </select>
        <button type="submit" class="btn btn-sm" style="background:var(--secondary);color:white;border-radius:10px;padding:0 1rem;"><i class="fas fa-filter"></i></button>
        <a asp-action="Index" class="btn btn-sm btn-secondary-sa"><i class="fas fa-times"></i></a>
    </div>
</form>

<!-- Table -->
<div class="sa-card">
    <div class="table-responsive">
        <table class="sa-table">
            <thead>
                <tr><th>Ticket ID</th><th>Subject</th><th>Requester</th><th>Category</th><th>Priority</th><th>Status</th><th>Created</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var t in paged)
                {
                    <tr class="@(t.Status == "Open" ? "sa-ticket-row-open" : t.Status == "Resolved" ? "sa-ticket-row-resolved" : t.Status == "In Progress" ? "sa-ticket-row-pending" : "")">
                        <td><code style="background:rgba(47,50,125,0.07);padding:3px 8px;border-radius:6px;font-size:0.8rem;">#T-@(t.Id.ToString("D3"))</code></td>
                        <td>
                            <div style="max-width:200px;">
                                <div style="font-weight:600;font-size:0.875rem;">@t.Subject</div>
                                <small style="color:#9ca3af;font-size:0.75rem;">@(t.Description.Length > 55 ? t.Description.Substring(0, 55) + "…" : t.Description)</small>
                            </div>
                        </td>
                        <td>
                            <div style="font-weight:600;font-size:0.83rem;">@t.RequesterName</div>
                            <small style="color:#9ca3af;font-size:0.73rem;">@t.RequesterEmail</small>
                        </td>
                        <td><span class="sa-badge" style="background:rgba(47,50,125,0.08);color:var(--primary);">@t.Category</span></td>
                        <td><span class="sa-badge" style="background:@PriorityColor(t.Priority)18;color:@PriorityColor(t.Priority);">@t.Priority</span></td>
                        <td><span class="sa-badge" style="background:@StatusColor(t.Status)18;color:@StatusColor(t.Status);">@t.Status</span></td>
                        <td style="font-size:0.78rem;color:#9ca3af;white-space:nowrap;">@t.CreatedDate.ToString("MMM dd")</td>
                        <td>
                            <div class="d-flex gap-1">
                                <button class="sa-btn-icon sa-btn-view" title="View" data-bs-toggle="modal"
                                        data-bs-target="#viewTicketModal"
                                        data-id="@t.Id"
                                        data-subject="@t.Subject"
                                        data-desc="@t.Description"
                                        data-requester="@t.RequesterName"
                                        data-priority="@t.Priority"
                                        data-response="@(t.Response ?? "")">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button class="sa-btn-icon" style="background:rgba(51,239,160,0.12);color:#16a34a;" title="Respond"
                                        data-bs-toggle="modal" data-bs-target="#respondModal"
                                        data-id="@t.Id" data-subject="@t.Subject" data-requester="@t.RequesterName" data-priority="@t.Priority" data-desc="@t.Description">
                                    <i class="fas fa-reply"></i>
                                </button>
                                <form asp-area="SuperAdmin" asp-controller="Tickets" asp-action="Close" method="post" style="display:inline;" onsubmit="return confirm('Close this ticket?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button type="submit" class="sa-btn-icon sa-btn-delete" title="Close"><i class="fas fa-times"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!paged.Any())
                {
                    <tr><td colspan="8" class="text-center py-5" style="color:#aaa;"><i class="fas fa-headset fa-2x mb-2 d-block opacity-25"></i>No tickets found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <div class="sa-pagination">
        <a asp-action="Index" asp-route-page="@(page - 1)" class="sa-page-btn @(page == 1 ? "disabled" : "")"><i class="fas fa-chevron-left"></i></a>
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a asp-action="Index" asp-route-page="@i" class="sa-page-btn @(i == page ? "active" : "")">@i</a>
        }
        <a asp-action="Index" asp-route-page="@(page + 1)" class="sa-page-btn @(page == Model.TotalPages ? "disabled" : "")"><i class="fas fa-chevron-right"></i></a>
    </div>
}

<!-- View Ticket Modal -->
<div class="modal fade" id="viewTicketModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="sa-modal-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0"><i class="fas fa-ticket-alt me-2"></i>Ticket Details</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <h6 id="vt-subject" style="font-weight:700;color:var(--primary);"></h6>
                <div class="p-3 rounded-3 mb-3" style="background:rgba(47,50,125,0.04);">
                    <p id="vt-desc" style="margin:0;color:#555;line-height:1.7;"></p>
                </div>
                <div class="row">
                    <div class="col-6"><small class="text-muted">Requester</small><p id="vt-requester" class="mb-0 fw-semibold"></p></div>
                    <div class="col-6"><small class="text-muted">Priority</small><p id="vt-priority" class="mb-0 fw-semibold"></p></div>
                </div>
                <div id="vt-response-block" class="mt-3 p-3 rounded-3" style="background:rgba(0,203,184,0.06);border-left:3px solid var(--secondary);display:none;">
                    <small class="text-muted">Admin Response</small>
                    <p id="vt-response" class="mb-0 mt-1" style="font-size:0.875rem;"></p>
                </div>
            </div>
            <div class="modal-footer border-0"><button class="btn btn-secondary rounded-3" data-bs-dismiss="modal">Close</button></div>
        </div>
    </div>
</div>

<!-- Respond Modal -->
<div class="modal fade" id="respondModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="sa-modal-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0"><i class="fas fa-reply me-2"></i>Respond to Ticket</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-area="SuperAdmin" asp-controller="Tickets" asp-action="Respond" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TicketId" id="respond-id" />
                <div class="modal-body p-4">
                    <div class="sa-card mb-3">
                        <div class="sa-card-body p-3">
                            <h6 id="respond-subject" style="font-weight:700;color:var(--primary);margin:0 0 6px;"></h6>
                            <p id="respond-desc" style="margin:0;font-size:0.83rem;color:#6c757d;"></p>
                            <div class="d-flex gap-3 mt-2">
                                <small><i class="fas fa-user me-1" style="color:var(--secondary);"></i><span id="respond-requester"></span></small>
                                <small><i class="fas fa-flag me-1" style="color:var(--orange);"></i><span id="respond-priority"></span></small>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Response <span class="text-danger">*</span></label>
                        <textarea name="Response" class="form-control sa-form-control" rows="5"
                                  placeholder="Type your response here…" required></textarea>
                    </div>
                    <div>
                        <label class="form-label">Update Status</label>
                        <select name="NewStatus" class="form-select sa-form-control">
                            <option value="Open">Keep Open</option>
                            <option value="In Progress" selected>In Progress</option>
                            <option value="Resolved">Resolved</option>
                            <option value="Closed">Closed</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4 pt-0">
                    <button type="button" class="btn btn-secondary rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4"><i class="fas fa-paper-plane me-2"></i>Send Response</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('viewTicketModal').addEventListener('show.bs.modal', function (e) {
            var b = e.relatedTarget;
            document.getElementById('vt-subject').textContent   = b.dataset.subject;
            document.getElementById('vt-desc').textContent      = b.dataset.desc;
            document.getElementById('vt-requester').textContent = b.dataset.requester;
            document.getElementById('vt-priority').textContent  = b.dataset.priority;
            var resp = b.dataset.response;
            var block = document.getElementById('vt-response-block');
            if (resp) { document.getElementById('vt-response').textContent = resp; block.style.display = ''; }
            else { block.style.display = 'none'; }
        });
        document.getElementById('respondModal').addEventListener('show.bs.modal', function (e) {
            var b = e.relatedTarget;
            document.getElementById('respond-id').value              = b.dataset.id;
            document.getElementById('respond-subject').textContent   = b.dataset.subject;
            document.getElementById('respond-desc').textContent      = b.dataset.desc;
            document.getElementById('respond-requester').textContent = b.dataset.requester;
            document.getElementById('respond-priority').textContent  = b.dataset.priority;
        });
    </script>
}
