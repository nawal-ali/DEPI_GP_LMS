<form method="get" asp-action="Index" class="mb-3 anim">
    <div class="d-flex gap-2 flex-wrap">
        <div style="position:relative;flex:1;min-width:180px;">
            <i class="fas fa-search" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#aaa;font-size:.82rem;"></i>
            <input name="search" class="sa-form-control" style="padding-left:2.2rem;" placeholder="Search courses…" value="@ViewBag.Search" />
        </div>
        <select name="grade" class="sa-form-control" style="width:auto;" onchange="this.form.submit()">
            <option value="">All Grades</option>
            @foreach (var g in (ViewBag.Grades as IEnumerable<dynamic> ?? new List<dynamic>()))
            {
                <option value="@g.Name" selected="@(ViewBag.Grade == g.Name ? "selected" : null)">@g.Name</option>
            }
        </select>
        <button type="submit" class="btn btn-primary rounded-3 px-4" style="font-family:Poppins,sans-serif;">Filter</button>
    </div>
</form>
@model List<LMSProject.Areas.Admin.ViewModels.CourseListVM>
@{
    ViewData["Title"] = "Course Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 style="font-weight:700;color:var(--primary);margin:0;">
        <i class="fas fa-book-open me-2" style="color:var(--secondary);"></i>Courses
        <span class="sa-badge sa-badge-info ms-2">@ViewBag.TotalCourses</span>
    </h5>
    <a asp-area="SuperAdmin" asp-controller="Courses" asp-action="Create"
       class="btn btn-primary btn-sm rounded-3 px-3">
        <i class="fas fa-plus me-1"></i> Create Course
    </a>
</div>

<form method="get" asp-action="Index">
    <div class="sa-filters">
        <div class="search-wrap">
            <i class="fas fa-search"></i>
            <input name="search" class="form-control" placeholder="Search courses…" value="@ViewBag.Search" />
        </div>
        <select name="grade" class="form-select" style="width:auto;" onchange="this.form.submit()">
            <option value="">All Grades</option>
            @foreach (var g in (List<string>)ViewBag.Grades)
            {
                <option value="@g" selected="@(ViewBag.Grade == g ? "selected" : null)">@g</option>
            }
        </select>
        <select name="status" class="form-select" style="width:auto;" onchange="this.form.submit()">
            <option value="">All Statuses</option>
            <option value="active" selected="@(ViewBag.Status == "active" ? "selected" : null)">Active</option>
            <option value="inactive" selected="@(ViewBag.Status == "inactive" ? "selected" : null)">Inactive</option>
        </select>
        <button type="submit" class="btn btn-sm btn-primary rounded-3 px-3"><i class="fas fa-filter me-1"></i>Filter</button>
        <a asp-action="Index" class="btn-secondary-sa btn btn-sm"><i class="fas fa-times me-1"></i>Clear</a>
    </div>
</form>

<div class="sa-card">
    <div class="table-responsive">
        <table class="sa-table">
            <thead><tr><th>Course</th><th>Instructor</th><th>Grade / Subject</th><th>Students</th><th>Materials</th><th>Exams</th><th>Assignments</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(c.ImageName))
                                {
                                    <img src="~/@c.ImageName" style="width:40px;height:40px;border-radius:9px;object-fit:cover;flex-shrink:0;" />
                                }
                                else
                                {

                                    <div style="width:40px;height:40px;border-radius:9px;background:linear-gradient(135deg,var(--accent-purple),var(--secondary));display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-book-open" style="color:rgba(255,255,255,0.6);font-size:0.9rem;"></i></div>
                                }
                                <div>
                                    <div style="font-weight:600;font-size:0.875rem;max-width:160px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@c.Name</div>
                                    <small style="color:#9ca3af;font-size:0.72rem;">@c.Term &nbsp;|&nbsp; @c.Price.ToString("C0")</small>
                                </div>
                            </div>
                        </td>
                        <td style="font-size:0.83rem;font-weight:500;">@c.InstructorName</td>
                        <td>
                            <div style="font-size:0.82rem;">@c.Grade</div>
                            <small style="color:#9ca3af;font-size:0.73rem;">@c.Subject</small>
                        </td>
                        <td><span class="sa-badge sa-badge-info">@c.StudentCount</span></td>
                        <td><span class="sa-badge sa-badge-purple">@c.MaterialCount</span></td>
                        <td><span class="sa-badge" style="background:rgba(41,185,231,0.12);color:var(--accent-blue);">@c.ExamCount</span></td>
                        <td><span class="sa-badge" style="background:rgba(244,140,6,0.12);color:var(--orange);">@c.AssignmentCount</span></td>
                        <td>
                            @if (c.CurrentState == 1)
                            {
                                <span class="sa-badge sa-badge-active">Active</span>
                            }
                            else
                            {

                                <span class="sa-badge sa-badge-inactive">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                <a asp-area="SuperAdmin" asp-controller="Courses" asp-action="Edit" asp-route-id="@c.Id"
                                   class="sa-btn-icon sa-btn-edit" title="Edit"><i class="fas fa-edit"></i></a>
                                <a asp-area="SuperAdmin" asp-controller="Courses" asp-action="AssignInstructor" asp-route-courseId="@c.Id"
                                   class="sa-btn-icon sa-btn-view" title="Assign Instructor" style="background:rgba(244,140,6,.12);color:var(--orange);"><i class="fas fa-user-tie"></i></a>
                                <a asp-area="SuperAdmin" asp-controller="Courses" asp-action="Enroll" asp-route-courseId="@c.Id"
                                   class="sa-btn-icon sa-btn-add" title="Enroll Students"><i class="fas fa-user-plus"></i></a>
                                <a asp-area="SuperAdmin" asp-controller="Monitor" asp-action="Materials" asp-route-courseId="@c.Id"
                                   class="sa-btn-icon sa-btn-view" title="Materials"><i class="fas fa-folder"></i></a>
                                <form asp-area="SuperAdmin" asp-controller="Courses" asp-action="Delete" method="post" style="display:inline;"
                                      onsubmit="return confirm('Deactivate course @c.Name?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <button type="submit" class="sa-btn-icon sa-btn-delete" title="Deactivate"><i class="fas fa-ban"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-center py-5 text-muted"><i class="fas fa-book fa-2x d-block mb-2 opacity-25"></i>No courses found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if ((int)ViewBag.TotalPages > 1)
{
    <div class="sa-pagination">
        @for (int p = 1; p <= (int)ViewBag.TotalPages; p++)
        {
            <a asp-action="Index" asp-route-page="@p" class="sa-page-btn @(p == (int)ViewBag.Page ? "active" : "")">@p</a>
        }
    </div>
}
