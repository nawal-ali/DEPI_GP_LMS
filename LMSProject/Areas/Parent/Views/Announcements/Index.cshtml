@model LMSProject.Areas.Parent.ViewModels.ParentAnnouncementVM
@{
    ViewData["Title"] = "Announcements";
    string PGrad(string? p) => p switch
    {
        "Urgent" => "linear-gradient(135deg,var(--accent-pink),var(--orange))",
        "High" => "linear-gradient(135deg,var(--orange),var(--yellow))",
        "Low" => "linear-gradient(135deg,var(--accent-green),var(--accent-blue))",
        _ => "linear-gradient(135deg,var(--primary),var(--secondary))"
    };
}

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="pa-stat g1"><p>Total</p><h3>@Model.TotalCount</h3><i class="fas fa-bullhorn si"></i></div></div>
    <div class="col-6 col-md-3"><div class="pa-stat g5"><p>Urgent</p><h3>@Model.UrgentCount</h3><i class="fas fa-exclamation-circle si"></i></div></div>
    <div class="col-6 col-md-3"><div class="pa-stat g4"><p>Pinned</p><h3>@Model.PinnedCount</h3><i class="fas fa-thumbtack si"></i></div></div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 style="font-weight:700;color:var(--primary);margin:0;">
        <i class="fas fa-bullhorn me-2" style="color:var(--secondary);"></i>Announcements
    </h5>
    <span class="pbadge pb-gray">View Only</span>
</div>

<form method="get" asp-action="Index">
    <div class="d-flex gap-2 flex-wrap mb-4">
        <div style="position:relative;flex:1;min-width:200px;">
            <i class="fas fa-search" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#aaa;font-size:.85rem;"></i>
            <input name="search" class="pa-control" style="padding-left:2.2rem;" placeholder="Search announcements…" value="@Model.SearchTerm" />
        </div>
        <select name="priority" class="pa-control" style="width:auto;" onchange="this.form.submit()">
            <option value="">All Priorities</option>
            @foreach (var p in new[] { "Urgent", "High", "Medium", "Low" })
            {
                <option value="@p" selected="@(Model.SelectedPriority == p ? "selected" : null)">@p</option>
            }
        </select>
        <button type="submit" class="btn btn-primary rounded-3 px-3 btn-sm"><i class="fas fa-filter me-1"></i>Filter</button>
        <a asp-action="Index" class="btn btn-sm rounded-3 px-3" style="background:rgba(0,0,0,.06);color:var(--text-dark);">Clear</a>
    </div>
</form>

@if (!Model.Paged.Any())
{
    <div class="pa-card p-5 text-center" style="color:#aaa;">
        <i class="fas fa-bullhorn fa-3x mb-3 d-block opacity-25"></i>No announcements for you right now.
    </div>
}

@foreach (var a in Model.Paged)
{
    <div class="pa-card mb-3" style="border-left:5px solid var(--secondary);transition:transform .2s;"
         onmouseover="this.style.transform='translateX(4px)'"
         onmouseout="this.style.transform='translateX(0)'">
        <div style="background:@PGrad(a.Priority);border-radius:11px 11px 0 0;padding:11px 17px;display:flex;align-items:flex-start;justify-content:space-between;gap:10px;">
            <div>
                <div class="d-flex align-items-center gap-2">
                    @if (a.IsPinned)
                    {
                        <i class="fas fa-thumbtack" style="color:rgba(255,255,255,.85);font-size:.78rem;"></i>
                    }
                    <h6 style="margin:0;color:white;font-weight:700;font-size:.92rem;">@a.Title</h6>
                </div>
                <small style="color:rgba(255,255,255,.75);font-size:.7rem;">
                    <i class="fas fa-calendar me-1"></i>@a.PublishedDate.ToString("MMM dd, yyyy")
                    @if (!string.IsNullOrEmpty(a.CreatedBy))
                    {
                        <span>&nbsp;|&nbsp;<i class="fas fa-user me-1"></i>@a.CreatedBy</span>
                    }
                </small>
            </div>
            <div class="d-flex gap-1 flex-shrink-0">
                <span style="background:rgba(255,255,255,.2);color:white;border-radius:20px;padding:2px 10px;font-size:.68rem;font-weight:600;">@(a.Priority ?? "Normal")</span>
                <span style="background:rgba(255,255,255,.2);color:white;border-radius:20px;padding:2px 10px;font-size:.68rem;font-weight:600;">@a.TargetAudience</span>
            </div>
        </div>
        <div style="padding:1rem 1.2rem;">
            <p style="margin:0;color:#444;font-size:.875rem;line-height:1.75;">@a.Content</p>
            @if (a.ExpiryDate.HasValue)
            {
                var dl = (a.ExpiryDate.Value - DateTime.Now).Days;
                <small style="color:@(dl <= 2 ? "var(--accent-pink)" : dl <= 7 ? "var(--orange)" : "#9ca3af");font-size:.73rem;font-weight:600;margin-top:.5rem;display:block;">
                    <i class="fas fa-clock me-1"></i>
                    @if (dl <= 0)
                    {
                        <text>Expires today</text>
                    }
                    else if (dl == 1)
                    {

                        <text>Expires tomorrow</text>
                    }
                    else
                    {

                        <text>Expires in @dl days</text>
                    }
                </small>
            }
        </div>
    </div>
}

@if (Model.TotalPages > 1)
{
    <div class="pa-pages mt-4">
        <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.SearchTerm"
           class="pa-page-btn @(Model.CurrentPage == 1 ? "disabled" : "")"><i class="fas fa-chevron-left"></i></a>
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a asp-action="Index" asp-route-page="@i" class="pa-page-btn @(i == Model.CurrentPage ? "active" : "")">@i</a>
        }
        <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.SearchTerm"
           class="pa-page-btn @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")"><i class="fas fa-chevron-right"></i></a>
    </div>
}
