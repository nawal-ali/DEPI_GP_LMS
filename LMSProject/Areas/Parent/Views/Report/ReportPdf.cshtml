@model LMSProject.Areas.Parent.ViewModels.WeeklyReportVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Weekly Report — @Model.ParentName — @Model.ReportDate.ToString("MMMM dd, yyyy")</title>
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Segoe UI', Arial, sans-serif;
                font-size: 13px;
                color: #222;
                background: white;
            }

            .report-header {
                background: linear-gradient(135deg,#2F327D,#5B72EE);
                color: white;
                padding: 24px 32px;
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
            }

                .report-header h1 {
                    font-size: 22px;
                    font-weight: 800;
                    margin-bottom: 4px;
                }

                .report-header p {
                    font-size: 12px;
                    opacity: .8;
                }

            .logo-badge {
                background: rgba(255,255,255,.15);
                border-radius: 12px;
                padding: 10px 18px;
                text-align: center;
            }

                .logo-badge strong {
                    display: block;
                    font-size: 14px;
                    font-weight: 800;
                }

                .logo-badge small {
                    font-size: 10px;
                    opacity: .8;
                }

            .container {
                padding: 24px 32px;
            }

            .child-block {
                border: 1px solid #e5e7eb;
                border-radius: 12px;
                margin-bottom: 24px;
                overflow: hidden;
                page-break-inside: avoid;
            }

            .child-header {
                background: #f8f9ff;
                border-bottom: 2px solid #2F327D;
                padding: 14px 20px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

                .child-header h2 {
                    font-size: 16px;
                    font-weight: 700;
                    color: #2F327D;
                }

                .child-header .grade {
                    background: #2F327D;
                    color: white;
                    border-radius: 20px;
                    padding: 2px 12px;
                    font-size: 11px;
                    font-weight: 600;
                }

            .child-body {
                padding: 18px 20px;
            }

            .summary-box {
                background: #f0fdf4;
                border-left: 4px solid #16a34a;
                padding: 10px 14px;
                border-radius: 0 8px 8px 0;
                margin-bottom: 18px;
            }

                .summary-box.warn {
                    background: #fffbeb;
                    border-color: #F48C06;
                }

                .summary-box.bad {
                    background: #fef2f2;
                    border-color: #E13468;
                }

                .summary-box p {
                    font-size: 12px;
                    color: #555;
                    margin: 0;
                }

            .stats-row {
                display: flex;
                gap: 12px;
                margin-bottom: 18px;
            }

            .stat-box {
                flex: 1;
                background: #f8f9ff;
                border-radius: 8px;
                padding: 12px;
                text-align: center;
            }

                .stat-box .val {
                    font-size: 20px;
                    font-weight: 800;
                    color: #2F327D;
                }

                .stat-box .lbl {
                    font-size: 10px;
                    color: #9ca3af;
                }

            .section-title {
                font-size: 12px;
                font-weight: 700;
                color: #2F327D;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                margin-bottom: 10px;
                padding-bottom: 4px;
                border-bottom: 1px solid #e5e7eb;
            }

            .cols {
                display: flex;
                gap: 20px;
            }

            .col {
                flex: 1;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 8px;
            }

            th {
                background: #2F327D;
                color: white;
                padding: 7px 10px;
                font-size: 11px;
                font-weight: 600;
                text-align: left;
            }

                th:first-child {
                    border-radius: 6px 0 0 6px;
                }

                th:last-child {
                    border-radius: 0 6px 6px 0;
                }

            td {
                padding: 7px 10px;
                font-size: 11px;
                border-bottom: 1px solid #f3f4f6;
                vertical-align: middle;
            }

            tr:last-child td {
                border-bottom: none;
            }

            .badge {
                display: inline-block;
                padding: 2px 8px;
                border-radius: 20px;
                font-size: 10px;
                font-weight: 600;
            }

            .bg-green {
                background: rgba(22,163,74,.12);
                color: #16a34a;
            }

            .bg-orange {
                background: rgba(244,140,6,.12);
                color: #F48C06;
            }

            .bg-red {
                background: rgba(225,52,104,.12);
                color: #E13468;
            }

            .bg-blue {
                background: rgba(41,185,231,.12);
                color: #29B9E7;
            }

            .progress-wrap {
                height: 6px;
                background: #f3f4f6;
                border-radius: 10px;
                overflow: hidden;
                margin-top: 3px;
            }

            .progress-bar {
                height: 100%;
                border-radius: 10px;
            }

            .footer {
                margin-top: 24px;
                padding: 14px 32px;
                border-top: 1px solid #e5e7eb;
                display: flex;
                justify-content: space-between;
                color: #9ca3af;
                font-size: 10px;
            }

            @@media print {
                body {
                    -webkit-print-color-adjust: exact;
                    print-color-adjust: exact;
                }

                .no-print {
                    display: none !important;
                }
            }
    </style>
</head>
<body>

    <!-- Print button (hidden when printing) -->
    <div class="no-print" style="padding:12px 24px;background:#f8f9ff;border-bottom:1px solid #e5e7eb;display:flex;justify-content:space-between;align-items:center;">
        <span style="font-size:13px;color:#2F327D;font-weight:600;"><i>Weekly Progress Report — print or save as PDF using Ctrl+P</i></span>
        <button onclick="window.print()" style="background:#2F327D;color:white;border:none;padding:8px 20px;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;">
            🖨 Print / Save PDF
        </button>
    </div>

    <!-- Report header -->
    <div class="report-header">
        <div>
            <h1>Weekly Progress Report</h1>
            <p>Parent: @Model.ParentName</p>
            <p>Week: @Model.WeekStart.ToString("MMMM dd") – @Model.WeekEnd.ToString("MMMM dd, yyyy")</p>
            <p>Generated: @Model.ReportDate.ToString("MMMM dd, yyyy hh:mm tt")</p>
        </div>
        <div class="logo-badge">
            <strong>TOTC LMS</strong>
            <small>Learning Management</small>
            <small>System</small>
        </div>
    </div>

    <div class="container">

        @foreach (var child in Model.Children)
        {
            var avg = child.OverallAvg;
            var perfColor = avg >= 85 ? "#16a34a" : avg >= 70 ? "#29B9E7" : avg >= 50 ? "#F48C06" : "#E13468";
            var perfLabel = avg >= 85 ? "Excellent" : avg >= 70 ? "Good" : avg >= 50 ? "Average" : "Needs Attention";
            var sumClass = avg >= 70 ? "" : avg >= 50 ? "warn" : "bad";

            <div class="child-block">
                <div class="child-header">
                    <div>
                        <h2>@child.FullName</h2>
                        <span class="grade">@child.Grade</span>
                    </div>
                    <div style="text-align:right;">
                        <div style="font-size:11px;color:#9ca3af;">Overall Performance</div>
                        <div style="font-size:22px;font-weight:800;color:@perfColor;">@avg%</div>
                        <span class="badge" style="background:@(perfColor)18;color:@perfColor;">@perfLabel</span>
                    </div>
                </div>

                <div class="child-body">
                    <!-- Quick stats -->
                    <div class="stats-row">
                        <div class="stat-box"><div class="val">@child.ExamResults.Count</div><div class="lbl">Exams Taken</div></div>
                        <div class="stat-box"><div class="val">@child.SubmittedThisWeek</div><div class="lbl">Submitted This Week</div></div>
                        <div class="stat-box"><div class="val" style="color:@(child.MissingWork > 0 ? "#E13468" : "#16a34a");">@child.MissingWork</div><div class="lbl">Missing Work</div></div>
                        <div class="stat-box"><div class="val">@child.Assignments.Count</div><div class="lbl">Total Assignments</div></div>
                    </div>

                    <!-- Performance summary -->
                    <div class="summary-box @sumClass">
                        <p><strong>Teacher's Note:</strong> @child.PerformanceSummary</p>
                    </div>

                    <div class="cols">
                        <!-- Exams -->
                        <div class="col">
                            <div class="section-title">📋 Exam Results</div>
                            @if (!child.ExamResults.Any())
                            {
                                <p style="font-size:11px;color:#9ca3af;">No exams taken this period.</p>
                            }
                            else
                            {
                                <table>
                                    <thead><tr><th>Exam</th><th>Score</th><th>%</th><th>Grade</th></tr></thead>
                                    <tbody>
                                        @foreach (var e in child.ExamResults)
                                        {
                                            double pct = e.TotalMarks > 0 ? e.Score / e.TotalMarks * 100 : 0;
                                            var gc = pct >= 70 ? "#16a34a" : pct >= 50 ? "#F48C06" : "#E13468";
                                            <tr>
                                                <td style="max-width:120px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@e.ExamTitle</td>
                                                <td>@e.Score / @e.TotalMarks</td>
                                                <td>
                                                    <div style="font-weight:700;color:@gc;font-size:11px;">@((int)pct)%</div>
                                                    <div class="progress-wrap" style="width:50px;"><div class="progress-bar" style="width:@((int)pct)%;background:@gc;"></div></div>
                                                </td>
                                                <td><span class="badge" style="background:@(gc)18;color:@gc;">@e.Grade</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>

                        <!-- Assignments -->
                        <div class="col">
                            <div class="section-title">📝 Assignments</div>
                            @if (!child.Assignments.Any())
                            {
                                <p style="font-size:11px;color:#9ca3af;">No assignments this period.</p>
                            }
                            else
                            {
                                <table>
                                    <thead><tr><th>Title</th><th>Deadline</th><th>Status</th></tr></thead>
                                    <tbody>
                                        @foreach (var a in child.Assignments)
                                        {
                                            var cls = a.IsSubmitted ? "bg-green" : (a.IsExpired ? "bg-red" : "bg-orange");
                                            var lbl = a.IsSubmitted ? (a.IsGraded ? $"{a.Score}/{a.TotalMarks}" : "Submitted") : (a.IsExpired ? "Missing" : "Pending");
                                            <tr>
                                                <td style="max-width:110px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@a.Title</td>
                                                <td>@a.Deadline.ToString("MMM dd")</td>
                                                <td><span class="badge @cls">@lbl</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>

    <div class="footer">
        <span>TOTC Learning Management System — Confidential Parent Report</span>
        <span>Generated on @Model.ReportDate.ToString("MMMM dd, yyyy")</span>
    </div>

</body>
</html>
