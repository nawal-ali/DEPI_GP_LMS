@model LMSProject.Areas.Parent.ViewModels.WeeklyReportVM
@{
    ViewData["Title"] = "Weekly Progress Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 style="font-weight:700;color:var(--primary);margin:0;">Weekly Progress Report</h5>
        <small style="color:#9ca3af;">
            Week of @Model.WeekStart.ToString("MMM dd") — @Model.WeekEnd.ToString("MMM dd, yyyy")
        </small>
    </div>
    <a asp-area="Parent" asp-controller="Report" asp-action="Download"
       target="_blank"
       class="btn btn-primary rounded-3 px-4">
        <i class="fas fa-file-pdf me-2"></i>Download PDF
    </a>
</div>

@foreach (var child in Model.Children)
{
    @* Declare variables with @{ } so Razor can access them in HTML below *@
    var perfColor = child.OverallAvg switch
    {
        >= 85 => "#16a34a",
        >= 70 => "#29B9E7",
        >= 50 => "#F48C06",
        _ => "#E13468"
    };
    var perfLabel = child.OverallAvg switch
    {
        >= 85 => "Excellent",
        >= 70 => "Good",
        >= 50 => "Average",
        _ => "Needs Attention"
    };

    <div class="pa-card mb-4">
        <!-- Child header -->
        <div style="background:linear-gradient(135deg,var(--primary),var(--accent-purple));padding:1.2rem 1.5rem;border-radius:16px 16px 0 0;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
            <div>
                <h5 style="color:white;font-weight:700;margin:0;">@child.FullName</h5>
                <small style="color:rgba(255,255,255,.75);">@child.Grade</small>
            </div>
            <div class="d-flex gap-3 flex-wrap" style="color:white;text-align:center;">
                <div><div style="font-size:1.4rem;font-weight:800;">@child.OverallAvg%</div><small style="opacity:.8;font-size:.7rem;">Overall Avg</small></div>
                <div><div style="font-size:1.4rem;font-weight:800;">@child.SubmittedThisWeek</div><small style="opacity:.8;font-size:.7rem;">Submitted This Week</small></div>
                <div><div style="font-size:1.4rem;font-weight:800;">@child.MissingWork</div><small style="opacity:.8;font-size:.7rem;">Missing Work</small></div>
            </div>
        </div>

        <div class="pa-card-body">
            <!-- Summary note -->
            <div class="mb-4 p-3 rounded-3" style="background:@(perfColor)12;border-left:4px solid @perfColor;">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="pbadge" style="background:@(perfColor)20;color:@perfColor;">@perfLabel</span>
                    <span style="font-weight:700;font-size:.88rem;">Performance Summary</span>
                </div>
                <p style="margin:0;font-size:.85rem;color:#555;">@child.PerformanceSummary</p>
            </div>

            <div class="row g-4">
                <!-- Exam results -->
                <div class="col-lg-6">
                    <h6 style="font-weight:700;color:var(--primary);margin-bottom:.75rem;">
                        <i class="fas fa-file-alt me-1" style="color:var(--accent-purple);"></i>Exam Results
                    </h6>
                    @if (!child.ExamResults.Any())
                    {
                        <p style="color:#aaa;font-size:.83rem;">No exams taken.</p>
                    }
                    @foreach (var e in child.ExamResults.Take(5))
                    {
                        double pct = e.TotalMarks > 0 ? e.Score / e.TotalMarks * 100 : 0;
                        var gc = pct >= 70 ? "#16a34a" : pct >= 50 ? "#F48C06" : "#E13468";
                        <div class="mb-2">
                            <div class="d-flex justify-content-between mb-1" style="font-size:.8rem;">
                                <span style="font-weight:500;max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@e.ExamTitle</span>
                                <span style="font-weight:700;color:@gc;">@e.Score/@e.TotalMarks (@((int)pct)%)</span>
                            </div>
                            <div class="pa-progress">
                                <div class="pa-progress-bar" style="width:@((int)pct)%;background:@gc;"></div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Assignment status -->
                <div class="col-lg-6">
                    <h6 style="font-weight:700;color:var(--primary);margin-bottom:.75rem;">
                        <i class="fas fa-tasks me-1" style="color:var(--orange);"></i>Assignment Status
                    </h6>
                    @if (!child.Assignments.Any())
                    {
                        <p style="color:#aaa;font-size:.83rem;">No assignments.</p>
                    }
                    @foreach (var a in child.Assignments.Take(6))
                    {
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="fas @(a.IsSubmitted ? "fa-check-circle" : (a.IsExpired ? "fa-times-circle" : "fa-clock"))"
                               style="color:@a.StatusColor;font-size:.85rem;flex-shrink:0;"></i>
                            <div style="flex:1;min-width:0;">
                                <div style="font-size:.8rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@a.Title</div>
                                <small style="color:#9ca3af;font-size:.7rem;">@a.CourseName — Due @a.Deadline.ToString("MMM dd")</small>
                            </div>
                            <span class="pbadge" style="background:@(a.StatusColor)18;color:@a.StatusColor;font-size:.68rem;flex-shrink:0;">
                                @(a.IsSubmitted ? (a.IsGraded ? $"{a.Score}/{a.TotalMarks}" : "Submitted") : (a.IsExpired ? "Missing" : "Pending"))
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
