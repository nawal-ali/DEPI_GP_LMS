@model StudentParentVM
@{
    ViewData["Title"] = "My Parent";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        @if (!Model.HasParent)
        {
            <div class="st-card p-5 text-center anim" style="color:#aaa;">
                <i class="fas fa-user-friends fa-3x mb-3 d-block opacity-25"></i>
                <p>No parent account is linked to your profile yet.</p>
                <small>Contact your school admin to link a parent account.</small>
            </div>
        }
        else
        {
            <div class="st-card anim">
                <div style="background:linear-gradient(135deg,var(--secondary),var(--accent-green));border-radius:16px 16px 0 0;padding:1.75rem 2rem;display:flex;align-items:center;gap:1.25rem;">
                    <div class="st-avatar" style="width:64px;height:64px;font-size:1.4rem;background:rgba(255,255,255,.2);flex-shrink:0;">
                        @if (!string.IsNullOrEmpty(Model.ImageName))
                        {
                            <img src="~/@Model.ImageName" style="width:100%;height:100%;object-fit:cover;" />
                        }
                        else
                        {

                            @Model.Initials
                        }
                    </div>
                    <div>
                        <h5 style="color:white;font-weight:700;margin:0;">@Model.ParentName</h5>
                        <span style="background:rgba(255,255,255,.2);color:white;border-radius:20px;padding:2px 12px;font-size:.75rem;font-weight:600;">@(Model.Relationship ?? "Parent / Guardian")</span>
                    </div>
                </div>
                <div class="st-card-body">
                    <div class="row g-3">
                        @{
                            var infos = new[] { ("fa-phone", "var(--secondary)", "Phone", Model.ParentPhone), ("fa-envelope", "var(--accent-purple)", "Email", Model.ParentEmail), ("fa-briefcase", "var(--orange)", "Occupation", Model.Occupation) };
                        }
                        @foreach (var (ico, col, lbl, val) in infos)
                        {
                            if (string.IsNullOrEmpty(val)) continue;
                            <div class="col-md-6">
                                <div style="display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid rgba(0,0,0,.04);">
                                    <div style="width:32px;height:32px;border-radius:8px;background:@(col)15;display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas @ico" style="color:@col;font-size:.82rem;"></i></div>
                                    <div><small style="color:#9ca3af;font-size:.7rem;display:block;">@lbl</small><span style="font-weight:600;font-size:.85rem;">@val</span></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>