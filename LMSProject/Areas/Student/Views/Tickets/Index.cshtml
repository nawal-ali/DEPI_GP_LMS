@using LMSProject.ViewModels.Tickets
@model List<TicketListItemVM>
@{
    ViewData["Title"] = "Support Tickets";
    var status = ViewBag.Status as string ?? "";
}
<style>
    .ticket-item {
        background: white;
        border-radius: 14px;
        border: 1.5px solid rgba(0,0,0,.05);
        padding: 1rem 1.25rem;
        margin-bottom: .65rem;
        transition: box-shadow .2s,transform .2s;
        display: flex;
        align-items: center;
        gap: 1rem;
        text-decoration: none;
        color: inherit
    }

        .ticket-item:hover {
            box-shadow: 0 6px 24px rgba(47,50,125,.1);
            transform: translateY(-2px);
            color: inherit
        }

    .tk-badge-sm {
        padding: 2px 9px;
        border-radius: 20px;
        font-size: .71rem;
        font-weight: 600
    }
</style>
<div class="d-flex justify-content-between align-items-center mb-4 anim">
    <h5 style="font-weight:700;color:var(--primary);margin:0;"><i class="fas fa-headset me-2" style="color:var(--secondary);"></i>Support Tickets <span class="pb pb-blue ms-2">@Model.Count</span></h5>
    <a asp-area="Student" asp-controller="Tickets" asp-action="Create" class="btn btn-primary btn-sm rounded-3 px-3" style="font-family:Poppins,sans-serif;"><i class="fas fa-plus me-1"></i>New Ticket</a>
</div>
<div class="d-flex gap-2 flex-wrap mb-4 anim">
    <a asp-action="Index" class="btn btn-sm rounded-3 px-3 @(string.IsNullOrEmpty(status) ? "btn-primary" : "")" style="font-family:Poppins,sans-serif;font-size:.8rem;">All (@Model.Count)</a>
    @foreach (var s in new[] { "Open", "In Progress", "Resolved", "Closed" })
    {
        var cnt = Model.Count(t => t.Status == s);
        if (cnt == 0) continue;
        <a asp-action="Index" asp-route-status="@s" class="btn btn-sm rounded-3 px-3 @(status == s ? "btn-primary" : "")" style="font-family:Poppins,sans-serif;font-size:.8rem;">@s (@cnt)</a>
    }
</div>
@if (!Model.Any())
{
    <div class="st-card p-5 text-center anim" style="color:#aaa;"><i class="fas fa-headset fa-3x mb-3 d-block opacity-25"></i>No tickets yet.</div>
}
else
{
    @foreach (var t in Model)
    {
        <a asp-area="Student" asp-controller="Tickets" asp-action="Detail" asp-route-id="@t.Id" class="ticket-item anim">
            <div style="width:40px;height:40px;border-radius:11px;flex-shrink:0;background:@t.StatusBg;display:flex;align-items:center;justify-content:center;"><i class="fas fa-headset" style="color:@t.StatusColor;font-size:.9rem;"></i></div>
            <div style="flex:1;min-width:0;">
                <div class="d-flex align-items-center gap-2 mb-1 flex-wrap"><span style="font-weight:700;font-size:.88rem;">@t.Title</span></div>
                <div class="d-flex gap-2 flex-wrap"><span class="tk-badge-sm" style="background:@t.StatusBg;color:@t.StatusColor;">@t.Status</span><span class="tk-badge-sm" style="background:rgba(0,0,0,.05);color:#6c757d;">@t.DisplayType</span><span style="font-size:.72rem;color:#9ca3af;"><i class="fas fa-clock me-1"></i>@t.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm")</span></div>
            </div>
            <i class="fas fa-chevron-right" style="color:#d1d5db;font-size:.78rem;flex-shrink:0;"></i>
        </a>
    }
}