@using MLSCore.Models
@{
    ViewData["Title"] = "Announcements";
    var paged = ViewBag.Paged as List<TbAnnouncement> ?? new();
    var total = (int)(ViewBag.Total ?? 0);
    var pages = (int)(ViewBag.Pages ?? 1);
    var page = (int)(ViewBag.Page ?? 1);
    var search = ViewBag.Search as string ?? "";
    var priority = ViewBag.Priority as string ?? "";
    string PGrad(string? p) => p switch { "Urgent" => "linear-gradient(135deg,var(--accent-pink),var(--orange))", "High" => "linear-gradient(135deg,var(--orange),var(--yellow))", _ => "linear-gradient(135deg,var(--primary),var(--accent-blue))" };
}
<div class="d-flex justify-content-between align-items-center mb-4 anim">
    <h5 style="font-weight:700;color:var(--primary);margin:0;"><i class="fas fa-bullhorn me-2" style="color:var(--secondary);"></i>Announcements <span class="pb pb-blue ms-2">@total</span></h5>
</div>
<form method="get" asp-action="Index">
    <div class="d-flex gap-2 flex-wrap mb-4 anim">
        <div style="position:relative;flex:1;min-width:180px;">
            <i class="fas fa-search" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#aaa;font-size:.82rem;"></i>
            <input name="search" class="st-control" style="padding-left:2.2rem;" placeholder="Search…" value="@search" />
        </div>
        <select name="priority" class="st-control" style="width:auto;" onchange="this.form.submit()">
            <option value="">All</option>
            @foreach (var p in new[] { "Urgent", "High", "Medium", "Low" })
            {
                <option value="@p" selected="@(priority == p ? "selected" : null)">@p</option>
            }
        </select>
        <button type="submit" class="btn btn-primary rounded-3 px-3 btn-sm" style="font-family:Poppins,sans-serif;">Filter</button>
    </div>
</form>
@if (!paged.Any())
{
    <div class="st-card p-5 text-center anim" style="color:#aaa;"><i class="fas fa-bullhorn fa-3x mb-3 d-block opacity-25"></i>No announcements.</div>
}
@foreach (var a in paged)
{
    <div class="st-card mb-3 anim" style="border-left:5px solid var(--secondary);transition:transform .2s;" onmouseover="this.style.transform='translateX(4px)'" onmouseout="this.style.transform='none'">
        <div style="background:@PGrad(a.Priority);border-radius:11px 11px 0 0;padding:11px 16px;display:flex;align-items:flex-start;justify-content:space-between;gap:10px;">
            <div>
                @if (a.IsPinned)
                {
                    <i class="fas fa-thumbtack me-1" style="color:rgba(255,255,255,.85);font-size:.78rem;"></i>
                }
                <strong style="color:white;font-size:.92rem;">@a.Title</strong>
                <small style="color:rgba(255,255,255,.7);font-size:.7rem;display:block;margin-top:2px;"><i class="fas fa-calendar me-1"></i>@a.PublishedDate.ToString("MMM dd, yyyy")</small>
            </div>
            <span style="background:rgba(255,255,255,.2);color:white;border-radius:20px;padding:2px 10px;font-size:.68rem;font-weight:600;flex-shrink:0;">@(a.Priority ?? "Normal")</span>
        </div>
        <div style="padding:.9rem 1.2rem;font-size:.875rem;color:#444;line-height:1.8;">@a.Content</div>
    </div>
}