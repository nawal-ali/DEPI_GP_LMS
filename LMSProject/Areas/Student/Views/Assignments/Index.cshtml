@model List<AssignmentVM>
@{
    ViewData["Title"] = "Assignments";
}

<div class="d-flex justify-content-between align-items-center mb-4 anim">
    <h5 style="font-weight:700;color:var(--primary);margin:0;">
        <i class="fas fa-tasks me-2" style="color:var(--secondary);"></i>Assignments
    </h5>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3 anim anim-1"><div class="st-stat sg1"><p>Total</p><h3>@Model.Count</h3><i class="fas fa-tasks si"></i></div></div>
    <div class="col-6 col-md-3 anim anim-2"><div class="st-stat sg2"><p>Submitted</p><h3>@Model.Count(a => a.IsSubmitted)</h3><i class="fas fa-check-circle si"></i></div></div>
    <div class="col-6 col-md-3 anim anim-3"><div class="st-stat sg3"><p>Pending</p><h3>@Model.Count(a => !a.IsSubmitted && !a.IsExpired)</h3><i class="fas fa-clock si"></i></div></div>
    <div class="col-6 col-md-3 anim anim-4"><div class="st-stat sg5"><p>Missing</p><h3>@Model.Count(a => a.IsExpired)</h3><i class="fas fa-exclamation-circle si"></i></div></div>
</div>

@if (!Model.Any())
{
    <div class="st-card p-5 text-center anim" style="color:#aaa;">
        <i class="fas fa-tasks fa-3x mb-3 d-block opacity-25"></i>No assignments found.
    </div>
}
else
{
    <div class="st-card anim">
        <div class="table-responsive">
            <table class="st-table">
                <thead>
                    <tr><th>Assignment</th><th>Course</th><th>Deadline</th><th>Marks</th><th>Type</th><th>Status</th><th>Action</th></tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>
                                <div style="font-weight:600;font-size:.87rem;">@a.Title</div>
                                @if (!string.IsNullOrEmpty(a.Description))
                                {
                                    <small style="color:#9ca3af;font-size:.75rem;">@(a.Description.Length > 60 ? a.Description[..60] + "…" : a.Description)</small>
                                }
                            </td>
                            <td><span class="pb pb-purple">@a.CourseName</span></td>
                            <td style="font-size:.82rem;">
                                @a.Deadline.ToString("MMM dd, yyyy")
                                @if ((a.Deadline - DateTime.Now).TotalDays <= 2 && !a.IsSubmitted && !a.IsExpired)
                                {
                                    <span class="pb pb-red d-block" style="font-size:.65rem;margin-top:2px;">Due soon!</span>
                                }
                            </td>
                            <td style="font-weight:700;color:var(--primary);">@a.TotalMarks</td>
                            <td><span class="pb pb-gray" style="font-size:.71rem;">@a.SubType</span></td>
                            <td>
                                <span class="pb @a.BadgeClass">@a.StatusLabel</span>
                                @if (a.IsLate && a.IsSubmitted)
                                {
                                    <span class="pb pb-orange d-block" style="font-size:.65rem;margin-top:2px;">Late</span>
                                }
                            </td>
                            <td>
                                @if (!a.IsSubmitted && !a.IsExpired)
                                {
                                    <button type="button" class="btn btn-primary btn-sm rounded-3 px-3"
                                            style="font-size:.78rem;font-family:Poppins,sans-serif;"
                                            data-bs-toggle="modal" data-bs-target="#submitModal"
                                            data-aid="@a.AssignmentId" data-title="@a.Title"
                                            data-type="@a.SubType" data-marks="@a.TotalMarks">
                                        <i class="fas fa-upload me-1"></i>Submit
                                    </button>
                                }
                                else if (a.IsSubmitted && !string.IsNullOrEmpty(a.Feedback))
                                {
                                    <button type="button" class="btn btn-sm rounded-3 px-3"
                                            style="background:rgba(0,203,184,.1);color:var(--secondary);font-size:.78rem;font-family:Poppins,sans-serif;"
                                            data-bs-toggle="modal" data-bs-target="#feedbackModal"
                                            data-feedback="@a.Feedback" data-score="@a.Score" data-marks="@a.TotalMarks">
                                        <i class="fas fa-comment me-1"></i>Feedback
                                    </button>
                                }
                                else
                                {

                                    <span style="color:#aaa;font-size:.8rem;">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Submit Modal -->
<div class="modal fade" id="submitModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:500px;">
        <div class="modal-content" style="border-radius:18px;border:none;box-shadow:0 20px 60px rgba(0,0,0,.15);">
            <div style="background:linear-gradient(135deg,var(--primary),var(--accent-purple));border-radius:18px 18px 0 0;padding:1.2rem 1.5rem;display:flex;align-items:center;justify-content:space-between;">
                <h5 style="color:white;font-weight:700;margin:0;font-size:1rem;" id="modalAssignTitle">Submit Assignment</h5>
                <button class="btn-close" data-bs-dismiss="modal" style="filter:brightness(0) invert(1);"></button>
            </div>
            <form asp-area="Student" asp-controller="Assignments" asp-action="Submit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="AssignmentId" id="modalAid" />
                <div style="padding:1.5rem;">
                    <div id="textAnswerArea" class="mb-3">
                        <label class="form-label" style="font-weight:600;font-size:.84rem;">Text Answer</label>
                        <textarea name="TextAnswer" class="st-control" rows="4" placeholder="Type your answer…" style="resize:vertical;"></textarea>
                    </div>
                    <div id="fileArea" class="mb-3">
                        <label class="form-label" style="font-weight:600;font-size:.84rem;">Upload File</label>
                        <input type="file" name="File" class="st-control" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg" />
                        <small class="text-muted" style="font-size:.72rem;">PDF, Word, or image</small>
                    </div>
                </div>
                <div style="padding:.5rem 1.5rem 1.3rem;display:flex;gap:.75rem;justify-content:flex-end;border-top:1px solid rgba(0,0,0,.05);">
                    <button type="button" class="btn btn-sm btn-secondary rounded-3 px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary rounded-3 px-4">
                        <i class="fas fa-paper-plane me-1"></i>Submit
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Feedback Modal -->
<div class="modal fade" id="feedbackModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:440px;">
        <div class="modal-content" style="border-radius:18px;border:none;box-shadow:0 20px 60px rgba(0,0,0,.15);">
            <div style="background:linear-gradient(135deg,var(--secondary),var(--accent-blue));border-radius:18px 18px 0 0;padding:1.2rem 1.5rem;display:flex;align-items:center;justify-content:space-between;">
                <h5 style="color:white;font-weight:700;margin:0;font-size:1rem;">Instructor Feedback</h5>
                <button class="btn-close" data-bs-dismiss="modal" style="filter:brightness(0) invert(1);"></button>
            </div>
            <div style="padding:1.5rem;">
                <div class="mb-3 p-3 rounded-3" style="background:rgba(0,203,184,.06);">
                    <small style="font-weight:700;color:var(--secondary);display:block;margin-bottom:4px;">Score</small>
                    <span id="feedScore" style="font-size:1.5rem;font-weight:800;color:var(--primary);"></span>
                </div>
                <div class="p-3 rounded-3" style="background:rgba(47,50,125,.04);">
                    <small style="font-weight:700;color:var(--primary);display:block;margin-bottom:4px;">Feedback</small>
                    <p id="feedText" style="margin:0;font-size:.87rem;color:#444;line-height:1.75;"></p>
                </div>
            </div>
            <div style="padding:.5rem 1.5rem 1.3rem;">
                <button class="btn btn-sm w-100 rounded-3" style="background:rgba(47,50,125,.07);color:var(--primary);" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('submitModal').addEventListener('show.bs.modal', function(e) {
            var btn   = e.relatedTarget;
            var aid   = btn.dataset.aid;
            var title = btn.dataset.title;
            var type  = btn.dataset.type;
            document.getElementById('modalAid').value        = aid;
            document.getElementById('modalAssignTitle').textContent = 'Submit: ' + title;
            document.getElementById('textAnswerArea').style.display = type === 'FileOnly'  ? 'none' : '';
            document.getElementById('fileArea').style.display       = type === 'TextOnly'  ? 'none' : '';
        });
        document.getElementById('feedbackModal').addEventListener('show.bs.modal', function(e) {
            var btn = e.relatedTarget;
            document.getElementById('feedScore').textContent = btn.dataset.score + ' / ' + btn.dataset.marks;
            document.getElementById('feedText').textContent  = btn.dataset.feedback;
        });
    </script>
}
