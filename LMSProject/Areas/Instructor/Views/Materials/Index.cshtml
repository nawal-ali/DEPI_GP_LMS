@model List<LMSProject.Areas.Instructor.ViewModel.MaterialListItemVM>
@using MLSCore.Models
@{
    ViewData["Title"] = "Course Materials";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-0 fw-bold" style="color:var(--primary);">Course Materials</h5>
        <small class="text-muted">@Model.Count material(s) across your courses</small>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm px-4 py-2" style="border-radius:10px;font-size:0.85rem;">
        <i class="fas fa-plus me-2"></i>Add Material
    </a>
</div>

<div class="sa-card">
    <div class="sa-card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-folder-open fa-3x mb-3 d-block" style="opacity:0.2;"></i>
                <p class="mb-2" style="font-size:0.9rem;">No materials yet.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm px-4" style="border-radius:10px;">Add your first material</a>
            </div>
        }
        else
        {
            <table class="sa-table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Type</th>
                        <th>Course</th>
                        <th>Added</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        var (icon, color, label) = m.MaterialType switch
                        {
                            MaterialType.PDF => ("fa-file-pdf", "#E13468", "PDF"),
                            MaterialType.DOC => ("fa-file-word", "#5B72EE", "DOC"),
                            MaterialType.Image => ("fa-file-image", "#33EFA0", "Image"),
                            _ => ("fa-link", "#29B9E7", "Link")
                        };
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:34px;height:34px;border-radius:9px;background:@(color)18;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                        <i class="fas @icon" style="color:@color;font-size:0.85rem;"></i>
                                    </div>
                                    <div>
                                        <div style="font-weight:600;font-size:0.85rem;">@m.Title</div>
                                        @if (!string.IsNullOrEmpty(m.Description))
                                        {
                                            <small class="text-muted" style="font-size:0.72rem;">@(m.Description.Length > 60 ? m.Description[..60] + "…" : m.Description)</small>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td><span class="sa-badge" style="background:@(color)18;color:@color;">@label</span></td>
                            <td style="font-size:0.83rem;">@m.CourseName</td>
                            <td style="font-size:0.78rem;color:#9ca3af;">@m.CreatedDate?.ToString("MMM d, yyyy")</td>
                            <td>
                                <div class="d-flex gap-1">
                                    @if (m.MaterialType == MaterialType.Link)
                                    {
                                        <a href="@m.FileUrl" target="_blank" class="sa-btn-icon sa-btn-view" title="Open Link">
                                            <i class="fas fa-external-link-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="/@m.FileUrl" target="_blank" class="sa-btn-icon sa-btn-view" title="View / Download">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    }
                                    <a asp-action="Edit" asp-route-id="@m.Id" class="sa-btn-icon sa-btn-edit" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form id="delForm1" asp-action="Delete" asp-route-id="@m.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="sa-btn-icon sa-btn-delete" title="Delete" onclick="triggerDeleteModal(this)">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@await Html.PartialAsync("_DeleteModal")

@section Scripts {
    <script>
        function triggerDeleteModal(btn) {
            var form  = btn.closest('form');
            var row   = btn.closest('tr');
            var title = row ? (row.querySelector('[style*="font-weight:600"]') || row.querySelector('td:nth-child(1)')) : null;
            var name  = title ? title.textContent.trim().substring(0, 60) : 'this item';
            document.getElementById('deleteItemName').textContent = name;
            var confirmBtn = document.getElementById('deleteConfirmBtn');
            confirmBtn.onclick = function(e) { e.preventDefault(); form.submit(); };
            confirmBtn.href = '#';
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}