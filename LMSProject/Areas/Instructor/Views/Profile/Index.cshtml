@{
    ViewData["Title"] = "My Profile";
    var user = ViewBag.User as MLSCore.IdentityModel.ApplicationUser;
    var instructor = ViewBag.Instructor as MLSCore.Models.TbInstructor;
    var fullName = instructor?.FullName ?? user?.FullName ?? User.Identity?.Name ?? "Instructor";
    var email = user?.Email ?? "";
    var phone = user?.PhoneNumber ?? "";
    var initials = fullName.Length >= 2 ? fullName[..2].ToUpper() : fullName.ToUpper();
    var imageNm = instructor?.ImageName;
}

<div class="row g-4 justify-content-center">
    <div class="col-lg-8">

        <!-- Profile card -->
        <div class="iact-card anim mb-4">
            <div style="background:linear-gradient(135deg,var(--primary),var(--secondary));
                border-radius:16px 16px 0 0;padding:1.75rem 2rem;
                display:flex;align-items:center;gap:1.25rem;flex-wrap:wrap;">
                <div style="width:64px;height:64px;border-radius:50%;overflow:hidden;
                    background:rgba(255,255,255,.2);display:flex;align-items:center;
                    justify-content:center;color:white;font-size:1.4rem;font-weight:700;flex-shrink:0;">
                    @if (!string.IsNullOrEmpty(imageNm))
                    {
                        <img src="~/@imageNm" style="width:100%;height:100%;object-fit:cover;" />
                    }
                    else
                    {

                        @initials
                    }
                </div>
                <div>
                    <h5 style="color:white;font-weight:700;margin:0;">@fullName</h5>
                    <span style="background:rgba(255,255,255,.2);color:white;border-radius:20px;
                        padding:2px 12px;font-size:.75rem;font-weight:600;">
                        <i class="fas fa-chalkboard-teacher me-1"></i>Instructor
                    </span>
                </div>
            </div>
            <div class="iact-card-body">
                <form asp-area="Instructor" asp-controller="Profile" asp-action="Edit"
                      method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" style="font-weight:600;font-size:.84rem;">Full Name</label>
                            <input name="FullName" value="@fullName" class="iact-form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" style="font-weight:600;font-size:.84rem;">Phone</label>
                            <input name="Phone" value="@phone" class="iact-form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" style="font-weight:600;font-size:.84rem;">Email</label>
                            <input value="@email" class="iact-form-control" disabled
                                   style="background:rgba(0,0,0,.03);" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" style="font-weight:600;font-size:.84rem;">Specialization</label>
                            <input name="Specialization" value="@instructor?.Specialization"
                                   class="iact-form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" style="font-weight:600;font-size:.84rem;">Bio</label>
                            <textarea name="Bio" rows="3" class="iact-form-control"
                                      style="resize:vertical;">@instructor?.Bio</textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" style="font-weight:600;font-size:.84rem;">Profile Photo</label>
                            <input type="file" name="Image" class="iact-form-control" accept="image/*" />
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary rounded-3 px-4"
                                style="font-family:Poppins,sans-serif;">
                            <i class="fas fa-save me-2"></i>Save Profile
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Password change -->
        <div class="iact-card anim">
            <div style="background:linear-gradient(135deg,var(--secondary),var(--accent-blue));
                border-radius:16px 16px 0 0;padding:1.1rem 1.5rem;">
                <h5 style="color:white;font-weight:700;margin:0;">
                    <i class="fas fa-lock me-2"></i>Change Password
                </h5>
            </div>
            <div class="iact-card-body">
                @await Html.PartialAsync("_PasswordChange", new ViewDataDictionary(ViewData) {
                    { "PwArea",       "Instructor" },
                    { "PwController", "Profile" },
                    { "PwAction",     "ChangePassword" },
                    { "PwFormId",     "instructorPwForm" },
                    { "InputClass",   "iact-form-control" }
                })
            </div>
        </div>

    </div>
</div>
