@* Reusable empty-state for instructors not assigned to any courses.
   Usage: @await Html.PartialAsync("_NoCourseAccess", "Exams")
   Pass feature name as model string *@
@model string
@{
    var feature = Model ?? "this section";
}

<div style="display:flex;justify-content:center;align-items:center;min-height:55vh;padding:2rem;">
    <div style="max-width:520px;width:100%;text-align:center;">

        <!-- Illustration -->
        <div style="position:relative;margin-bottom:2rem;">
            <div style="width:100px;height:100px;border-radius:28px;
                background:linear-gradient(135deg,rgba(47,50,125,.08),rgba(91,114,238,.12));
                border:2px dashed rgba(91,114,238,.25);
                display:flex;align-items:center;justify-content:center;
                margin:0 auto;font-size:2.5rem;color:rgba(91,114,238,.5);">
                <i class="fas fa-book-open"></i>
            </div>
            <!-- floating badge -->
            <div style="position:absolute;top:-8px;right:calc(50% - 66px);
                background:rgba(244,140,6,.12);border:1px solid rgba(244,140,6,.3);
                border-radius:20px;padding:3px 10px;font-size:.65rem;
                font-weight:700;color:var(--orange);">
                <i class="fas fa-exclamation me-1"></i>No courses assigned
            </div>
        </div>

        <!-- Title -->
        <h5 style="font-weight:800;color:var(--primary);margin-bottom:.6rem;font-size:1.15rem;">
            You're not assigned to any courses yet
        </h5>

        <!-- Message -->
        <p style="color:#6b7280;font-size:.88rem;line-height:1.75;margin-bottom:.5rem;">
            To access <strong>@feature</strong>, you need to be assigned to at least one active course.
            Course assignments are managed by the Admin.
        </p>
        <p style="color:#9ca3af;font-size:.8rem;line-height:1.65;margin-bottom:2rem;">
            If you believe this is a mistake or you should already have a course assigned,
            please reach out to the administration team through the support ticket system.
        </p>

        <!-- Actions -->
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a asp-area="Instructor" asp-controller="Tickets" asp-action="Create"
               class="btn btn-primary rounded-3 px-4"
               style="font-family:Poppins,sans-serif;font-size:.85rem;">
                <i class="fas fa-ticket-alt me-2"></i>Send Support Ticket
            </a>
            <a asp-area="Instructor" asp-controller="Home" asp-action="Index"
               class="btn rounded-3 px-4"
               style="background:rgba(47,50,125,.07);color:var(--primary);
                font-family:Poppins,sans-serif;font-size:.85rem;font-weight:600;">
                <i class="fas fa-home me-2"></i>Go to Dashboard
            </a>
        </div>

        <!-- Info note -->
        <div style="margin-top:2rem;background:rgba(41,185,231,.06);
            border:1px solid rgba(41,185,231,.2);border-radius:12px;
            padding:.9rem 1.2rem;font-size:.78rem;color:#374151;line-height:1.7;text-align:left;">
            <i class="fas fa-info-circle me-2" style="color:var(--accent-blue);"></i>
            <strong>How it works:</strong> An Admin or SuperAdmin assigns courses to instructors.
            Once assigned, you'll have full access to create exams, assignments, and upload materials
            for your courses.
        </div>

    </div>
</div>
