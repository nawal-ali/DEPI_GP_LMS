@model List<LMSProject.Areas.Instructor.ViewModel.ExamListItemVM>
@{
    ViewData["Title"] = "Exams";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-0 fw-bold" style="color:var(--primary);">Exams</h5>
        <small class="text-muted">@Model.Count exam(s) in your courses</small>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm px-4 py-2" style="border-radius:10px;font-size:0.85rem;">
        <i class="fas fa-plus me-2"></i>Create Exam
    </a>
</div>

<div class="sa-card">
    <div class="sa-card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-clipboard-list fa-3x mb-3 d-block" style="opacity:0.2;"></i>
                <p class="mb-2" style="font-size:0.9rem;">No exams yet.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm px-4" style="border-radius:10px;">Create your first exam</a>
            </div>
        }
        else
        {
            <table class="sa-table">
                <thead>
                    <tr>
                        <th>Exam</th>
                        <th>Course</th>
                        <th>Duration</th>
                        <th>Marks</th>
                        <th>Deadline</th>
                        <th>Questions</th>
                        <th>Attempts</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        var isOverdue = e.Deadline.HasValue && e.Deadline < DateTime.Now;
                        <tr>
                            <td>
                                <div style="font-weight:600;font-size:0.85rem;">@e.Title</div>
                                @if (!string.IsNullOrEmpty(e.Description))
                                {
                                    <small class="text-muted" style="font-size:0.72rem;">
                                        @(e.Description.Length > 50 ? e.Description[..50] + "…" : e.Description)
                                    </small>
                                }
                            </td>
                            <td style="font-size:0.83rem;">@e.CourseName</td>
                            <td>
                                <span class="sa-badge sa-badge-info">@e.DurationInMinutes min</span>
                            </td>
                            <td style="font-size:0.83rem;font-weight:600;">@e.TotalMarks pts</td>
                            <td>
                                @if (e.Deadline.HasValue)
                                {
                                    <span class="sa-badge @(isOverdue ? "sa-badge-inactive" : "sa-badge-active")">
                                        @e.Deadline.Value.ToString("MMM d, yyyy")
                                    </span>
                                }
                                else
                                {
                                    <span class="sa-badge sa-badge-pending">No deadline</span>
                                }
                            </td>
                            <td>
                                <span class="sa-badge" style="background:rgba(91,114,238,0.12);color:var(--accent-purple);">
                                    @e.QuestionCount Q
                                </span>
                            </td>
                            <td style="font-size:0.83rem;">@e.AttemptCount</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@e.Id" class="sa-btn-icon sa-btn-view" title="View & Manage">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Results" asp-route-id="@e.Id" class="sa-btn-icon sa-btn-add" title="View Results">
                                        <i class="fas fa-chart-bar"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@e.Id" class="sa-btn-icon sa-btn-edit" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form id="delForm1" asp-action="Delete" asp-route-id="@e.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="sa-btn-icon sa-btn-delete" title="Delete" onclick="triggerDeleteModal(this)">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@await Html.PartialAsync("_DeleteModal")

@section Scripts {
    <script>
        function triggerDeleteModal(btn) {
            var form  = btn.closest('form');
            var row   = btn.closest('tr');
            var title = row ? (row.querySelector('[style*="font-weight:600"]') || row.querySelector('td:nth-child(1)')) : null;
            var name  = title ? title.textContent.trim().substring(0, 60) : 'this item';
            document.getElementById('deleteItemName').textContent = name;
            var confirmBtn = document.getElementById('deleteConfirmBtn');
            confirmBtn.onclick = function(e) { e.preventDefault(); form.submit(); };
            confirmBtn.href = '#';
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}