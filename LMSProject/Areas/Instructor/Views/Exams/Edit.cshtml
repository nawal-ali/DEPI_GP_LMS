@model LMSProject.Areas.Instructor.ViewModel.EditExamVM
@{
    ViewData["Title"] = "Edit Exam";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="d-flex align-items-center gap-2 mb-4">
            <a asp-action="Details" asp-route-id="@Model.Id" class="sa-btn-icon sa-btn-view"><i class="fas fa-arrow-left"></i></a>
            <div>
                <h5 class="mb-0 fw-bold" style="color:var(--primary);">Edit Exam</h5>
                <small class="text-muted">Update exam settings</small>
            </div>
        </div>

        <div class="sa-card">
            <div class="sa-card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label class="form-label">Exam Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="sa-form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea asp-for="Description" class="sa-form-control" rows="2"></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Course <span class="text-danger">*</span></label>
                            <select asp-for="CourseId" class="sa-form-control">
                                @foreach (var c in Model.Courses)
                                {
                                    <option value="@c.Id" selected="@(c.Id == Model.CourseId)">@c.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Duration (minutes) <span class="text-danger">*</span></label>
                            <input asp-for="DurationInMinutes" type="number" min="1" max="600" class="sa-form-control" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Total Marks</label>
                            <input asp-for="TotalMarks" type="number" min="0" step="0.5" class="sa-form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Deadline</label>
                            <input asp-for="Deadline" type="datetime-local" class="sa-form-control"
                                   value="@Model.Deadline?.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn-secondary-sa">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4" style="border-radius:10px;">
                            <i class="fas fa-save me-2"></i>Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
