@model LMSProject.Areas.Instructor.ViewModel.GradeTextAnswersVM
@{
    ViewData["Title"] = "Grade Text Answers";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Results" asp-route-id="@Model.ExamId" class="sa-btn-icon sa-btn-view">
        <i class="fas fa-arrow-left"></i>
    </a>
    <div>
        <h5 class="mb-0 fw-bold" style="color:var(--primary);">Grade Text Answers</h5>
        <small class="text-muted">@Model.ExamTitle — @Model.StudentName</small>
    </div>
</div>

<!-- Summary bar -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="sa-card p-3 text-center">
            <div style="font-size:1.4rem;font-weight:800;color:var(--secondary);">@Model.TotalMarks</div>
            <small class="text-muted">Total Marks</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="sa-card p-3 text-center">
            <div style="font-size:1.4rem;font-weight:800;color:var(--primary);">@Model.AutoScore</div>
            <small class="text-muted">MCQ Score</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="sa-card p-3 text-center">
            <div style="font-size:1.4rem;font-weight:800;color:#F48C06;">@Model.TextAnswers.Count</div>
            <small class="text-muted">Text Questions</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="sa-card p-3 text-center">
            <div style="font-size:1.4rem;font-weight:800;color:#9b59b6;">@(Model.TextAnswers.Sum(t => t.MaxPoints))</div>
            <small class="text-muted">Available Text Marks</small>
        </div>
    </div>
</div>

<form asp-action="GradeTextAnswers" method="post">
    <input type="hidden" asp-for="StudentTestId" />
    <input type="hidden" asp-for="ExamId" />
    <input type="hidden" asp-for="TotalMarks" />
    <input type="hidden" asp-for="AutoScore" />
    <input type="hidden" asp-for="StudentName" />
    <input type="hidden" asp-for="ExamTitle" />

    @for (int i = 0; i < Model.TextAnswers.Count; i++)
    {
        var q = Model.TextAnswers[i];
        <input type="hidden" asp-for="TextAnswers[i].AnswerId" />
        <input type="hidden" asp-for="TextAnswers[i].QuestionTitle" />
        <input type="hidden" asp-for="TextAnswers[i].MaxPoints" />
        <input type="hidden" asp-for="TextAnswers[i].StudentAnswer" />
        <input type="hidden" asp-for="TextAnswers[i].QuestionDescription" />

        <div class="sa-card mb-3">
            <div class="sa-card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
                    <div>
                        <div style="font-weight:700;font-size:.95rem;color:var(--primary);">
                            Q@(i+1). @q.QuestionTitle
                        </div>
                        @if (!string.IsNullOrWhiteSpace(q.QuestionDescription))
                        {
                            <div style="font-size:.82rem;color:#6b7280;margin-top:.25rem;">@q.QuestionDescription</div>
                        }
                    </div>
                    <span style="background:rgba(91,114,238,.1);color:var(--accent-purple);border-radius:8px;padding:3px 12px;font-size:.78rem;font-weight:700;white-space:nowrap;">
                        Max: @q.MaxPoints mark@(q.MaxPoints != 1 ? "s" : "")
                    </span>
                </div>

                <div style="background:#f8f9ff;border-radius:10px;padding:1rem;margin-bottom:1rem;min-height:60px;">
                    <div style="font-size:.72rem;font-weight:700;color:#9ca3af;text-transform:uppercase;letter-spacing:.5px;margin-bottom:.4rem;">Student's Answer</div>
                    <div style="font-size:.88rem;color:#374151;white-space:pre-wrap;">@(string.IsNullOrWhiteSpace(q.StudentAnswer) ? "— No answer provided —" : q.StudentAnswer)</div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <label style="font-size:.85rem;font-weight:600;color:var(--primary);white-space:nowrap;">
                        Points Awarded:
                    </label>
                    <input type="number" asp-for="TextAnswers[i].AwardedPoints"
                           min="0" max="@q.MaxPoints" step="0.5"
                           class="form-control form-control-sm"
                           style="max-width:120px;border-radius:8px;"
                           placeholder="0" />
                    <span style="font-size:.82rem;color:#9ca3af;">/ @q.MaxPoints</span>
                    <span asp-validation-for="TextAnswers[i].AwardedPoints" class="text-danger small"></span>
                </div>
            </div>
        </div>
    }

    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary px-4" style="border-radius:10px;font-family:Poppins,sans-serif;font-weight:700;">
            <i class="fas fa-check me-2"></i>Submit Grades
        </button>
        <a asp-action="Results" asp-route-id="@Model.ExamId"
           class="btn btn-sm px-4" style="border-radius:10px;background:rgba(0,0,0,.06);color:#374151;font-weight:600;display:flex;align-items:center;">
            Cancel
        </a>
    </div>
</form>
