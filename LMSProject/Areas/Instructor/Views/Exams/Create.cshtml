@model LMSProject.Areas.Instructor.ViewModel.CreateExamVM
@{
    ViewData["Title"] = "Create Exam";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="d-flex align-items-center gap-2 mb-4">
            <a asp-action="Index" class="sa-btn-icon sa-btn-view"><i class="fas fa-arrow-left"></i></a>
            <div>
                <h5 class="mb-0 fw-bold" style="color:var(--primary);">Create Exam</h5>
                <small class="text-muted">Set up the exam details, then add questions</small>
            </div>
        </div>

        <div class="sa-card">
            <div class="sa-card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">Exam Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="sa-form-control" placeholder="e.g. Midterm Exam – Chapter 1-5" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea asp-for="Description" class="sa-form-control" rows="2"
                                  placeholder="Instructions or notes for students"></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Course <span class="text-danger">*</span></label>
                            <select asp-for="CourseId" class="sa-form-control">
                                <option value="">— Select Course —</option>
                                @foreach (var c in Model.Courses)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CourseId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Duration (minutes) <span class="text-danger">*</span></label>
                            <input asp-for="DurationInMinutes" type="number" min="1" max="600" class="sa-form-control" />
                            <span asp-validation-for="DurationInMinutes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Total Marks</label>
                            <input asp-for="TotalMarks" type="number" min="0" step="0.5" class="sa-form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Deadline</label>
                            <input asp-for="Deadline" type="datetime-local" class="sa-form-control" />
                            <small class="text-muted">Leave blank for no deadline</small>
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <a asp-action="Index" class="btn-secondary-sa">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4" style="border-radius:10px;">
                            <i class="fas fa-arrow-right me-2"></i>Create & Add Questions
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
