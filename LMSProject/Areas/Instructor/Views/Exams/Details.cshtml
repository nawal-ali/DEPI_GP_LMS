@model LMSProject.Areas.Instructor.ViewModel.ExamDetailsVM
@using MLSCore.Models
@{
    ViewData["Title"] = Model.Title;
}

<!-- Exam Header -->
<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="sa-btn-icon sa-btn-view"><i class="fas fa-arrow-left"></i></a>
        <div>
            <h5 class="mb-0 fw-bold" style="color:var(--primary);">@Model.Title</h5>
            <small class="text-muted">@Model.CourseName</small>
        </div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Results" asp-route-id="@Model.Id"
           class="btn btn-sm px-3" style="border-radius:10px;background:rgba(51,239,160,0.15);color:#16a34a;font-size:0.83rem;font-weight:600;">
            <i class="fas fa-chart-bar me-1"></i>Results (@Model.AttemptCount)
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id"
           class="btn btn-sm px-3" style="border-radius:10px;background:rgba(91,114,238,0.12);color:var(--accent-purple);font-size:0.83rem;font-weight:600;">
            <i class="fas fa-edit me-1"></i>Edit Exam
        </a>
        <a asp-action="AddQuestion" asp-route-examId="@Model.Id"
           class="btn btn-primary btn-sm px-3" style="border-radius:10px;font-size:0.83rem;">
            <i class="fas fa-plus me-1"></i>Add Question
        </a>
    </div>
</div>

<!-- Exam Stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="p-3 rounded-3 text-center" style="background:white;box-shadow:0 2px 12px rgba(47,50,125,0.06);">
            <div style="font-size:1.5rem;font-weight:800;color:var(--primary);">@Model.DurationInMinutes</div>
            <small class="text-muted">Minutes</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-3 rounded-3 text-center" style="background:white;box-shadow:0 2px 12px rgba(47,50,125,0.06);">
            <div style="font-size:1.5rem;font-weight:800;color:var(--secondary);">@Model.TotalMarks</div>
            <small class="text-muted">Total Marks</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-3 rounded-3 text-center" style="background:white;box-shadow:0 2px 12px rgba(47,50,125,0.06);">
            <div style="font-size:1.5rem;font-weight:800;color:var(--accent-purple);">@Model.Questions.Count</div>
            <small class="text-muted">Questions</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-3 rounded-3 text-center" style="background:white;box-shadow:0 2px 12px rgba(47,50,125,0.06);">
            @if (Model.Deadline.HasValue)
            {
                <div style="font-size:0.9rem;font-weight:800;color:@(Model.Deadline < DateTime.Now ? "#E13468" : "#16a34a");">
                    @Model.Deadline.Value.ToString("MMM d")
                </div>
                <small class="text-muted">Deadline</small>
            }
            else
            {
                <div style="font-size:0.9rem;font-weight:800;color:#9ca3af;">No Limit</div>
                <small class="text-muted">Deadline</small>
            }
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Description))
{
    <div class="sa-card mb-4">
        <div class="sa-card-body">
            <p class="mb-0" style="font-size:0.875rem;color:#4b5563;">@Model.Description</p>
        </div>
    </div>
}

<!-- Question Bank -->
<div class="sa-card">
    <div class="sa-card-header">
        <h5><i class="fas fa-question-circle me-2" style="color:var(--accent-purple);"></i>Question Bank</h5>
        <a asp-action="AddQuestion" asp-route-examId="@Model.Id"
           class="btn btn-primary btn-sm px-3" style="border-radius:8px;font-size:0.8rem;">
            <i class="fas fa-plus me-1"></i>Add
        </a>
    </div>
    <div class="sa-card-body p-0">
        @if (!Model.Questions.Any())
        {
            <div class="text-center py-4 text-muted" style="font-size:0.875rem;">
                <i class="fas fa-question fa-2x mb-2 d-block" style="opacity:0.2;"></i>
                No questions yet. <a asp-action="AddQuestion" asp-route-examId="@Model.Id">Add the first question</a>.
            </div>
        }
        else
        {
            <div class="p-3 d-flex flex-column gap-3">
                @for (int i = 0; i < Model.Questions.Count; i++)
                {
                    var q = Model.Questions[i];
                    <div class="p-3 rounded-3" style="border:1.5px solid rgba(47,50,125,0.08);background:rgba(47,50,125,0.01);">
                        <div class="d-flex justify-content-between align-items-start">
                            <div style="flex:1;min-width:0;">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span style="width:24px;height:24px;border-radius:50%;background:var(--primary);color:white;font-size:0.7rem;font-weight:700;display:flex;align-items:center;justify-content:center;">@(i + 1)</span>
                                    <span class="sa-badge sa-badge-info">@q.QuestionType</span>
                                    <span class="sa-badge" style="background:rgba(244,140,6,0.12);color:var(--orange);">@q.Points pts</span>
                                </div>
                                <p style="font-size:0.875rem;font-weight:600;margin:0 0 0.5rem;">@q.Title</p>
                                @if (q.Choices.Any())
                                {
                                    <div class="d-flex flex-column gap-1">
                                        @foreach (var ch in q.Choices)
                                        {
                                            <div class="d-flex align-items-center gap-2" style="font-size:0.8rem;">
                                                <i class="fas @(ch.IsCorrect ? "fa-check-circle" : "fa-circle")"
                                                   style="color:@(ch.IsCorrect ? "#16a34a" : "#d1d5db");font-size:0.75rem;"></i>
                                                <span style="color:@(ch.IsCorrect ? "#16a34a" : "#4b5563");font-weight:@(ch.IsCorrect ? "600" : "400");">@ch.Title</span>
                                                @if (ch.IsCorrect)
                                                {
                                                    <span class="sa-badge sa-badge-active ms-1">Correct</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <form asp-action="DeleteQuestion" method="post" class="d-inline ms-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="questionId" value="@q.Id" />
                                <input type="hidden" name="examId" value="@Model.Id" />
                                <button type="button" class="sa-btn-icon sa-btn-delete" title="Remove" onclick="triggerDeleteModal(this)">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@await Html.PartialAsync("_DeleteModal")

@section Scripts {
    <script>
        function triggerDeleteModal(btn) {
            var form  = btn.closest('form');
            var row   = btn.closest('tr');
            var title = row ? (row.querySelector('[style*="font-weight:600"]') || row.querySelector('td:nth-child(1)')) : null;
            var name  = title ? title.textContent.trim().substring(0, 60) : 'this item';
            document.getElementById('deleteItemName').textContent = name;
            var confirmBtn = document.getElementById('deleteConfirmBtn');
            confirmBtn.onclick = function(e) { e.preventDefault(); form.submit(); };
            confirmBtn.href = '#';
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}