@{
    ViewData["Title"] = "AI Exam Generator";
    var existingFiles = ViewBag.Files as List<LMSProject.AI.Models.UploadedFile> ?? new();
}

<style>
    @@keyframes fadeSlideUp {
        from {
            opacity: 0;
            transform: translateY(20px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    .anim {
        animation: fadeSlideUp .4s ease;
    }

    .anim2 {
        animation: fadeSlideUp .4s .08s ease both;
    }

    .anim3 {
        animation: fadeSlideUp .4s .16s ease both;
    }

    /* Drop zone */
    .drop-zone {
        border: 2.5px dashed rgba(91,114,238,.25);
        border-radius: 16px;
        padding: 2.5rem 1.5rem;
        text-align: center;
        cursor: pointer;
        transition: all .2s;
        background: rgba(91,114,238,.03);
        position: relative;
    }

        .drop-zone:hover, .drop-zone.drag-over {
            border-color: var(--accent-purple, #5B72EE);
            background: rgba(91,114,238,.07);
        }

        .drop-zone input[type=file] {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer;
            width: 100%;
            height: 100%;
        }

    .drop-icon {
        font-size: 2.5rem;
        color: var(--accent-purple, #5B72EE);
        opacity: .5;
        margin-bottom: .75rem;
        display: block;
    }

    /* File queue items */
    .file-queue-item {
        display: flex;
        align-items: center;
        gap: .75rem;
        background: white;
        border: 1.5px solid rgba(0,0,0,.07);
        border-radius: 12px;
        padding: .7rem .9rem;
        margin-bottom: .5rem;
    }

    .file-type-icon {
        width: 36px;
        height: 36px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .9rem;
        flex-shrink: 0;
    }

    .file-progress-bar {
        height: 4px;
        border-radius: 10px;
        background: rgba(0,0,0,.07);
        overflow: hidden;
        margin-top: 4px;
    }

    .file-progress-fill {
        height: 100%;
        border-radius: 10px;
        transition: width .3s ease;
        background: linear-gradient(90deg, var(--accent-purple,#5B72EE), var(--secondary,#00CBB8));
    }

    .file-status {
        font-size: .7rem;
        font-weight: 600;
    }

        .file-status.ok {
            color: #16a34a;
        }

        .file-status.err {
            color: #E13468;
        }

        .file-status.upload {
            color: var(--accent-purple,#5B72EE);
        }

    /* Stored files list */
    .stored-file {
        display: flex;
        align-items: center;
        gap: .7rem;
        padding: .6rem .8rem;
        border-radius: 11px;
        background: #f8f9ff;
        border: 1.5px solid rgba(91,114,238,.1);
        margin-bottom: .5rem;
        cursor: pointer;
        transition: border-color .15s;
    }

        .stored-file:hover {
            border-color: var(--accent-purple,#5B72EE);
        }

        .stored-file.selected {
            border-color: var(--secondary,#00CBB8);
            background: rgba(0,203,184,.06);
        }

        .stored-file input[type=radio] {
            display: none;
        }

    /* Result area */
    .gen-result {
        white-space: pre-wrap;
        font-size: .87rem;
        line-height: 1.8;
        background: #f8f9ff;
        border-radius: 14px;
        padding: 1.3rem 1.5rem;
        border: 1.5px solid rgba(47,50,125,.08);
        max-height: 55vh;
        overflow-y: auto;
        font-family: 'Courier New', monospace;
    }

        .gen-result::-webkit-scrollbar {
            width: 5px;
        }

        .gen-result::-webkit-scrollbar-thumb {
            background: rgba(91,114,238,.2);
            border-radius: 5px;
        }

    /* Spinner */
    .gen-spinner {
        display: inline-block;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        border: 2px solid rgba(91,114,238,.2);
        border-top-color: var(--accent-purple,#5B72EE);
        animation: spin .6s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

<div class="row g-4">

    <!-- ── LEFT COLUMN: Upload + Files ──────────────────────────────── -->
    <div class="col-lg-5">

        <!-- Upload card -->
        <div class="iact-card anim mb-4">
            <div style="background:linear-gradient(135deg,var(--primary,#2F327D),var(--accent-purple,#5B72EE));
                border-radius:16px 16px 0 0;padding:1.1rem 1.4rem;
                display:flex;align-items:center;gap:.75rem;">
                <div style="width:38px;height:38px;border-radius:10px;background:rgba(255,255,255,.15);
                    display:flex;align-items:center;justify-content:center;">
                    <i class="fas fa-upload" style="color:white;font-size:.95rem;"></i>
                </div>
                <div>
                    <h6 style="color:white;font-weight:700;margin:0;font-size:.9rem;">Upload Materials</h6>
                    <small style="color:rgba(255,255,255,.7);font-size:.72rem;">PDF, DOCX, JPG, PNG</small>
                </div>
            </div>
            <div class="iact-card-body">

                <!-- Drop zone -->
                <div class="drop-zone" id="dropZone">
                    <input type="file" id="fileInput"
                           accept=".pdf,.doc,.docx,.jpg,.jpeg,.png"
                           multiple
                           onchange="handleFiles(this.files)" />
                    <i class="fas fa-cloud-upload-alt drop-icon"></i>
                    <div style="font-weight:700;color:var(--primary,#2F327D);font-size:.9rem;margin-bottom:.25rem;">
                        Drag &amp; drop files here
                    </div>
                    <div style="font-size:.78rem;color:#9ca3af;">
                        or click to browse &nbsp;·&nbsp; Multiple files supported
                    </div>
                </div>

                <!-- Upload queue -->
                <div id="uploadQueue" class="mt-3"></div>
                <div id="instrUploadStatus"
                     style="font-size:.8rem;margin-top:.75rem;font-weight:600;"></div>

                <!-- Upload button -->
                <button id="uploadBtn" onclick="startUpload()"
                        class="btn btn-primary w-100 rounded-3 mt-2"
                        style="font-family:Poppins,sans-serif;display:none;">
                    <i class="fas fa-upload me-2"></i>Upload All Files
                </button>
            </div>
        </div>

        <!-- Stored files card -->
        <div class="iact-card anim2">
            <div style="background:linear-gradient(135deg,var(--secondary,#00CBB8),var(--accent-blue,#29B9E7));
                border-radius:16px 16px 0 0;padding:1.1rem 1.4rem;
                display:flex;align-items:center;justify-content:space-between;">
                <div style="display:flex;align-items:center;gap:.75rem;">
                    <i class="fas fa-folder-open" style="color:white;font-size:1rem;"></i>
                    <h6 style="color:white;font-weight:700;margin:0;font-size:.9rem;">
                        My Files
                        <span id="fileCountBadge" style="background:rgba(255,255,255,.2);color:white;
                            border-radius:20px;padding:1px 8px;font-size:.7rem;margin-left:4px;">
                            @existingFiles.Count
                        </span>
                    </h6>
                </div>
                <button onclick="loadFiles()" class="btn btn-sm"
                        style="background:rgba(255,255,255,.15);color:white;border:none;border-radius:8px;
                    font-size:.75rem;font-family:Poppins,sans-serif;">
                    <i class="fas fa-sync-alt"></i>
                </button>
            </div>
            <div class="iact-card-body" style="max-height:300px;overflow-y:auto;">
                <div id="storedFiles">
                    @if (!existingFiles.Any())
                    {
                        <div style="text-align:center;color:#9ca3af;font-size:.8rem;padding:1.5rem 0;">
                            <i class="fas fa-folder-open d-block mb-2" style="font-size:1.5rem;opacity:.3;"></i>
                            No files uploaded yet.
                        </div>
                    }
                    else
                    {
                        @foreach (var f in existingFiles)
                        {
                            <label class="stored-file">
                                <input type="radio" name="selectedFile"
                                       value="@f.Id" onchange="selectFile('@f.Id', '@f.OriginalName')" />
                                <div style="width:32px;height:32px;border-radius:8px;
                                    background:rgba(91,114,238,.1);display:flex;
                                    align-items:center;justify-content:center;flex-shrink:0;">
                                    <i class="fas fa-file-alt" style="color:var(--accent-purple,#5B72EE);font-size:.82rem;"></i>
                                </div>
                                <div style="flex:1;min-width:0;">
                                    <div style="font-weight:600;font-size:.8rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                        @f.OriginalName
                                    </div>
                                    <div style="font-size:.68rem;color:#9ca3af;">
                                        @(Math.Round(f.FileSizeBytes / 1024.0, 1)) KB
                                        · @f.ChunkCount chunks
                                    </div>
                                </div>
                                <button type="button" class="btn-close" style="font-size:.6rem;"
                                        onclick="deleteFile('@f.Id', event)"></button>
                            </label>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ── RIGHT COLUMN: Generator ──────────────────────────────────── -->
    <div class="col-lg-7">
        <div class="iact-card anim3">
            <div style="background:linear-gradient(135deg,var(--accent-purple,#5B72EE),var(--secondary,#00CBB8));
                border-radius:16px 16px 0 0;padding:1.1rem 1.4rem;
                display:flex;align-items:center;gap:.75rem;">
                <div style="width:38px;height:38px;border-radius:10px;background:rgba(255,255,255,.15);
                    display:flex;align-items:center;justify-content:center;">
                    <i class="fas fa-magic" style="color:white;font-size:.95rem;"></i>
                </div>
                <div>
                    <h6 style="color:white;font-weight:700;margin:0;font-size:.9rem;">Generate Exam</h6>
                    <small id="selectedFileLabel" style="color:rgba(255,255,255,.7);font-size:.72rem;">
                        Select a file from the left panel
                    </small>
                </div>
            </div>
            <div class="iact-card-body">

                <!-- Selected file indicator -->
                <div id="selectedFileBanner" style="display:none;background:rgba(0,203,184,.07);
                    border:1.5px solid rgba(0,203,184,.2);border-radius:11px;
                    padding:.65rem 1rem;margin-bottom:1.1rem;
                    display:none;align-items:center;gap:.65rem;">
                    <i class="fas fa-file-check" style="color:var(--secondary,#00CBB8);"></i>
                    <span id="selectedFileName" style="font-size:.82rem;font-weight:600;"></span>
                </div>

                <!-- Options row -->
                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label" style="font-weight:600;font-size:.83rem;">
                            <i class="fas fa-question-circle me-1" style="color:var(--accent-purple,#5B72EE);"></i>
                            MCQ Questions
                        </label>
                        <input type="number" id="mcqCount" value="5" min="1" max="20"
                               class="iact-form-control" />
                        <small class="text-muted" style="font-size:.7rem;">Multiple choice (1–20)</small>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label" style="font-weight:600;font-size:.83rem;">
                            <i class="fas fa-check-circle me-1" style="color:var(--secondary,#00CBB8);"></i>
                            True / False
                        </label>
                        <input type="number" id="tfCount" value="3" min="0" max="10"
                               class="iact-form-control" />
                        <small class="text-muted" style="font-size:.7rem;">T/F statements (0–10)</small>
                    </div>
                </div>

                <!-- Generate button -->
                <button id="genBtn" onclick="generateExam()"
                        class="btn btn-primary w-100 rounded-3 mb-4"
                        style="font-family:Poppins,sans-serif;font-size:.9rem;padding:.75rem;" disabled>
                    <i class="fas fa-magic me-2"></i>Generate Exam
                </button>

                <!-- Spinner -->
                <div id="genSpinner" style="display:none;text-align:center;padding:2rem;color:#9ca3af;">
                    <div class="gen-spinner d-inline-block me-2"></div>
                    <span style="font-size:.88rem;">Generating exam questions with AI…</span>
                </div>

                <!-- Result -->
                <div id="genResultWrap" style="display:none;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 style="font-weight:700;color:var(--primary,#2F327D);margin:0;font-size:.88rem;">
                            <i class="fas fa-clipboard-list me-2" style="color:var(--secondary,#00CBB8);"></i>
                            Generated Exam
                        </h6>
                        <div class="d-flex gap-2">
                            <button onclick="copyResult()" class="btn btn-sm rounded-3"
                                    style="background:rgba(0,203,184,.1);color:var(--secondary,#00CBB8);
                                font-size:.75rem;font-family:Poppins,sans-serif;">
                                <i class="fas fa-copy me-1"></i>Copy
                            </button>
                            <button onclick="clearResult()" class="btn btn-sm rounded-3"
                                    style="background:rgba(225,52,104,.08);color:#E13468;
                                font-size:.75rem;font-family:Poppins,sans-serif;">
                                <i class="fas fa-times me-1"></i>Clear
                            </button>
                        </div>
                    </div>
                    <div class="gen-result" id="genResultText"></div>
                </div>

                <!-- Error state -->
                <div id="genError" style="display:none;background:rgba(225,52,104,.08);
                border-left:4px solid #E13468;border-radius:10px;
                padding:.9rem 1.1rem;margin-bottom:1rem;
                font-size:.85rem;color:#E13468;font-weight:600;"></div>

                <!-- Empty state -->
                <div id="genEmpty" style="text-align:center;padding:3rem 1rem;color:#9ca3af;">
                    <i class="fas fa-wand-magic-sparkles d-block mb-2" style="font-size:2.5rem;opacity:.2;"></i>
                    <p style="font-size:.85rem;margin:0;">
                        Upload a file and configure the exam settings,<br>then click Generate.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ── n8n-powered Exam Generator ────────────────────────────────────────
        // File stays in browser memory. Sent directly to n8n per generation.
        var selectedFile     = null;
        var selectedFileName = '';
        var selectedFileId   = null;   // set when user picks from stored files

        // ── Select a stored file (called from Razor radio buttons) ─────────
        function selectFile(fileId, fileName) {
            selectedFileId   = fileId;
            selectedFileName = fileName;
            // highlight selected row
            document.querySelectorAll('.stored-file')
                .forEach(function(el){ el.classList.remove('selected'); });
            var radio = document.querySelector('input[name="selectedFile"][value="' + fileId + '"]');
            if (radio) radio.closest('.stored-file').classList.add('selected');
            // show banner
            var banner = document.getElementById('selectedFileBanner');
            if (banner) banner.style.display = 'flex';
            var nameEl = document.getElementById('selectedFileLabel');
            if (nameEl) nameEl.textContent = fileName;
            // enable generate button
            var btn = document.getElementById('genBtn');
            if (btn) btn.disabled = false;
        }

        // ── Drop zone ─────────────────────────────────────────────────────
        var dz = document.getElementById('dropZone');
        if (dz) {
            dz.addEventListener('dragover',  function(e){ e.preventDefault(); dz.classList.add('drag-over'); });
            dz.addEventListener('dragleave', function()  { dz.classList.remove('drag-over'); });
            dz.addEventListener('drop', function(e) {
                e.preventDefault(); dz.classList.remove('drag-over');
                handleFiles(e.dataTransfer.files);
            });
        }

        async function handleFiles(fileList) {
            if (!fileList || !fileList.length) return;
            var file = fileList[0];
            if (!file.name.match(/\.(pdf|docx?|jpe?g|png)$/i)) {
                showStatus('❌ Only PDF, DOCX, JPG, PNG allowed', 'err');
                return;
            }
            selectedFile     = file;
            selectedFileName = file.name;

            // Upload to server immediately so we have a real fileId for n8n
            showStatus('⏳ Uploading ' + file.name + '...', 'ok');
            try {
                var uploadFd = new FormData();
                uploadFd.append('files', file, file.name);
                var upResp = await fetch('/Instructor/Ai/Upload', { method: 'POST', body: uploadFd });
                var upData = await upResp.json();
                var firstResult = upData.results && upData.results[0];
                if (firstResult && firstResult.ok) {
                    selectedFileId = firstResult.fileId;
                    showStatus('✅ ' + file.name + ' uploaded and ready!', 'ok');
                } else {
                    var errMsg = firstResult ? firstResult.message : 'Upload failed';
                    showStatus('⚠️ ' + errMsg, 'err');
                }
            } catch(e) {
                showStatus('⚠️ Upload error: ' + e.message, 'err');
            }

            // renderFile();
            document.getElementById('uploadBtn').style.display = 'none';
            document.getElementById('genBtn').disabled = false;
            document.getElementById('genEmpty').style.display = 'none';
            document.getElementById('selectedFileBanner').style.display = 'flex';
            document.getElementById('selectedFileName').textContent = file.name;
            document.getElementById('selectedFileLabel').textContent = file.name;
        }

        // Allow input[type=file] change
        document.getElementById('fileInput')?.addEventListener('change', function() {
            handleFiles(this.files);
        });

        function renderFile() {
            var el = document.getElementById('storedFiles');
            if (!selectedFile) {
                el.innerHTML = '<div style="text-align:center;color:#9ca3af;font-size:.8rem;padding:1.5rem 0;">' +
                               '<i class="fas fa-folder-open d-block mb-2" style="font-size:1.5rem;opacity:.3;"></i>' +
                               'No file loaded yet.</div>';
                document.getElementById('fileCountBadge').textContent = '0';
                return;
            }
            var kb = Math.round(selectedFile.size / 1024);
            el.innerHTML = '<label class="stored-file selected" id="sf_current">' +
                '<div style="width:32px;height:32px;border-radius:8px;background:rgba(91,114,238,.1);' +
                'display:flex;align-items:center;justify-content:center;flex-shrink:0;">' +
                '<i class="fas fa-file-alt" style="color:var(--accent-purple,#5B72EE);font-size:.82rem;"></i></div>' +
                '<div style="flex:1;min-width:0;">' +
                '<div style="font-weight:600;font-size:.8rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + esc(selectedFileName) + '</div>' +
                '<div style="font-size:.68rem;color:#9ca3af;">' + kb + ' KB · ready</div>' +
                '</div>' +
                '<button type="button" class="btn-close" style="font-size:.6rem;" onclick="event.stopPropagation();clearFile()"></button>' +
                '</label>';
            document.getElementById('fileCountBadge').textContent = '1';
        }

        function clearFile() {
            selectedFile = null; selectedFileName = ''; selectedFileId = null;
            renderFile();
            document.getElementById('genBtn').disabled = true;
            document.getElementById('selectedFileBanner').style.display = 'none';
            document.getElementById('selectedFileLabel').textContent = 'Select a file from the left panel';
            document.getElementById('genEmpty').style.display = 'block';
            document.getElementById('genResultWrap').style.display = 'none';
        }

        function showStatus(msg, type) {
            var el = document.getElementById('instrUploadStatus');
            if (!el) return;
            el.innerHTML = '<span style="color:' + (type === 'ok' ? '#16a34a' : '#E13468') + ';">' + esc(msg) + '</span>';
        }

        // ── Generate exam via n8n ─────────────────────────────────────────
                async function generateExam() {

            if (!selectedFile && !selectedFileId) {
                showGenError('Please upload or select a file first.');
                return;
            }

            var mcq = parseInt(document.getElementById('mcqCount').value) || 5;
            var tf  = parseInt(document.getElementById('tfCount').value)  || 3;
            var btn = document.getElementById('genBtn');

            btn.disabled = true;
            btn.innerHTML = '<span class="gen-spinner d-inline-block me-2"></span>Generating...';

            document.getElementById('genSpinner').style.display    = 'block';
            document.getElementById('genResultWrap').style.display = 'none';
            document.getElementById('genEmpty').style.display      = 'none';
            document.getElementById('genError').style.display      = 'none';

            try {

                var fd = new FormData();

                // CASE 1 → freshly uploaded file in browser memory
                if (selectedFile) {

                    fd.append('file', selectedFile, selectedFile.name);

                }
                // CASE 2 → old stored file from DB
                else {

                    var fileResp = await fetch('/Instructor/Ai/GetFileBytes?fileId=' + encodeURIComponent(selectedFileId));

                    if (!fileResp.ok) {
                        showGenError('Could not retrieve stored file.');
                        return;
                    }

                    var blob = await fileResp.blob();

                    fd.append(
                        'file',
                        new File([blob], selectedFileName || 'document.pdf', {
                            type: blob.type
                        })
                    );
                }

                fd.append('mcqCount', mcq);
                fd.append('tfCount', tf);

                // SEND TO YOUR API PROXY
                var resp = await fetch('/api/ai/generate-exam', {
                    method: 'POST',
                    body: fd
                });

                var raw = await resp.text();

                console.log('RAW RESPONSE:', raw);

                if (!resp.ok) {
                    showGenError(raw || 'Generation failed.');
                    return;
                }

                // try parse json
                try {

                    var json = JSON.parse(raw);

                    if (json.output)
                        raw = json.output;

                    else if (json.result)
                        raw = json.result;

                } catch { }

                raw = (raw || '').trim();

                if (!raw) {
                    showGenError('Empty response from AI.');
                    return;
                }

                document.getElementById('genResultText').textContent = raw;
                document.getElementById('genResultWrap').style.display = 'block';

            }
            catch (e) {

                console.error(e);
                showGenError('Network error: ' + e.message);

            }
            finally {

                document.getElementById('genSpinner').style.display = 'none';

                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-magic me-2"></i>Generate Exam';
            }
        }

                function showGenError(msg) {
            var el = document.getElementById('genError');
            if (el) { el.textContent = '⚠ ' + msg; el.style.display = 'block'; }
            document.getElementById('genSpinner').style.display = 'none';
            var btn = document.getElementById('genBtn');
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-magic me-2"></i>Generate Exam';
        }

        function copyResult() {
            navigator.clipboard.writeText(document.getElementById('genResultText').textContent)
                .then(function() { alert('Copied!'); });
        }
        function clearResult() {
            document.getElementById('genResultWrap').style.display = 'none';
            document.getElementById('genEmpty').style.display = 'block';
        }
        function esc(s) {
            return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        // Auto-render on load
        renderFile();
    </script>
}