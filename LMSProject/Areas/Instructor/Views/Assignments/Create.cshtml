@model LMSProject.Areas.Instructor.ViewModel.CreateAssignmentVM
@using MLSCore.Models
@{
    ViewData["Title"] = "Create Assignment";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="d-flex align-items-center gap-2 mb-4">
            <a asp-action="Index" class="sa-btn-icon sa-btn-view"><i class="fas fa-arrow-left"></i></a>
            <div>
                <h5 class="mb-0 fw-bold" style="color:var(--primary);">Create Assignment</h5>
                <small class="text-muted">Define the task and submission requirements</small>
            </div>
        </div>

        <div class="sa-card">
            <div class="sa-card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="sa-form-control" placeholder="e.g. Essay on Climate Change" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description / Instructions</label>
                        <textarea asp-for="Description" class="sa-form-control" rows="4"
                                  placeholder="Describe the assignment requirements, questions, or guidelines..."></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Course <span class="text-danger">*</span></label>
                            <select asp-for="CourseId" class="sa-form-control">
                                <option value="">— Select Course —</option>
                                @foreach (var c in Model.Courses)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CourseId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Total Marks <span class="text-danger">*</span></label>
                            <input asp-for="TotalMarks" type="number" min="1" step="0.5" class="sa-form-control" />
                            <span asp-validation-for="TotalMarks" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Deadline <span class="text-danger">*</span></label>
                        <input asp-for="Deadline" type="datetime-local" class="sa-form-control"
                               value="@Model.Deadline.ToString("yyyy-MM-ddTHH:mm")" />
                        <span asp-validation-for="Deadline" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Submission Type <span class="text-danger">*</span></label>
                        <div class="d-flex gap-2 flex-wrap">
                            @foreach (SubmissionType type in Enum.GetValues(typeof(SubmissionType)))
                            {
                                var (icon, color, desc) = type switch
                                {
                                    SubmissionType.TextOnly => ("fa-pen",       "#5B72EE", "Text answer only"),
                                    SubmissionType.FileOnly => ("fa-paperclip", "#F48C06", "File upload only"),
                                    _                       => ("fa-layer-group","#29B9E7", "Text + File upload")
                                };
                                <label class="d-flex align-items-center gap-2 px-3 py-2 rounded-3 sub-type"
                                       style="border:1.5px solid rgba(47,50,125,0.12);cursor:pointer;flex:1;min-width:140px;">
                                    <input type="radio" asp-for="SubmissionType" value="@((int)type)"
                                           style="display:none;" onchange="handleSubType()">
                                    <i class="fas @icon" style="color:@color;"></i>
                                    <div>
                                        <div style="font-size:0.83rem;font-weight:600;">@type</div>
                                        <div style="font-size:0.7rem;color:#9ca3af;">@desc</div>
                                    </div>
                                </label>
                            }
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <a asp-action="Index" class="btn-secondary-sa">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4" style="border-radius:10px;">
                            <i class="fas fa-save me-2"></i>Create Assignment
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function handleSubType() {
        document.querySelectorAll('input[name="SubmissionType"]').forEach(r => {
            r.closest('label').style.borderColor = r.checked ? 'var(--secondary)' : 'rgba(47,50,125,0.12)';
            r.closest('label').style.background = r.checked ? 'rgba(0,203,184,0.06)' : '';
        });
    }
    document.addEventListener('DOMContentLoaded', () => {
        const radios = document.querySelectorAll('input[name="SubmissionType"]');
        // default to "Both" (index 2)
        if (radios.length > 2) { radios[2].checked = true; }
        handleSubType();
    });
</script>
}
