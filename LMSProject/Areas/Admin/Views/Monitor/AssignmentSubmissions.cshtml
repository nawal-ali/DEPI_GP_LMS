@model LMSProject.Areas.Admin.ViewModels.AssignmentSubmissionsVM
@{
    ViewData["Title"] = "Submissions — " + Model.Assignment.Title;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 style="font-weight:700;color:var(--primary);margin:0;">@Model.Assignment.Title</h5>
        <small style="color:#9ca3af;">
            @Model.Assignment.Course?.Name &nbsp;|&nbsp;
            Deadline: @Model.Assignment.Deadline.ToString("MMM dd, yyyy") &nbsp;|&nbsp;
            @Model.Assignment.TotalMarks pts
        </small>
    </div>
    <a asp-area="Admin" asp-controller="Monitor" asp-action="Assignments" class="btn-secondary-sa btn btn-sm">← Back</a>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="sa-stat-card grad-1"><p>Enrolled</p><h3>@Model.TotalEnrolled</h3><i class="fas fa-users stat-icon"></i></div></div>
    <div class="col-6 col-md-3"><div class="sa-stat-card grad-2"><p>Submitted</p><h3>@Model.Submissions.Count</h3><i class="fas fa-inbox stat-icon"></i></div></div>
    <div class="col-6 col-md-3"><div class="sa-stat-card grad-4"><p>Graded</p><h3>@Model.Submissions.Count(s => s.IsGraded)</h3><i class="fas fa-check-circle stat-icon"></i></div></div>
    <div class="col-6 col-md-3"><div class="sa-stat-card grad-6"><p>Late Submissions</p><h3>@Model.Submissions.Count(s => s.IsLate)</h3><i class="fas fa-clock stat-icon"></i></div></div>
</div>

<!-- Submissions list -->
<div class="sa-card">
    <div class="sa-card-header">
        <h5><i class="fas fa-inbox me-2" style="color:var(--accent-purple);"></i>Student Submissions</h5>
    </div>
    @if (!Model.Submissions.Any())
    {
        <div class="sa-card-body text-center py-5" style="color:#aaa;">
            <i class="fas fa-inbox fa-2x mb-2 d-block opacity-25"></i>No submissions yet.
        </div>
    }
    else
    {
        <div class="sa-card-body p-0">
            @foreach (var s in Model.Submissions)
            {
                <div style="padding:18px 20px;border-bottom:1px solid rgba(0,0,0,0.05);">
                    <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
                        <div class="d-flex align-items-center gap-3">
                            <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--accent-purple),var(--accent-blue));display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:0.8rem;flex-shrink:0;">
                                @(s.StudentName.Length >= 2 ? s.StudentName[..2].ToUpper() : s.StudentName.ToUpper())
                            </div>
                            <div>
                                <div style="font-weight:600;font-size:0.88rem;">@s.StudentName</div>
                                <small style="color:#9ca3af;font-size:0.75rem;">
                                    Submitted: @(s.SubmittedAt?.ToString("MMM dd, HH:mm") ?? "—")
                                    @if (s.IsLate)
                                    {
                                        <span class="sa-badge sa-badge-inactive ms-1" style="font-size:0.68rem;">Late</span>
                                    }
                                </small>
                            </div>
                        </div>
                        @if (s.IsGraded)
                        {
                            <span class="sa-badge sa-badge-active" style="padding:5px 14px;font-size:0.8rem;">
                                @s.Marks / @Model.Assignment.TotalMarks pts
                            </span>
                        }
                        else
                        {
                            <span class="sa-badge sa-badge-pending" style="padding:5px 14px;font-size:0.8rem;">Pending Grade</span>
                        }
                    </div>

                    <div class="mt-3 ps-5">
                        @if (!string.IsNullOrEmpty(s.TextAnswer))
                        {
                            <div class="p-3 rounded-3 mb-2" style="background:rgba(91,114,238,0.04);border-left:3px solid var(--accent-purple);">
                                <small style="font-weight:600;color:var(--accent-purple);display:block;margin-bottom:4px;">Text Answer</small>
                                <p style="margin:0;font-size:0.87rem;color:#555;line-height:1.6;">@s.TextAnswer</p>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(s.FileUrl))
                        {
                            <a href="~/@s.FileUrl" target="_blank"
                               class="d-inline-flex align-items-center gap-2 p-2 rounded-3 text-decoration-none mb-2"
                               style="background:rgba(51,239,160,0.08);color:#16a34a;font-size:0.83rem;font-weight:600;">
                                <i class="fas fa-paperclip"></i>@(s.FileName ?? "Download File")
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(s.Feedback))
                        {
                            <div class="p-3 rounded-3" style="background:rgba(0,203,184,0.06);border-left:3px solid var(--secondary);">
                                <small style="font-weight:600;color:var(--secondary);display:block;margin-bottom:4px;">Instructor Feedback</small>
                                <p style="margin:0;font-size:0.85rem;color:#555;">@s.Feedback</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
