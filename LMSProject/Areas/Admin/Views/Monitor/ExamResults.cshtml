@using MLSCore.Models
@{
    ViewData["Title"] = "Exam Results";
    var exam = ViewBag.Exam as TbTest;
    var results = ViewBag.Results as List<TbStudentTest> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 style="font-weight:700;color:var(--primary);margin:0;">@exam?.Title</h5>
        <small style="color:#9ca3af;">Total Marks: @exam?.TotalMarks &nbsp;|&nbsp; Duration: @exam?.DurationInMinutes min</small>
    </div>
    <a asp-area="Admin" asp-controller="Monitor" asp-action="Exams" class="btn-secondary-sa btn btn-sm">← Back</a>
</div>

<!-- Summary stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="sa-stat-card grad-1"><p>Total Attempts</p><h3>@results.Count</h3><i class="fas fa-users stat-icon"></i></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="sa-stat-card grad-2"><p>Average Score</p><h3>@(results.Any() ? results.Average(r => r.Score).ToString("F1") : "0")</h3><i class="fas fa-chart-line stat-icon"></i></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="sa-stat-card grad-4"><p>Highest Score</p><h3>@(results.Any() ? results.Max(r => r.Score).ToString("F0") : "0")</h3><i class="fas fa-trophy stat-icon"></i></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="sa-stat-card grad-6"><p>Pass Rate</p><h3>@(results.Any() && exam != null ? ((int)((double)results.Count(r => r.Score >= exam.TotalMarks * 0.5) / results.Count * 100)).ToString() + "%" : "—")</h3><i class="fas fa-award stat-icon"></i></div>
    </div>
</div>

<div class="sa-card">
    <div class="table-responsive">
        <table class="sa-table">
            <thead>
                <tr><th>Student</th><th>Score</th><th>Percentage</th><th>Result</th></tr>
            </thead>
            <tbody>
                @foreach (var r in results)
                {
                    double pct = exam != null && exam.TotalMarks > 0 ? r.Score / exam.TotalMarks * 100 : 0;
                    bool pass = pct >= 50;
                    <tr>
                        <td style="font-weight:600;">@(r.Student?.FullName ?? "Unknown")</td>
                        <td>
                            <span style="font-weight:700;font-size:1rem;color:var(--primary);">@r.Score</span>
                            <small style="color:#9ca3af;"> / @exam?.TotalMarks</small>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:80px;height:7px;background:rgba(0,0,0,0.06);border-radius:10px;overflow:hidden;">
                                    <div style="height:100%;width:@((int)pct)%;background:@(pass ? "var(--accent-green)" : "var(--accent-pink)");border-radius:10px;"></div>
                                </div>
                                <small style="font-weight:600;">@pct.ToString("F0")%</small>
                            </div>
                        </td>
                        <td>
                            @if (pass)
                            {
                                <span class="sa-badge sa-badge-active">Pass</span>
                            }
                            else
                            {

                                <span class="sa-badge sa-badge-inactive">Fail</span>
                            }
                        </td>
                    </tr>
                }
                @if (!results.Any())
                {
                    <tr><td colspan="4" class="text-center py-5 text-muted"><i class="fas fa-inbox fa-2x d-block mb-2 opacity-25"></i>No attempts yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
