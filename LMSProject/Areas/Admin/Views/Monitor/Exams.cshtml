@model List<LMSProject.Areas.Admin.ViewModels.ExamMonitorVM>
@{
    ViewData["Title"] = "Content Monitor — Exams";
    var courses = ViewBag.Courses as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 style="font-weight:700;color:var(--primary);margin:0;">
        <i class="fas fa-file-alt me-2" style="color:var(--secondary);"></i>Exams Monitor
        <span class="sa-badge sa-badge-info ms-2">@Model.Count</span>
    </h5>
</div>

<form method="get" asp-action="Exams">
    <div class="sa-filters">
        <div class="search-wrap flex-grow-1">
            <i class="fas fa-search"></i>
            <input name="search" class="form-control" placeholder="Search exams…" value="@ViewBag.SearchTerm" />
        </div>
        <select name="courseId" class="form-select" style="width:auto;" onchange="this.form.submit()">
            <option value="0">All Courses</option>
            @foreach (var c in courses)
            {
                <option value="@c.Id" selected="@((int)ViewBag.CourseId == (int)c.Id ? "selected" : null)">@c.Name</option>
            }
        </select>
        <button type="submit" class="btn btn-sm btn-primary rounded-3 px-3"><i class="fas fa-filter me-1"></i>Filter</button>
        <a asp-action="Exams" class="btn-secondary-sa btn btn-sm"><i class="fas fa-times me-1"></i>Clear</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="sa-card p-5 text-center" style="color:#aaa;">
        <i class="fas fa-file-alt fa-3x mb-3 d-block opacity-25"></i>No exams found.
    </div>
}
else
{
    <div class="sa-card">
        <div class="table-responsive">
            <table class="sa-table">
                <thead>
                    <tr><th>Exam</th><th>Course</th><th>Deadline</th><th>Marks</th><th>Duration</th><th>Questions</th><th>Attempts</th><th>Avg Score</th><th>Status</th><th>Action</th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td style="font-weight:600;font-size:0.875rem;">@e.Title</td>
                            <td><span class="sa-badge sa-badge-info">@e.CourseName</span></td>
                            <td style="font-size:0.82rem;">
                                @(e.Deadline?.ToString("MMM dd, yyyy") ?? "—")
                                @if (e.IsExpired)
                                {
                                    <span class="sa-badge sa-badge-inactive ms-1" style="font-size:0.68rem;">Expired</span>
                                }
                            </td>
                            <td><span style="font-weight:700;color:var(--primary);">@e.TotalMarks</span></td>
                            <td style="font-size:0.83rem;">@e.DurationMinutes min</td>
                            <td><span class="sa-badge sa-badge-purple">@e.QuestionCount</span></td>
                            <td><span class="sa-badge sa-badge-info">@e.AttemptCount</span></td>
                            <td>
                                <span style="font-weight:600;color:@(e.AverageScore >= e.TotalMarks * 0.6 ? "#16a34a" : "var(--accent-pink)");">
                                    @e.AverageScore.ToString("F1")
                                </span>
                            </td>
                            <td>
                                @if (e.IsExpired)
                                {
                                    <span class="sa-badge sa-badge-inactive">Expired</span>
                                }
                                else
                                {

                                    <span class="sa-badge sa-badge-active">Active</span>
                                }
                            </td>
                            <td>
                                <a asp-area="Admin" asp-controller="Monitor" asp-action="ExamResults"
                                   asp-route-examId="@e.Id"
                                   class="sa-btn-icon sa-btn-view" title="View Results">
                                    <i class="fas fa-chart-bar"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
