@using MLSCore.Models
@model IEnumerable<TbGrade>
@{
    ViewData["Title"] = "Grades";
    var grades = Model.ToList();
}

<style>
@@keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(22px); }
    to   { opacity: 1; transform: translateY(0); }
}
.grade-row {
    animation: fadeSlideUp .35s ease both;
}
@for (int ai = 0; ai < 30; ai++) {
    <text>.grade-row:nth-child(@(ai + 1)) { animation-delay: @(ai * 0.045)s; }</text>
}
.grade-letter {
    width: 44px; height: 44px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 1.1rem; color: white;
    text-transform: uppercase; flex-shrink: 0;
}
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 style="font-weight:700;color:var(--primary);margin:0;">
        <i class="fas fa-graduation-cap me-2" style="color:var(--secondary);"></i>Grades
        <span class="sa-badge sa-badge-info ms-2">@grades.Count</span>
    </h5>
    <a asp-area="Admin" asp-controller="Grade" asp-action="Create"
       class="btn btn-primary btn-sm rounded-3 px-3">
        <i class="fas fa-plus me-1"></i> Add Grade
    </a>
</div>

@if (!grades.Any())
{
    <div class="sa-card p-5 text-center" style="color:#aaa;animation:fadeSlideUp .4s ease;">
        <i class="fas fa-graduation-cap fa-3x mb-3 d-block opacity-25"></i>
        <p class="mb-0">No grades yet. Click <strong>Add Grade</strong> to create one.</p>
    </div>
}
else
{
    <div class="sa-card">
        <div class="table-responsive">
            <table class="sa-table">
                <thead>
                    <tr>
                        <th style="width:60px;"></th>
                        <th>Grade Name</th>
                        <th>Stage</th>
                        <th>Created By</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var gradients = new[]
                        {
                            "linear-gradient(135deg,#29B9E7,#5B72EE)",
                            "linear-gradient(135deg,#00CBB8,#29B9E7)",
                            "linear-gradient(135deg,#5B72EE,#E13468)",
                            "linear-gradient(135deg,#2F327D,#00CBB8)",
                            "linear-gradient(135deg,#F48C06,#FDCB6E)",
                            "linear-gradient(135deg,#E13468,#5B72EE)",
                        };
                        int gi = 0;
                    }
                    @foreach (var grade in grades)
                    {
                        var letter   = string.IsNullOrEmpty(grade.Name) ? "?" : grade.Name[0].ToString();
                        var gradient = gradients[gi++ % gradients.Length];
                        <tr class="grade-row">
                            <td>
                                <div class="grade-letter" style="background:@gradient;">
                                    @letter
                                </div>
                            </td>
                            <td style="font-weight:600;font-size:.9rem;">@grade.Name</td>
                            <td>
                                @if (grade.Stage != null)
                                {
                                    <span class="sa-badge sa-badge-purple">@grade.Stage.Name</span>
                                }
                                else
                                {
                                    <span style="color:#aaa;font-size:.83rem;">—</span>
                                }
                            </td>
                            <td style="color:#6c757d;font-size:.84rem;">@(grade.CreatedBy ?? "—")</td>
                            <td>
                                @if (grade.CurrentState == 1)
                                { <span class="sa-badge sa-badge-active">Active</span> }
                                else
                                { <span class="sa-badge sa-badge-inactive">Inactive</span> }
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-area="Admin" asp-controller="Grade" asp-action="Edit"
                                       asp-route-id="@grade.Id"
                                       class="sa-btn-icon sa-btn-edit" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button type="button"
                                            class="sa-btn-icon sa-btn-delete"
                                            title="Delete"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal"
                                            data-delete-url="/Admin/Grade/Delete?Id=@grade.Id"
                                            data-delete-name="@grade.Name">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@await Html.PartialAsync("_DeleteModal")
