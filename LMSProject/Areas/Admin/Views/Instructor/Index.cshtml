@model LMSProject.Areas.Admin.ViewModels.UserListVM<LMSProject.Areas.Admin.ViewModels.InstructorListItemVM>
@{
    ViewData["Title"] = "Users — Instructors";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 style="font-weight:700;color:var(--primary);margin:0;">
        <i class="fas fa-chalkboard-teacher me-2" style="color:var(--secondary);"></i>Instructors
        <span class="sa-badge sa-badge-info ms-2">@Model.TotalCount</span>
    </h5>
    <small class="text-muted" style="font-size:0.8rem;"><i class="fas fa-info-circle me-1"></i>Only SuperAdmin can create accounts</small>
</div>

<form method="get" asp-action="Instructors">
    <div class="sa-filters">
        <div class="search-wrap">
            <i class="fas fa-search"></i>
            <input name="search" class="form-control" placeholder="Search instructors…" value="@Model.SearchTerm" />
        </div>
        <select name="status" class="form-select" style="width:auto;" onchange="this.form.submit()">
            <option value="">All Statuses</option>
            <option value="active" selected="@(Model.FilterStatus == "active" ? "selected" : null)">Active</option>
            <option value="inactive" selected="@(Model.FilterStatus == "inactive" ? "selected" : null)">Inactive</option>
        </select>
        <button type="submit" class="btn btn-sm btn-primary rounded-3 px-3"><i class="fas fa-filter me-1"></i>Filter</button>
        <a asp-action="Instructors" class="btn-secondary-sa btn btn-sm"><i class="fas fa-times me-1"></i>Clear</a>
    </div>
</form>

<div class="sa-card">
    <div class="table-responsive">
        <table class="sa-table">
            <thead><tr><th>Instructor</th><th>Specialization</th><th>Email</th><th>Phone</th><th>Experience</th><th>Courses</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var i in Model.Paged)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(i.ImageName))
                                {
                                    <img src="~/@i.ImageName" style="width:36px;height:36px;border-radius:50%;object-fit:cover;flex-shrink:0;" />
                                }
                                else
                                {
                                    <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--accent-blue),var(--secondary));display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:0.75rem;flex-shrink:0;">@i.Initials</div>
                                }
                                <span style="font-weight:600;font-size:0.875rem;">@i.FullName</span>
                            </div>
                        </td>
                        <td><span class="sa-badge sa-badge-purple">@i.Specialization</span></td>
                        <td style="font-size:0.82rem;color:#6c757d;">@i.Email</td>
                        <td style="font-size:0.82rem;">@i.Phone</td>
                        <td><span style="font-weight:600;color:var(--primary);">@i.ExperienceYears</span> yrs</td>
                        <td><span class="sa-badge sa-badge-info">@i.CourseCount</span></td>
                        <td>
                            @if (i.CurrentState == 1)
                            {
                                <span class="sa-badge sa-badge-active">Active</span>
                            }
                            else
                            {

                                <span class="sa-badge sa-badge-inactive">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="EditInstructor" asp-route-id="@i.Id" class="sa-btn-icon sa-btn-edit" title="Edit"><i class="fas fa-edit"></i></a>
                                <form asp-action="DeactivateInstructor" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@i.Id" />
                                    <button type="submit" class="sa-btn-icon @(i.CurrentState == 1 ? "sa-btn-delete" : "sa-btn-add")" title="@(i.CurrentState == 1 ? "Deactivate" : "Activate")">
                                        <i class="fas @(i.CurrentState == 1 ? "fa-ban" : "fa-check")"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Paged.Any())
                {
                    <tr><td colspan="8" class="text-center py-5 text-muted"><i class="fas fa-search fa-2x d-block mb-2 opacity-25"></i>No instructors found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <div class="sa-pagination">
        <a asp-action="Instructors" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.FilterStatus" class="sa-page-btn @(Model.CurrentPage == 1 ? "disabled" : "")"><i class="fas fa-chevron-left"></i></a>
        @for (int p = 1; p <= Model.TotalPages; p++)
        {
            <a asp-action="Instructors" asp-route-page="@p" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.FilterStatus" class="sa-page-btn @(p == Model.CurrentPage ? "active" : "")">@p</a>
        }
        <a asp-action="Instructors" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.FilterStatus" class="sa-page-btn @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")"><i class="fas fa-chevron-right"></i></a>
    </div>
}
