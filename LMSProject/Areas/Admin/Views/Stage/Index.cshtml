@using MLSCore.Models
@model IEnumerable<TbStage>
@{
    ViewData["Title"] = "Stages";
    var stages = Model.ToList();
}

<style>
/* ── Stage card animations ──────────────────────────────── */
@@keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(22px); }
    to   { opacity: 1; transform: translateY(0); }
}
.stage-row {
    animation: fadeSlideUp .35s ease both;
}
@for (int ai = 0; ai < 20; ai++) {
    <text>.stage-row:nth-child(@(ai+1)) { animation-delay: @(ai * 0.05)s; }</text>
}

/* ── Letter icon ────────────────────────────────────────── */
.stage-letter {
    width: 44px; height: 44px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 1.1rem; color: white; flex-shrink: 0;
    text-transform: uppercase; letter-spacing: 0;
}
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 style="font-weight:700;color:var(--primary);margin:0;">
        <i class="fas fa-layer-group me-2" style="color:var(--secondary);"></i>Stages
        <span class="sa-badge sa-badge-info ms-2">@stages.Count</span>
    </h5>
    <a asp-area="Admin" asp-controller="Stage" asp-action="Create"
       class="btn btn-primary btn-sm rounded-3 px-3">
        <i class="fas fa-plus me-1"></i> Add Stage
    </a>
</div>

@if (!stages.Any())
{
    <div class="sa-card p-5 text-center" style="color:#aaa;animation:fadeSlideUp .4s ease;">
        <i class="fas fa-layer-group fa-3x mb-3 d-block opacity-25"></i>
        <p class="mb-0">No stages yet. Click <strong>Add Stage</strong> to create one.</p>
    </div>
}
else
{
    <div class="sa-card">
        <div class="table-responsive">
            <table class="sa-table">
                <thead>
                    <tr>
                        <th style="width:60px;"></th>
                        <th>Stage Name</th>
                        <th>Created By</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        // Gradient palette for letter icons
                        var gradients = new[]
                        {
                            "linear-gradient(135deg,#5B72EE,#29B9E7)",
                            "linear-gradient(135deg,#00CBB8,#33EFA0)",
                            "linear-gradient(135deg,#E13468,#F48C06)",
                            "linear-gradient(135deg,#2F327D,#5B72EE)",
                            "linear-gradient(135deg,#F48C06,#FDCB6E)",
                            "linear-gradient(135deg,#29B9E7,#00CBB8)",
                        };
                        int gi = 0;
                    }
                    @foreach (var stage in stages)
                    {
                        var letter   = string.IsNullOrEmpty(stage.Name) ? "?" : stage.Name[0].ToString();
                        var gradient = gradients[gi++ % gradients.Length];
                        <tr class="stage-row">
                            <td>
                                <div class="stage-letter" style="background:@gradient;">
                                    @letter
                                </div>
                            </td>
                            <td style="font-weight:600;font-size:.9rem;">@stage.Name</td>
                            <td style="color:#6c757d;font-size:.84rem;">@(stage.CreatedBy ?? "—")</td>
                            <td>
                                @if (stage.CurrentState == 1)
                                { <span class="sa-badge sa-badge-active">Active</span> }
                                else
                                { <span class="sa-badge sa-badge-inactive">Inactive</span> }
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-area="Admin" asp-controller="Stage" asp-action="Edit"
                                       asp-route-id="@stage.Id"
                                       class="sa-btn-icon sa-btn-edit" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button type="button"
                                            class="sa-btn-icon sa-btn-delete"
                                            title="Delete"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal"
                                            data-delete-url="/Admin/Stage/Delete?Id=@stage.Id"
                                            data-delete-name="@stage.Name">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@await Html.PartialAsync("_DeleteModal")
