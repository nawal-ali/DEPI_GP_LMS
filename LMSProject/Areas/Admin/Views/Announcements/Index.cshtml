@model LMSProject.Areas.Admin.ViewModels.AnnouncementListVM
@{
    ViewData["Title"] = "Announcements";
    var priorities = new[] { "Urgent", "High", "Medium", "Low" };
    var audiences = new[] { "All", "Students", "Parents", "Instructors", "Admins" };
    var categories = new[] { "General", "Academic", "Event", "Holiday", "Maintenance", "Alert", "Update" };

    string PBorderColor(string p) => p switch
    {
        "Urgent" => "var(--accent-pink)",
        "High" => "var(--orange)",
        "Low" => "var(--accent-green)",
        _ => "var(--primary)"
    };
    string PGrad(string p) => p switch
    {
        "Urgent" => "linear-gradient(135deg,var(--accent-pink),var(--orange))",
        "High" => "linear-gradient(135deg,var(--orange),var(--yellow))",
        "Low" => "linear-gradient(135deg,var(--accent-green),var(--accent-blue))",
        _ => "linear-gradient(135deg,var(--primary),var(--secondary))"
    };
    int ps = Model.PageSize;
    var paged = Model.Filtered.Skip((Model.CurrentPage - 1) * ps).Take(ps).ToList();
}

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="sa-stat-card grad-1"><p>Total</p><h3>@Model.Items.Count</h3><i class="fas fa-bullhorn stat-icon"></i></div></div>
    <div class="col-6 col-md-3"><div class="sa-stat-card grad-2"><p>Active</p><h3>@Model.TotalActive</h3><i class="fas fa-check-circle stat-icon"></i></div></div>
    <div class="col-6 col-md-3"><div class="sa-stat-card grad-3"><p>Pinned</p><h3>@Model.TotalPinned</h3><i class="fas fa-thumbtack stat-icon"></i></div></div>
    <div class="col-6 col-md-3"><div class="sa-stat-card grad-6"><p>Urgent</p><h3>@Model.TotalUrgent</h3><i class="fas fa-exclamation-circle stat-icon"></i></div></div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 style="font-weight:700;color:var(--primary);margin:0;">
        <i class="fas fa-bullhorn me-2" style="color:var(--secondary);"></i>Announcements
    </h5>
    <button class="btn btn-primary btn-sm rounded-3 px-3" data-bs-toggle="modal" data-bs-target="#createModal">
        <i class="fas fa-plus me-1"></i> New Announcement
    </button>
</div>

<!-- Filters -->
<form method="get" asp-action="Index">
    <div class="sa-filters mb-4">
        <div class="search-wrap flex-grow-1">
            <i class="fas fa-search"></i>
            <input name="search" class="form-control" placeholder="Search announcements…" value="@Model.SearchTerm" />
        </div>
        <select name="priority" class="form-select" style="width:auto;" onchange="this.form.submit()">
            <option value="">All Priorities</option>
            @foreach (var p in priorities)
            {
                <option value="@p" selected="@(Model.SelectedPriority == p ? "selected" : null)">@p</option>
            }
        </select>
        <select name="audience" class="form-select" style="width:auto;" onchange="this.form.submit()">
            <option value="">All Audiences</option>
            @foreach (var a in audiences)
            {
                <option value="@a" selected="@(Model.SelectedAudience == a ? "selected" : null)">@a</option>
            }
        </select>
        <button type="submit" class="btn btn-sm btn-primary rounded-3 px-3"><i class="fas fa-filter me-1"></i>Filter</button>
        <a asp-action="Index" class="btn-secondary-sa btn btn-sm"><i class="fas fa-times me-1"></i>Clear</a>
    </div>
</form>

<!-- Announcement Cards -->
@if (!paged.Any())
{
    <div class="sa-card p-5 text-center" style="color:#aaa;">
        <i class="fas fa-bullhorn fa-3x mb-3 d-block opacity-25"></i>No announcements found.
    </div>
}
@foreach (var a in paged)
{
    <div class="sa-announce-card priority-@(a.Priority.ToLower())">
        <div style="background:@PGrad(a.Priority);border-radius:10px;padding:12px 16px;margin:-1.1rem -1.25rem 1rem;display:flex;align-items:flex-start;justify-content:space-between;gap:12px;">
            <div>
                <div class="d-flex align-items-center gap-2">
                    @if (a.IsPinned)
                    {
                        <i class="fas fa-thumbtack" style="color:rgba(255,255,255,0.8);font-size:0.8rem;"></i>
                    }
                    <h6 style="margin:0;color:white;font-weight:700;">@a.Title</h6>
                </div>
                <small style="color:rgba(255,255,255,0.75);font-size:0.72rem;">
                    <i class="fas fa-calendar me-1"></i>@a.PublishedDate.ToString("MMM dd, yyyy")
                    &nbsp;|&nbsp;<i class="fas fa-user me-1"></i>@a.CreatedBy
                    &nbsp;|&nbsp;<i class="fas fa-users me-1"></i>@a.TargetAudience
                    &nbsp;|&nbsp;@a.Category
                </small>
            </div>
            <div class="d-flex gap-1 flex-shrink-0">
                <span class="sa-badge" style="background:rgba(255,255,255,0.2);color:white;">@a.Priority</span>
                @if (a.CreatedBy != "SuperAdmin")
                {
                    <a asp-area="Admin" asp-controller="AdminAnnouncements" asp-action="Edit" asp-route-id="@a.Id"
                       class="sa-btn-icon" style="background:rgba(255,255,255,0.2);color:white;" title="Edit">
                        <i class="fas fa-edit"></i>
                    </a>
                }
                <form asp-area="Admin" asp-controller="AdminAnnouncements" asp-action="TogglePin" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@a.Id" />
                    <button type="submit" class="sa-btn-icon" style="background:rgba(255,255,255,0.2);color:white;" title="@(a.IsPinned ? "Unpin" : "Pin")">
                        <i class="fas fa-thumbtack"></i>
                    </button>
                </form>
                <form asp-area="Admin" asp-controller="AdminAnnouncements" asp-action="Delete" method="post" style="display:inline;" id="deleteForm_@a.Id">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@a.Id" />
                    <button type="button" class="sa-btn-icon" style="background:rgba(255,255,255,0.2);color:white;" title="Delete"
                            data-bs-toggle="modal" data-bs-target="#deleteModal"
                            data-delete-name="this announcement" data-form-id="deleteForm_@a.Id">
                        <i class="fas fa-trash"></i>
                    </button>
                </form>
            </div>
        </div>
        <p style="margin:0 0 0.75rem;color:#555;font-size:0.875rem;line-height:1.7;">@a.Content</p>
        @if (a.ExpiryDate.HasValue)
        {
            <small style="color:#9ca3af;font-size:0.75rem;"><i class="fas fa-clock me-1"></i>Expires: @a.ExpiryDate.Value.ToString("MMM dd, yyyy")</small>
        }
    </div>
}

@if (Model.TotalPages > 1)
{
    <div class="sa-pagination">
        @for (int p = 1; p <= Model.TotalPages; p++)
        {
            <a asp-action="Index" asp-route-page="@p" class="sa-page-btn @(p == Model.CurrentPage ? "active" : "")">@p</a>
        }
    </div>
}

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="sa-modal-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0"><i class="fas fa-bullhorn me-2"></i>New Announcement</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-area="Admin" asp-controller="AdminAnnouncements" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">Title <span class="text-danger">*</span></label>
                            <input name="Title" class="sa-form-control" placeholder="Announcement title" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Priority</label>
                            <select name="Priority" class="sa-form-control">
                                @foreach (var p in priorities)
                                {
                                    <option value="@p">@p</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Content <span class="text-danger">*</span></label>
                            <textarea name="Content" class="sa-form-control" rows="5" placeholder="Full announcement content…" required></textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Target Audience</label>
                            <select name="TargetAudience" class="sa-form-control">
                                @foreach (var a in audiences)
                                {
                                    <option value="@a">@a</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Category</label>
                            <select name="Category" class="sa-form-control">
                                @foreach (var c in categories)
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Expiry Date</label>
                            <input name="ExpiryDate" type="date" class="sa-form-control" />
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input name="IsPinned" type="checkbox" class="form-check-input" id="pinCheck" value="true" />
                                <label class="form-check-label" for="pinCheck" style="font-weight:600;font-size:0.87rem;">Pin this announcement</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4 pt-0">
                    <button type="button" class="btn btn-secondary rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4"><i class="fas fa-paper-plane me-2"></i>Publish</button>
                </div>
            </form>
        </div>
    </div>
</div>

@await Html.PartialAsync("_DeleteModal")
@section Scripts {
    <script>
        (function(){var dm=document.getElementById('deleteModal');if(!dm)return;
        dm.addEventListener('show.bs.modal',function(e){
          var btn=e.relatedTarget;if(!btn)return;
          var el=document.getElementById('deleteItemName');if(el)el.textContent=btn.dataset.deleteName||'this item';
          var cb=document.getElementById('deleteConfirmBtn');
          if(cb&&btn.dataset.formId){cb.onclick=function(ev){ev.preventDefault();document.getElementById(btn.dataset.formId).submit();};cb.href='#';}
        });})();
    </script>
}
