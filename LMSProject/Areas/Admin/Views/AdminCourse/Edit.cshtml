@model LMSProject.Areas.Admin.ViewModels.EditCourseVM
@using MLSCore.Models
@{
    ViewData["Title"] = "Edit Course";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="sa-card">
            <div class="sa-modal-header" style="border-radius:16px 16px 0 0;">
                <h5 class="mb-0" style="color:white;"><i class="fas fa-edit me-2"></i>Edit Course — @Model.Name</h5>
            </div>
            <div class="sa-card-body">
                <form asp-area="Admin" asp-controller="AdminCourse" asp-action="Edit"
                      method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">Course Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="sa-form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Status</label>
                            <select asp-for="Status" class="sa-form-control">
                                <option value="@CourseStatus.OnLine">Online (Live)</option>
                                <option value="@CourseStatus.Recorded">Recorded</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Term</label>
                            <select asp-for="TermId" asp-items="@(new SelectList(Model.Terms, "Id", "Name"))"
                                    class="sa-form-control">
                                <option value="">— Select Term —</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Grade</label>
                            <select asp-for="GradeId" asp-items="@(new SelectList(Model.Grades, "Id", "Name"))"
                                    class="sa-form-control">
                                <option value="">— Select Grade —</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Price</label>
                            <input asp-for="Price" type="number" class="sa-form-control" min="0" step="0.01" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Subject</label>
                            <select id="subjectSelect" class="sa-form-control" onchange="loadSubSubjects(this.value)">
                                <option value="">— Select Subject —</option>
                                @foreach (var s in Model.Subjects)
                                {
                                    <option value="@s.Id" selected="@(s.Id == Model.SubjId ? "selected" : null)">@s.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Sub-Subject</label>
                            <select asp-for="SubSubjId" id="subsubjectSelect" class="sa-form-control">
                                <option value="">— Select Sub-Subject —</option>
                                @foreach (var ss in Model.SubSubjects)
                                {
                                    <option value="@ss.Id" selected="@(ss.Id == Model.SubSubjId ? "selected" : null)">@ss.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Instructor</label>
                            <select asp-for="InstructorId" asp-items="@(new SelectList(Model.Instructors, "Id", "Name"))"
                                    class="sa-form-control">
                                <option value="">— Select Instructor —</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Course Image <small class="text-muted">(leave blank to keep current)</small></label>
                            <input asp-for="Image" type="file" class="sa-form-control" accept="image/*" />
                            @if (!string.IsNullOrEmpty(Model.ImageName))
                            {
                                <div class="mt-1">
                                    <img src="~/@Model.ImageName" style="height:50px;border-radius:8px;object-fit:cover;" />
                                </div>
                            }
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="ShowInHomePage" class="form-check-input" type="checkbox" />
                                <label class="form-check-label" asp-for="ShowInHomePage" style="font-weight:600;font-size:0.87rem;">
                                    Show on Home Page
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary rounded-3 px-4"><i class="fas fa-save me-2"></i>Save Changes</button>
                        <a asp-area="Admin" asp-controller="AdminCourse" asp-action="Index" class="btn-secondary-sa">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function loadSubSubjects(subjectId) {
            const sel = document.getElementById('subsubjectSelect');
            sel.innerHTML = '<option value="">Loading…</option>';
            if (!subjectId) { sel.innerHTML = '<option value="">— Select Sub-Subject —</option>'; return; }
            const res  = await fetch(`/Admin/AdminCourse/GetSubSubjects?subjectId=${subjectId}`);
            const data = await res.json();
            sel.innerHTML = '<option value="">— Select Sub-Subject —</option>' +
                data.map(ss => `<option value="${ss.id}">${ss.name}</option>`).join('');
        }
    </script>
}
