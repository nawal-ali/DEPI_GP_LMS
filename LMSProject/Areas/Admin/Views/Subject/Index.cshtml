@using MLSCore.Models
@model IEnumerable<TbSubject>
@{
    ViewData["Title"] = "Subjects";
    var items = Model.ToList();

    var gradients = new[]
    {
        "linear-gradient(135deg,#F48C06,#FDCB6E)",
        "linear-gradient(135deg,#E13468,#F48C06)",
        "linear-gradient(135deg,#FDCB6E,#29B9E7)",
        "linear-gradient(135deg,#29B9E7,#00CBB8)",
        "linear-gradient(135deg,#5B72EE,#E13468)",
        "linear-gradient(135deg,#00CBB8,#5B72EE)",
    };
    int gi = 0;
}

<style>
    @@keyframes fadeSlideUp {
        from {
            opacity: 0;
            transform: translateY(22px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .config-row {
        animation: fadeSlideUp .35s ease both;
    }

        .config-row:nth-child(1) {
            animation-delay: .00s;
        }

        .config-row:nth-child(2) {
            animation-delay: .05s;
        }

        .config-row:nth-child(3) {
            animation-delay: .10s;
        }

        .config-row:nth-child(4) {
            animation-delay: .15s;
        }

        .config-row:nth-child(5) {
            animation-delay: .20s;
        }

        .config-row:nth-child(6) {
            animation-delay: .25s;
        }

        .config-row:nth-child(7) {
            animation-delay: .30s;
        }

        .config-row:nth-child(8) {
            animation-delay: .35s;
        }

        .config-row:nth-child(9) {
            animation-delay: .40s;
        }

        .config-row:nth-child(10) {
            animation-delay: .45s;
        }

    .config-letter {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.1rem;
        color: white;
        text-transform: uppercase;
        flex-shrink: 0;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 style="font-weight:700;color:var(--primary);margin:0;">
        <i class="fas fa-book me-2" style="color:var(--secondary);"></i>Subjects
        <span class="sa-badge sa-badge-info ms-2">@items.Count</span>
    </h5>
    <a asp-area="Admin" asp-controller="Subject" asp-action="Create"
       class="btn btn-primary btn-sm rounded-3 px-3">
        <i class="fas fa-plus me-1"></i> Add Subject
    </a>
</div>

@if (!items.Any())
{
    <div class="sa-card p-5 text-center" style="color:#aaa;animation:fadeSlideUp .4s ease;">
        <i class="fas fa-book fa-3x mb-3 d-block opacity-25"></i>
        <p class="mb-0">No subjects yet. Click <strong>Add Subject</strong> to create one.</p>
    </div>
}
else
{
    <div class="sa-card">
        <div class="table-responsive">
            <table class="sa-table">
                <thead>
                    <tr>
                        <th style="width:60px;"></th>
                        <th>Subject Name</th>
                        <th>Created By</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        var letter = string.IsNullOrEmpty(item.Name) ? "?" : item.Name[0].ToString();
                        var gradient = gradients[gi++ % gradients.Length];
                        <tr class="config-row">
                            <td>
                                <div class="config-letter" style="background:@gradient;">
                                    @letter
                                </div>
                            </td>
                            <td style="font-weight:600;font-size:.9rem;">@item.Name</td>
                            <td style="color:#6c757d;font-size:.84rem;">@(item.CreatedBy ?? "—")</td>
                            <td>
                                @if (item.CurrentState == 1)
                                {
                                    <span class="sa-badge sa-badge-active">Active</span>
                                }
                                else
                                {

                                    <span class="sa-badge sa-badge-inactive">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-area="Admin" asp-controller="Subject" asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="sa-btn-icon sa-btn-edit" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button type="button"
                                            class="sa-btn-icon sa-btn-delete" title="Delete"
                                            data-bs-toggle="modal" data-bs-target="#deleteModal"
                                            data-delete-url="/Admin/Subject/Delete?Id=@item.Id"
                                            data-delete-name="@item.Name">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@await Html.PartialAsync("_DeleteModal")
