@using LMSProject.ViewModels.Tickets
@model List<TicketListItemVM>
@{
    ViewData["Title"] = "Support Tickets";
    var status = ViewBag.Status as string ?? "";
}
<style>
    @@keyframes _fsu {
        from {
            opacity: 0;
            transform: translateY(20px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    .tk-anim {
        animation: _fsu .4s ease both
    }

    .tk-row {
        animation: _fsu .35s ease both
    }

        .tk-row:nth-child(1) {
            animation-delay: .04s
        }

        .tk-row:nth-child(2) {
            animation-delay: .08s
        }

        .tk-row:nth-child(3) {
            animation-delay: .12s
        }

        .tk-row:nth-child(4) {
            animation-delay: .16s
        }

        .tk-row:nth-child(5) {
            animation-delay: .20s
        }

        .tk-row:nth-child(6) {
            animation-delay: .24s
        }

    .tk-badge-sm {
        padding: 2px 9px;
        border-radius: 20px;
        font-size: .71rem;
        font-weight: 600
    }

    .ticket-item {
        background: white;
        border-radius: 14px;
        border: 1.5px solid rgba(0,0,0,.05);
        padding: 1rem 1.25rem;
        margin-bottom: .65rem;
        transition: box-shadow .2s,transform .2s;
        display: flex;
        align-items: center;
        gap: 1rem;
        text-decoration: none;
        color: inherit
    }

        .ticket-item:hover {
            box-shadow: 0 6px 24px rgba(47,50,125,.1);
            transform: translateY(-2px);
            color: inherit
        }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 tk-anim">
    <h5 style="font-weight:700;color:var(--primary);margin:0;">
        <i class="fas fa-headset me-2" style="color:var(--secondary);"></i>Support Tickets
        <span class="sa-badge sa-badge-info ms-2">@Model.Count</span>
    </h5>

</div>

<!-- Status filter tabs -->
<div class="d-flex gap-2 flex-wrap mb-4 tk-anim">
    <a asp-area="Admin"
       asp-controller="AdminTickets"
       asp-action="Index"
       class="btn btn-sm rounded-3 px-3 @(string.IsNullOrEmpty(status) ? "btn-primary" : "")"
       style="font-family:Poppins,sans-serif;font-size:.8rem;">
        All (@Model.Count)
    </a>

    @{
        var grps = Model.GroupBy(t => t.Status)
                        .ToDictionary(g => g.Key, g => g.Count());
    }

    @foreach (var s in new[] { "Open", "In Progress", "Resolved", "Closed" })
    {
        var cnt = grps.GetValueOrDefault(s, 0);
        if (cnt == 0) continue;

        <a asp-area="Admin"
           asp-controller="AdminTickets"
           asp-action="Index"
           asp-route-status="@s"
           class="btn btn-sm rounded-3 px-3 @(status == s ? "btn-primary" : "")"
           style="font-family:Poppins,sans-serif;font-size:.8rem;">
            @s (@cnt)
        </a>
    }
</div>

<!-- Ticket list -->
@if (!Model.Any())
{
    <div class="sa-card p-5 text-center tk-anim" style="color:#aaa;">
        <i class="fas fa-headset fa-3x mb-3 d-block opacity-25"></i>
        <p class="mb-0">No tickets found.</p>
    </div>
}
else
{
    @foreach (var t in Model)
    {
        <a asp-area="Admin" asp-controller="AdminTickets" asp-action="Detail"
           asp-route-id="@t.Id" class="ticket-item tk-row">
            <div style="width:42px;height:42px;border-radius:11px;flex-shrink:0;background:@t.StatusBg;display:flex;align-items:center;justify-content:center;">
                <i class="fas fa-headset" style="color:@t.StatusColor;font-size:.9rem;"></i>
            </div>
            <div style="flex:1;min-width:0;">
                <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                    <span style="font-weight:700;font-size:.88rem;color:#1f2937;">@t.Title</span>
                    @if (t.IsForwarded)
                    {
                        <span class="tk-badge-sm" style="background:rgba(91,114,238,.12);color:#5B72EE;"><i class="fas fa-forward me-1"></i>Forwarded</span>
                    }
                    @if (t.HasAttachment)
                    {
                        <i class="fas fa-paperclip" style="color:#9ca3af;font-size:.78rem;"></i>
                    }
                </div>
                <div class="d-flex gap-2 flex-wrap align-items-center">
                    <span class="tk-badge-sm" style="background:@t.StatusBg;color:@t.StatusColor;">@t.Status</span>
                    <span class="tk-badge-sm" style="background:rgba(0,0,0,.05);color:#6c757d;">@t.DisplayType</span>
                    <span style="font-size:.73rem;color:#9ca3af;"><i class="fas fa-user me-1"></i>@t.SenderName (@t.SenderRole)</span>
                    <span style="font-size:.73rem;color:#9ca3af;"><i class="fas fa-clock me-1"></i>@t.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm")</span>
                    @if (t.ReplyCount > 0)
                    {
                        <span style="font-size:.73rem;color:#9ca3af;"><i class="fas fa-comment me-1"></i>@t.ReplyCount</span>
                    }
                </div>
            </div>
            <i class="fas fa-chevron-right" style="color:#d1d5db;font-size:.78rem;flex-shrink:0;"></i>
        </a>
    }
}
