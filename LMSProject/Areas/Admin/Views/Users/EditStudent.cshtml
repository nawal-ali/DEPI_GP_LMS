@model LMSProject.Areas.Admin.ViewModels.EditStudentVM
@{
    ViewData["Title"] = "Edit Student";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="sa-card">
            <div class="sa-modal-header" style="border-radius:16px 16px 0 0;">
                <h5 class="mb-0" style="color:white;"><i class="fas fa-user-edit me-2"></i>Edit Student — @Model.FullName</h5>
            </div>
            <div class="sa-card-body">
                <form asp-area="Admin" asp-controller="Users" asp-action="EditStudent"
                      method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="sa-form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email <span class="text-danger">*</span></label>
                            <input asp-for="Email" type="email" class="sa-form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Phone</label>
                            <input asp-for="Phone" class="sa-form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Grade</label>
                            <select asp-for="GradeId" asp-items="@(new SelectList(Model.Grades, "Id", "Name"))"
                                    class="sa-form-control">
                                <option value="">— Select Grade —</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Linked Parent</label>
                            <select asp-for="ParentId" asp-items="@(new SelectList(Model.Parents, "Id", "Name"))"
                                    class="sa-form-control">
                                <option value="">— No Parent Linked —</option>
                            </select>
                            <small class="text-muted" style="font-size:.72rem;">
                                <i class="fas fa-info-circle me-1"></i>Link this student to a parent account
                            </small>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Profile Image</label>
                            <input asp-for="Image" type="file" class="sa-form-control" accept="image/*" />
                            @if (!string.IsNullOrEmpty(Model.ImageName))
                            {
                                <div class="mt-2 d-flex align-items-center gap-2">
                                    <img src="~/@Model.ImageName" style="height:40px;width:40px;border-radius:8px;object-fit:cover;" />
                                    <small class="text-muted">Current photo</small>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary rounded-3 px-4">
                            <i class="fas fa-save me-2"></i>Save Changes
                        </button>
                        <a asp-area="Admin" asp-controller="Users" asp-action="Students"
                           class="btn-secondary-sa">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
