@model LMSProject.Areas.Admin.ViewModel.InstructorEditVM
@{
    ViewData["Title"] = "Edit Instructor";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="sa-card">
            <div class="sa-modal-header" style="border-radius:16px 16px 0 0;">
                <h5 class="mb-0" style="color:white;"><i class="fas fa-user-edit me-2"></i>Edit Instructor — @Model.FullName</h5>
            </div>
            <div class="sa-card-body">
                <form asp-area="Admin" asp-controller="Users" asp-action="EditInstructor"
                      method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="sa-form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Username <span class="text-danger">*</span></label>
                            <input asp-for="UserName" class="sa-form-control" />
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email <span class="text-danger">*</span></label>
                            <input asp-for="Email" type="email" class="sa-form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone</label>
                            <input asp-for="PhoneNumber" class="sa-form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Specialization</label>
                            <input asp-for="Specialization" class="sa-form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Experience (years)</label>
                            <input asp-for="ExperienceYears" type="number" min="0" class="sa-form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Bio</label>
                            <textarea asp-for="Bio" class="sa-form-control" rows="3"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">New Password <small class="text-muted">(leave blank to keep current)</small></label>
                            <input asp-for="Password" type="password" class="sa-form-control" placeholder="New password…" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Profile Image</label>
                            <input asp-for="Image" type="file" class="sa-form-control" accept="image/*" />
                            @if (!string.IsNullOrEmpty(Model.ImageName))
                            {
                                <small class="text-muted">Current: <img src="~/@Model.ImageName" style="height:30px;border-radius:4px;" /></small>
                            }
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="ShowInHomePage" class="form-check-input" type="checkbox" />
                                <label class="form-check-label" asp-for="ShowInHomePage" style="font-weight:600;font-size:0.87rem;">
                                    Show on Home Page
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary rounded-3 px-4"><i class="fas fa-save me-2"></i>Save Changes</button>
                        <a asp-area="Admin" asp-controller="Users" asp-action="Instructors" class="btn-secondary-sa">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
