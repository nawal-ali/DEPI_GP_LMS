@model LMSProject.Areas.Admin.ViewModels.UserListVM<LMSProject.Areas.Admin.ViewModels.StudentListItemVM>
@{
    ViewData["Title"] = "Users — Students";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 style="font-weight:700;color:var(--primary);margin:0;">
        <i class="fas fa-user-graduate me-2" style="color:var(--secondary);"></i>Students
        <span class="sa-badge sa-badge-info ms-2">@Model.TotalCount</span>
    </h5>
    <small class="text-muted" style="font-size:0.8rem;"><i class="fas fa-info-circle me-1"></i>Only SuperAdmin can create accounts</small>
</div>

<form method="get" asp-action="Students">
    <div class="sa-filters">
        <div class="search-wrap">
            <i class="fas fa-search"></i>
            <input name="search" class="form-control" placeholder="Search students…" value="@Model.SearchTerm" />
        </div>
        <select name="grade" class="form-select" style="width:auto;" onchange="this.form.submit()">
            <option value="">All Grades</option>
            @foreach (var g in (List<string>)ViewBag.Grades)
            {
                <option value="@g" selected="@(Model.FilterExtra == g ? "selected" : null)">@g</option>
            }
        </select>
        <button type="submit" class="btn btn-sm btn-primary rounded-3 px-3"><i class="fas fa-filter me-1"></i>Filter</button>
        <a asp-action="Students" class="btn-secondary-sa btn btn-sm"><i class="fas fa-times me-1"></i>Clear</a>
    </div>
</form>

<div class="sa-card">
    <div class="table-responsive">
        <table class="sa-table">
            <thead><tr><th>Student</th><th>Email</th><th>Grade</th><th>Parent</th><th>Courses</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var s in Model.Paged)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(s.ImageName))
                                {
                                    <img src="~/@s.ImageName" style="width:36px;height:36px;border-radius:50%;object-fit:cover;flex-shrink:0;" />
                                }
                                else
                                {

                                    <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--accent-purple),var(--accent-blue));display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:0.75rem;flex-shrink:0;">@s.Initials</div>
                                }
                                <span style="font-weight:600;font-size:0.875rem;">@s.FullName</span>
                            </div>
                        </td>
                        <td style="font-size:0.82rem;color:#6c757d;">@s.Email</td>
                        <td><span class="sa-badge sa-badge-info">@s.Grade</span></td>
                        <td style="font-size:0.83rem;">@Html.Raw(s.ParentName ?? "<span style='color:#aaa;'>—</span>")</td>
                        <td><span class="sa-badge sa-badge-purple">@s.CourseCount</span></td>
                        <td>
                            @if (s.CurrentState == 1)
                            {
                                <span class="sa-badge sa-badge-active">Active</span>
                            }
                            else
                            {

                                <span class="sa-badge sa-badge-inactive">Inactive</span>
                            }
                        </td>
                        <td>
                            <a asp-action="EditStudent" asp-route-id="@s.Id" class="sa-btn-icon sa-btn-edit" title="Edit"><i class="fas fa-edit"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Paged.Any())
                {
                    <tr><td colspan="7" class="text-center py-5 text-muted"><i class="fas fa-search fa-2x d-block mb-2 opacity-25"></i>No students found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <div class="sa-pagination">
        <a asp-action="Students" asp-route-page="@(Model.CurrentPage - 1)" class="sa-page-btn @(Model.CurrentPage == 1 ? "disabled" : "")"><i class="fas fa-chevron-left"></i></a>
        @for (int p = 1; p <= Model.TotalPages; p++)
        {
            <a asp-action="Students" asp-route-page="@p" class="sa-page-btn @(p == Model.CurrentPage ? "active" : "")">@p</a>
        }
        <a asp-action="Students" asp-route-page="@(Model.CurrentPage + 1)" class="sa-page-btn @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")"><i class="fas fa-chevron-right"></i></a>
    </div>
}
