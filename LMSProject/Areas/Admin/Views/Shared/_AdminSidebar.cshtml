@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    bool Is(string c, string? a = null) =>
        string.Equals(ctrl, c, StringComparison.OrdinalIgnoreCase) &&
        (a == null || string.Equals(action, a, StringComparison.OrdinalIgnoreCase));
}

<p class="sa-group-label mt-2">Overview</p>
<a asp-area="Admin" asp-controller="Home" asp-action="Index"
   class="sa-nav-item @(Is("Home") ? "active" : "")">
    <i class="fas fa-tachometer-alt"></i><span>Dashboard</span>
</a>

