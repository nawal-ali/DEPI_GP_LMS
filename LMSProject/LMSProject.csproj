<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<!-- Existing -->
		<PackageReference Include="AutoMapper" Version="16.1.1" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.7" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.7" />
		<PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.7" />

		<!-- MongoDB — RAG storage -->
		<PackageReference Include="MongoDB.Driver" Version="3.1.0" />

		<!-- Email — MailKit (SMTP) -->
		<PackageReference Include="MailKit" Version="4.7.1.1" />

		<!-- PDF text extraction -->
		<PackageReference Include="PdfPig" Version="0.1.9" />

		<!-- Word document text extraction -->
		<PackageReference Include="DocumentFormat.OpenXml" Version="3.2.0" />

		<!-- HTTP client for GitHub Models / OpenAI API -->
		<PackageReference Include="System.Text.Json" Version="9.0.4" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Areas\Instructor\Helpers\" />
		<Folder Include="Areas\Instructor\Models\" />
		<Folder Include="Models\" />
		<Folder Include="wwwroot\Images\images\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MLSEF\MLSEF.csproj" />
	</ItemGroup>

</Project>